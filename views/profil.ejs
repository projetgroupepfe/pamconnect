<%- include("partiels/tete") %>

  <h1>Mon profil</h1>

  <%# Un message de l'equipe n'est PAS une sanction : il n'a donc pas la
      couleur d'un avertissement. Elle s'en sert pour poser une question,
      le plus souvent avant de trancher un desaccord sur de l'argent. %>
  <% if (profil.messageEquipe) { %>
    <div class="carte confiance">
      <h3>L'équipe PamConnect vous écrit</h3>
      <p class="aide">Le <%= utilisateur.message_equipe_le %></p>
      <blockquote class="message-signale"><%= utilisateur.message_equipe %></blockquote>
      <div class="actions">
        <form action="/message-equipe/lu" method="POST">
          <button type="submit" class="bouton">
            <%- include("partiels/icone", { nom: "valider" }) %>
            J'ai lu
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <%# Un avertissement se lit avant tout le reste, et ne disparait que
      lorsque la personne l'a reconnu. Le compte, lui, fonctionne
      normalement : ce n'est pas une suspension. %>
  <% if (profil.avertissement) { %>
    <div class="carte avertissement">
      <h3>Un avertissement de l'équipe PamConnect</h3>
      <p>
        L'équipe a examiné un message signalé le
        <strong><%= utilisateur.avertissement_le %></strong> et vous adresse
        cet avertissement :
      </p>
      <blockquote class="message-signale"><%= utilisateur.avertissement_motif %></blockquote>
      <p class="aide">
        Votre compte fonctionne normalement. Cet avertissement est conservé :
        si un nouveau message est signalé, l'équipe saura que la règle vous
        avait déjà été rappelée.
      </p>
      <div class="actions">
        <form action="/avertissement/lu" method="POST">
          <button type="submit" class="bouton">
            <%- include("partiels/icone", { nom: "valider" }) %>
            J'ai lu cet avertissement
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <div class="carte">
    <div class="fiche-tete">
      <%# Sa propre photo, une fois acceptee. Sinon l'initiale. %>
      <% if (profil.photo && profil.photo.adresse) { %>
        <img class="portrait" src="<%= profil.photo.adresse %>" alt="Ma photo" width="56" height="56">
      <% } else { %>
        <div class="portrait"><%= utilisateur.nom.charAt(0) %></div>
      <% } %>
      <div>
        <h3><%= utilisateur.nom %></h3>
        <div class="metier">
          <%# Pour un membre de l'equipe, on annonce sa FONCTION. Repeter
            "Equipe PamConnect" juste sous le nom du compte n'apprenait rien. %>
        <%= profil.fonction %>
        </div>
      </div>
    </div>

    <%# LES DEUX COTES. L'employeur passe par la meme verification que
        la personne qui vient travailler : son statut doit s'afficher sur
        son profil comme celui de tout le monde. Seule l'equipe en est
        dispensee, puisqu'elle ne rencontre personne. %>
    <% if (!utilisateur.est_admin) { %>
      <p>
        <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
          <% if (utilisateur.statut_verification === "verifie") { %>
            <%- include("partiels/icone", { nom: "verifie" }) %>
          <% } %>
          <%= libelleVerification(utilisateur.statut_verification) %>
        </span>
      </p>

      <% if (profil.verification.attente) { %>
        <p class="aide"><%= profil.verification.attente %></p>
      <% } %>
    <% } %>

    <ul class="infos">
      <%# Un compte d'equipe n'a pas d'adresse : personne ne se deplace
          chez lui. On n'affiche pas une ligne vide pour autant. %>
      <% if (!utilisateur.est_admin) { %>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span><%= utilisateur.arrondissement %><%= utilisateur.quartier ? ", " + utilisateur.quartier : "" %></span>
        </li>
      <% } %>
      <li>
        <%- include("partiels/icone", { nom: "email" }) %>
        <span><%= utilisateur.email %></span>
      </li>
    </ul>

    <% if (utilisateur.role === "prestataire") { %>

      <%# Les badges ne disent QUE ce que la plateforme a reellement
          verifie ou ce que la personne a declare. Aucun badge
          "telephone verifie" ou "email verifie" : nous n'envoyons ni SMS
          ni email, l'afficher serait mentir. %>
      <% const badges = badgesDe(utilisateur); %>
      <% if (badges.length > 0) { %>
        <p class="confiance">
          <% badges.forEach(function (b) { %>
            <span class="badge badge-<%= b.cle === "verifie" ? "verifie" : "info" %>">
              <%- include("partiels/icone", { nom: b.icone }) %>
              <%= b.texte %>
            </span>
          <% }); %>
        </p>
      <% } %>

      <% if (trancheAge(utilisateur.date_naissance)) { %>
        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span><%= trancheAge(utilisateur.date_naissance) %></span>
          </li>
        </ul>
      <% } %>

      <%# Les moments ou la personne peut travailler. C'est ce qu'un
          employeur regarde en premier, avant meme le tarif. %>
      <% const creneaux = disponibilitesLisibles(utilisateur.disponibilites); %>
      <% if (creneaux.length > 0) { %>
        <h4>Vos disponibilités</h4>
        <ul class="infos">
          <% creneaux.forEach(function (c) { %>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>
                <strong><%= c.jour.charAt(0).toUpperCase() + c.jour.slice(1) %></strong> : <%= c.moments.join(", ") %>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <%- include("partiels/detail-tarif", { tarif: utilisateur.tarif, indicatif: true }) %>
    <% } %>

    <div class="actions">
      <a class="bouton bouton-secondaire" href="/mon-profil/modifier">
        <%- include("partiels/icone", { nom: "modifier" }) %>
        Modifier mon profil
      </a>
      <%# Le compte n'entre pas dans le menu : une barre de telephone
          supporte quatre ou cinq entrees, pas six. Il se rejoint depuis
          le profil, la ou l'on regarde deja ses affaires. %>
      <% if (!utilisateur.est_admin) { %>
        <a class="bouton bouton-secondaire" href="/mon-compte">
          <%- include("partiels/icone", { nom: "remuneration" }) %>
          Mon compte
        </a>
        <%# Les jetons ne sont pas de l'argent : ils ont donc leur page, a
            cote du compte et jamais dedans. Les confondre ferait croire
            a un solde retirable. %>
        <a class="bouton bouton-secondaire" href="/mes-jetons">
          <%- include("partiels/icone", { nom: "jeton" }) %>
          Mes jetons
        </a>
      <% } %>
    </div>

    <%# CE QUE LES AUTRES DISENT DE MOI, avec le seul recours possible :
        le signaler. On ne peut pas effacer un avis qui nous vise - il
        deviendrait sinon inutile a ceux qui le lisent. %>
    <% if (!utilisateur.est_admin) { %>
      <%# LE MEME ECRAN, DEUX METIERS. Un employeur ne rend pas de
          service : il en commande un, et c'est la personne qu'il a
          embauchee qui le note une fois le travail fait. Lui dire
          d'attendre son "premier service termine" ne voulait rien
          dire de son cote. %>
      <%- include("partiels/avis-recus", {
            reputation: reputation,
            avis: mesAvis,
            titre: "Les avis reçus",
            signalable: true,
            vide: profil.avis.vide }) %>

      <%# CETTE PAGE NE SERT QU'A LIRE. Quelqu'un qui y voit un avis et
          cherche comment repondre ne trouvait rien : l'ecran ne disait
          pas que l'autre chemin existe. %>
      <% if (profil.servicesANoter) { %>
        <div class="carte">
          <p>
            <strong><%= profil.servicesANoter.phrase %></strong>
            <%= profil.servicesANoter.suite %>
          </p>
          <div class="actions">
            <a class="bouton" href="/messages">
              <%- include("partiels/icone", { nom: "avis" }) %>
              Donner mes avis
            </a>
          </div>
        </div>
      <% } %>
    <% } %>

    <% if (profil.motifRefus) { %>
      <p class="aide">Motif du refus : <%= profil.motifRefus %></p>
    <% } %>

    <% if (profil.boutonVerification) { %>
      <div class="actions">
        <a class="bouton" href="/verification">
          <%- include("partiels/icone", { nom: "envoi" }) %>
          <%= profil.boutonVerification %>
        </a>
      </div>
    <% } %>
  </div>

  <%# ---- Ma photo : une fois l'identite verifiee ---- %>
  <% if (profil.photo) { %>
    <div class="carte">
      <h3>Ma photo</h3>
      <p><%= profil.photo.texte %></p>
      <% if (profil.photo.bouton || profil.photo.peutRetirer) { %>
        <div class="actions">
          <% if (profil.photo.bouton) { %>
            <a class="bouton" href="/mon-profil/photo">
              <%- include("partiels/icone", { nom: "envoi" }) %>
              <%= profil.photo.bouton %>
            </a>
          <% } %>
          <% if (profil.photo.peutRetirer) { %>
            <form action="/mon-profil/photo/retirer" method="POST"
                  data-question="Retirer votre photo ?"
                  data-precision="Elle ne sera plus visible.">
              <button type="submit" class="bouton-secondaire">Retirer ma photo</button>
            </form>
          <% } %>
        </div>
      <% } %>
    </div>
  <% } %>

  <%# ---- Cote equipe : le compte ne sert qu'a verifier des dossiers ---- %>
  <% if (utilisateur.est_admin) { %>
    <div class="vide">
      <p>Ce compte sert uniquement à vérifier les dossiers d'identité.</p>
      <div class="actions">
        <a class="bouton" href="/admin">
          <%- include("partiels/icone", { nom: "equipe" }) %>
          Ouvrir l'espace équipe
        </a>
      </div>
    </div>
  <% } %>


<%- include("partiels/pied") %>
