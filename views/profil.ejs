<%- include("partiels/tete") %>

  <h1>Mon profil</h1>

  <div class="carte">
    <div class="fiche-tete">
      <div class="portrait"><%= utilisateur.nom.charAt(0) %></div>
      <div>
        <h3><%= utilisateur.nom %></h3>
        <div class="metier">
          <%# Pour un membre de l'equipe, son role sur la plateforme n'a aucune
            importance : ce qui compte est qu'il verifie des dossiers. %>
        <% if (utilisateur.est_admin) { %>Équipe PamConnect<% } else { %><%= utilisateur.role === "employeur" ? "Employeur" : utilisateur.metier || "Prestataire" %><% } %>
        </div>
      </div>
    </div>

    <% if (utilisateur.role === "prestataire") { %>
      <p>
        <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
          <% if (utilisateur.statut_verification === "verifie") { %>
            <%- include("partiels/icone", { nom: "verifie" }) %>
          <% } %>
          <%= libelleVerification(utilisateur.statut_verification) %>
        </span>
      </p>
    <% } %>

    <ul class="infos">
      <li>
        <%- include("partiels/icone", { nom: "lieu" }) %>
        <span><%= utilisateur.arrondissement %><%= utilisateur.quartier ? ", " + utilisateur.quartier : "" %></span>
      </li>
      <li>
        <%- include("partiels/icone", { nom: "message" }) %>
        <span><%= utilisateur.email %></span>
      </li>
    </ul>

    <% if (utilisateur.role === "prestataire") { %>
      <%- include("partiels/detail-tarif", { tarif: utilisateur.tarif }) %>
    <% } %>

    <div class="actions">
      <a class="bouton bouton-secondaire" href="/mon-profil/modifier">
        <%- include("partiels/icone", { nom: "profil" }) %>
        Modifier mon profil
      </a>
    </div>

    <% if (utilisateur.role === "prestataire" && utilisateur.statut_verification === "refuse" && utilisateur.motif_refus) { %>
      <p class="aide">Motif du refus : <%= utilisateur.motif_refus %></p>
    <% } %>

    <% if (utilisateur.role === "prestataire" && utilisateur.statut_verification !== "verifie") { %>
      <div class="actions">
        <a class="bouton" href="/verification">
          <%- include("partiels/icone", { nom: "envoi" }) %>
          <% if (utilisateur.statut_verification === "non soumis") { %>
            Faire vérifier mon identité
          <% } else { %>
            Voir mon dossier
          <% } %>
        </a>
      </div>
    <% } %>
  </div>

  <%# ---- Cote employeur : ses annonces et les candidatures recues ---- %>
  <% if (utilisateur.role === "employeur") { %>
    <h2>Mes annonces</h2>

    <%# L'action principale d'un employeur reste accessible en permanence,
        et non cachee dans un menu. %>
    <div class="actions">
      <a class="bouton" href="/publier-annonce">
        <%- include("partiels/icone", { nom: "ajouter" }) %>
        Publier une annonce
      </a>
    </div>

    <% if (mesAnnonces.length === 0) { %>
      <div class="vide">
        <p>Vous n'avez publié aucune annonce.</p>
        <div class="actions">
          <a class="bouton" href="/publier-annonce">
            <%- include("partiels/icone", { nom: "ajouter" }) %>
            Publier une annonce
          </a>
        </div>
      </div>
    <% } else { %>
      <% mesAnnonces.forEach(function (annonce) { %>
        <div class="carte">
          <h3><%= annonce.titre %></h3>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "experience" }) %>
              <span><%= annonce.metier %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span><%= annonce.horaire || "Horaire non précisé" %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "lieu" }) %>
              <span>
                <% if (annonce.quartier) { %><%= annonce.quartier %>, <% } %><%= annonce.arrondissement %>
              </span>
            </li>
          </ul>

          <% if (annonce.candidatures.length === 0) { %>
            <p class="aide" style="margin-top:1rem">Personne n'a encore répondu.</p>
          <% } else { %>
            <% annonce.candidatures.forEach(function (candidature) { %>
              <div class="candidature">
                <div class="fiche-tete">
                  <div class="portrait"><%= candidature.nomPrestataire.charAt(0) %></div>
                  <div>
                    <h3><%= candidature.nomPrestataire %></h3>
                    <div class="metier"><%= libelleCandidature(candidature.statut) %></div>
                  </div>
                </div>

                <p>
                  <span class="badge badge-<%= candidature.verificationPrestataire.replace(/ /g, "-") %>">
                    <% if (candidature.verificationPrestataire === "verifie") { %>
                      <%- include("partiels/icone", { nom: "verifie" }) %>
                    <% } %>
                    <%= libelleVerification(candidature.verificationPrestataire) %>
                  </span>
                </p>

                <% if (candidature.statut === "en attente") { %>

                  <%# On n'engage personne dont l'identite n'est pas verifiee. %>
                  <% if (candidature.verificationPrestataire === "verifie") { %>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="acceptee">
                        <button type="submit">
                          <%- include("partiels/icone", { nom: "valider" }) %>
                          Accepter
                        </button>
                      </form>
                      <form action="/candidatures/statut" method="POST">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">Refuser</button>
                      </form>
                    </div>
                  <% } else { %>
                    <p class="aide">
                      Vous pourrez accepter cette candidature dès que PamConnect aura
                      vérifié l'identité de cette personne.
                    </p>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">Refuser</button>
                      </form>
                    </div>
                  <% } %>

                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  <% } %>

  <%# ---- Cote prestataire : les candidatures envoyees ---- %>
  <% if (utilisateur.role === "prestataire") { %>
    <h2>Mes candidatures</h2>

    <% if (mesCandidatures.length === 0) { %>
      <div class="vide">
        <p>Vous n'avez répondu à aucune annonce.</p>
        <div class="actions">
          <a class="bouton" href="/annonces">
            <%- include("partiels/icone", { nom: "document" }) %>
            Voir les annonces
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="grille">
        <% mesCandidatures.forEach(function (candidature) { %>
          <div class="carte">
            <h3><%= candidature.titreAnnonce %></h3>
            <ul class="infos">
              <li>
                <%- include("partiels/icone", { nom: "disponibilite" }) %>
                <span><strong><%= libelleCandidature(candidature.statut) %></strong></span>
              </li>
            </ul>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>

<%- include("partiels/pied") %>
