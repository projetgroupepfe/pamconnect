<%- include("partiels/tete") %>

  <h1>Mon profil</h1>

  <div class="carte">
    <h3><%= utilisateur.nom %></h3>
    <p class="discret">
      <%= utilisateur.email %><br>
      <%= utilisateur.role === "employeur" ? "Employeur" : "Prestataire" %><%= utilisateur.est_admin ? " · Administrateur de la plateforme" : "" %><br>
      <%= utilisateur.arrondissement %><%= utilisateur.quartier ? ", " + utilisateur.quartier : "" %>
    </p>

    <%# Metier, tarif et verification ne concernent que les prestataires. %>
    <% if (utilisateur.role === "prestataire") { %>
      <p class="discret">
        Métier : <%= utilisateur.metier || "Non renseigné" %><br>
        Tarif : <%= formaterTarif(utilisateur.tarif) %>
      </p>

      <p>
        <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
          <%= libelleVerification(utilisateur.statut_verification) %>
        </span>
      </p>

      <% if (utilisateur.statut_verification === "refuse" && utilisateur.motif_refus) { %>
        <p class="discret">Motif du refus : <%= utilisateur.motif_refus %></p>
      <% } %>

      <% if (utilisateur.statut_verification !== "verifie") { %>
        <p class="actions">
          <a class="bouton" href="/verification">
            <% if (utilisateur.statut_verification === "non soumis") { %>
              Faire vérifier mon identité
            <% } else { %>
              Voir mon dossier de vérification
            <% } %>
          </a>
        </p>
      <% } %>
    <% } %>
  </div>

  <%# ---- Cote employeur : ses annonces et les candidatures recues ---- %>
  <% if (utilisateur.role === "employeur") { %>
    <h2>Mes annonces</h2>

    <% if (mesAnnonces.length === 0) { %>
      <p class="vide">
        Vous n'avez publié aucune annonce.
        <a href="/publier-annonce">Publier ma première annonce</a>
      </p>
    <% } else { %>
      <% mesAnnonces.forEach(function (annonce) { %>
        <div class="carte">
          <h3><%= annonce.titre %></h3>
          <p class="discret"><%= annonce.metier %> · <%= annonce.arrondissement %></p>

          <% if (annonce.candidatures.length === 0) { %>
            <p class="aide">Aucune candidature pour l'instant.</p>
          <% } else { %>
            <% annonce.candidatures.forEach(function (candidature) { %>
              <div class="candidature">
                <p>
                  <strong><%= candidature.nomPrestataire %></strong>
                  — <%= libelleCandidature(candidature.statut) %>
                  <span class="badge badge-<%= candidature.verificationPrestataire.replace(/ /g, "-") %>">
                    <%= libelleVerification(candidature.verificationPrestataire) %>
                  </span>
                </p>

                <% if (candidature.statut === "en attente") { %>

                  <%# On n'engage personne dont l'identite n'est pas verifiee. %>
                  <% if (candidature.verificationPrestataire === "verifie") { %>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST" class="en-ligne">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="acceptee">
                        <button type="submit">Accepter</button>
                      </form>
                      <form action="/candidatures/statut" method="POST" class="en-ligne">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">Refuser</button>
                      </form>
                    </div>
                  <% } else { %>
                    <p class="aide">
                      Vous pourrez accepter cette candidature dès que PamConnect aura
                      vérifié l'identité de ce prestataire.
                    </p>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST" class="en-ligne">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">Refuser</button>
                      </form>
                    </div>
                  <% } %>

                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  <% } %>

  <%# ---- Cote prestataire : les candidatures envoyees ---- %>
  <% if (utilisateur.role === "prestataire") { %>
    <h2>Mes candidatures</h2>

    <% if (mesCandidatures.length === 0) { %>
      <p class="vide">
        Vous n'avez postulé à aucune annonce.
        <a href="/annonces">Voir les annonces disponibles</a>
      </p>
    <% } else { %>
      <div class="grille">
        <% mesCandidatures.forEach(function (candidature) { %>
          <div class="carte">
            <h3><%= candidature.titreAnnonce %></h3>
            <p class="discret"><%= libelleCandidature(candidature.statut) %></p>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>

<%- include("partiels/pied") %>
