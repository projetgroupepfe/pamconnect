<%- include("partiels/tete") %>

  <h1>Mon profil</h1>

  <%# Un message de l'equipe n'est PAS une sanction : il n'a donc pas la
      couleur d'un avertissement. Elle s'en sert pour poser une question,
      le plus souvent avant de trancher un desaccord sur de l'argent. %>
  <% if (utilisateur.message_equipe && !utilisateur.message_equipe_lu) { %>
    <div class="carte confiance">
      <h3>L'équipe PamConnect vous écrit</h3>
      <p class="aide">Le <%= utilisateur.message_equipe_le %></p>
      <blockquote class="message-signale"><%= utilisateur.message_equipe %></blockquote>
      <div class="actions">
        <form action="/message-equipe/lu" method="POST">
          <button type="submit" class="bouton">
            <%- include("partiels/icone", { nom: "valider" }) %>
            J'ai lu
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <%# Un avertissement se lit avant tout le reste, et ne disparait que
      lorsque la personne l'a reconnu. Le compte, lui, fonctionne
      normalement : ce n'est pas une suspension. %>
  <% if (utilisateur.avertissement_motif && !utilisateur.avertissement_lu) { %>
    <div class="carte avertissement">
      <h3>Un avertissement de l'équipe PamConnect</h3>
      <p>
        L'équipe a examiné un message signalé le
        <strong><%= utilisateur.avertissement_le %></strong> et vous adresse
        cet avertissement :
      </p>
      <blockquote class="message-signale"><%= utilisateur.avertissement_motif %></blockquote>
      <p class="aide">
        Votre compte fonctionne normalement. Cet avertissement est conservé :
        si un nouveau message est signalé, l'équipe saura que la règle vous
        avait déjà été rappelée.
      </p>
      <div class="actions">
        <form action="/avertissement/lu" method="POST">
          <button type="submit" class="bouton">
            <%- include("partiels/icone", { nom: "valider" }) %>
            J'ai lu cet avertissement
          </button>
        </form>
      </div>
    </div>
  <% } %>

  <div class="carte">
    <div class="fiche-tete">
      <div class="portrait"><%= utilisateur.nom.charAt(0) %></div>
      <div>
        <h3><%= utilisateur.nom %></h3>
        <div class="metier">
          <%# Pour un membre de l'equipe, on annonce sa FONCTION. Repeter
            "Equipe PamConnect" juste sous le nom du compte n'apprenait rien. %>
        <% if (utilisateur.est_admin) { %>Vérifie les dossiers d'identité<% } else { %><%= utilisateur.role === "employeur" ? "Employeur" : utilisateur.metier || "Prestataire" %><% } %>
        </div>
      </div>
    </div>

    <%# LES DEUX COTES. L'employeur passe par la meme verification que
        la personne qui vient travailler : son statut doit s'afficher sur
        son profil comme celui de tout le monde. Seule l'equipe en est
        dispensee, puisqu'elle ne rencontre personne. %>
    <% if (!utilisateur.est_admin) { %>
      <p>
        <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
          <% if (utilisateur.statut_verification === "verifie") { %>
            <%- include("partiels/icone", { nom: "verifie" }) %>
          <% } %>
          <%= libelleVerification(utilisateur.statut_verification) %>
        </span>
      </p>

      <% if (utilisateur.statut_verification === "en attente") { %>
        <% const att = attenteVerification(utilisateur.documents_envoyes_le); %>
        <p class="aide">
          <% if (att === null) { %>
            Notre équipe examine votre dossier sous <%= delaiVerificationHeures %> heures.
          <% } else if (att.depasse) { %>
            Envoyé <%= attenteLisible(utilisateur.documents_envoyes_le) %>.
            Le délai de <%= delaiVerificationHeures %> heures est dépassé, votre
            dossier reste en tête de la liste.
          <% } else { %>
            Envoyé <%= attenteLisible(utilisateur.documents_envoyes_le) %>.
            Réponse attendue d'ici <%= att.restantes %> heure<%= att.restantes > 1 ? "s" : "" %>.
          <% } %>
        </p>
      <% } %>
    <% } %>

    <ul class="infos">
      <%# Un compte d'equipe n'a pas d'adresse : personne ne se deplace
          chez lui. On n'affiche pas une ligne vide pour autant. %>
      <% if (!utilisateur.est_admin) { %>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span><%= utilisateur.arrondissement %><%= utilisateur.quartier ? ", " + utilisateur.quartier : "" %></span>
        </li>
      <% } %>
      <li>
        <%- include("partiels/icone", { nom: "message" }) %>
        <span><%= utilisateur.email %></span>
      </li>
    </ul>

    <% if (utilisateur.role === "prestataire") { %>

      <%# Les badges ne disent QUE ce que la plateforme a reellement
          verifie ou ce que la personne a declare. Aucun badge
          "telephone verifie" ou "email verifie" : nous n'envoyons ni SMS
          ni email, l'afficher serait mentir. %>
      <% const badges = badgesDe(utilisateur); %>
      <% if (badges.length > 0) { %>
        <p class="confiance">
          <% badges.forEach(function (b) { %>
            <span class="badge badge-<%= b.cle === "verifie" ? "verifie" : "info" %>">
              <%- include("partiels/icone", { nom: b.icone }) %>
              <%= b.texte %>
            </span>
          <% }); %>
        </p>
      <% } %>

      <% if (trancheAge(utilisateur.date_naissance)) { %>
        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span><%= trancheAge(utilisateur.date_naissance) %></span>
          </li>
        </ul>
      <% } %>

      <%# Les moments ou la personne peut travailler. C'est ce qu'un
          employeur regarde en premier, avant meme le tarif. %>
      <% const creneaux = disponibilitesLisibles(utilisateur.disponibilites); %>
      <% if (creneaux.length > 0) { %>
        <h4>Vos disponibilités</h4>
        <ul class="infos">
          <% creneaux.forEach(function (c) { %>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>
                <strong><%= c.jour.charAt(0).toUpperCase() + c.jour.slice(1) %></strong> : <%= c.moments.join(", ") %>
              </span>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <%- include("partiels/detail-tarif", { tarif: utilisateur.tarif, indicatif: true }) %>
    <% } %>

    <div class="actions">
      <a class="bouton bouton-secondaire" href="/mon-profil/modifier">
        <%- include("partiels/icone", { nom: "profil" }) %>
        Modifier mon profil
      </a>
      <%# Le compte n'entre pas dans le menu : une barre de telephone
          supporte quatre ou cinq entrees, pas six. Il se rejoint depuis
          le profil, la ou l'on regarde deja ses affaires. %>
      <% if (!utilisateur.est_admin) { %>
        <a class="bouton bouton-secondaire" href="/mon-compte">
          <%- include("partiels/icone", { nom: "remuneration" }) %>
          Mon compte
        </a>
        <%# Les jetons ne sont pas de l'argent : ils ont donc leur page, a
            cote du compte et jamais dedans. Les confondre ferait croire
            a un solde retirable. %>
        <a class="bouton bouton-secondaire" href="/mes-jetons">
          <%- include("partiels/icone", { nom: "jeton" }) %>
          Mes jetons
        </a>
      <% } %>
    </div>

    <%# CE QUE LES AUTRES DISENT DE MOI, avec le seul recours possible :
        le signaler. On ne peut pas effacer un avis qui nous vise - il
        deviendrait sinon inutile a ceux qui le lisent. %>
    <% if (!utilisateur.est_admin) { %>
      <%- include("partiels/avis-recus", {
            reputation: reputation,
            avis: mesAvis,
            titre: "Les avis reçus",
            signalable: true,
            vide: "Personne ne vous a encore noté. Cela viendra après votre premier service terminé." }) %>

      <%# CETTE PAGE NE SERT QU'A LIRE. Quelqu'un qui y voit un avis et
          cherche comment repondre ne trouvait rien : l'ecran ne disait
          pas que l'autre chemin existe. %>
      <% if (servicesANoter > 0) { %>
        <div class="carte">
          <p>
            <strong><%= servicesANoter %> service<%= servicesANoter > 1 ? "s" : "" %>
            attend<%= servicesANoter > 1 ? "ent" : "" %> votre avis.</strong>
            Cette page montre ce que les autres ont dit de vous ; c'est dans
            vos messages que vous dites ce que vous pensez d'eux.
          </p>
          <div class="actions">
            <a class="bouton" href="/messages">
              <%- include("partiels/icone", { nom: "avis" }) %>
              Donner mes avis
            </a>
          </div>
        </div>
      <% } %>
    <% } %>

    <% if (utilisateur.role === "prestataire" && utilisateur.statut_verification === "refuse" && utilisateur.motif_refus) { %>
      <p class="aide">Motif du refus : <%= utilisateur.motif_refus %></p>
    <% } %>

    <% if (utilisateur.role === "prestataire" && utilisateur.statut_verification !== "verifie") { %>
      <div class="actions">
        <a class="bouton" href="/verification">
          <%- include("partiels/icone", { nom: "envoi" }) %>
          <% if (utilisateur.statut_verification === "non soumis") { %>
            Faire vérifier mon identité
          <% } else { %>
            Voir mon dossier
          <% } %>
        </a>
      </div>
    <% } %>
  </div>

  <%# ---- Cote equipe : le compte ne sert qu'a verifier des dossiers ---- %>
  <% if (utilisateur.est_admin) { %>
    <div class="vide">
      <p>Ce compte sert uniquement à vérifier les dossiers d'identité.</p>
      <div class="actions">
        <a class="bouton" href="/admin">
          <%- include("partiels/icone", { nom: "equipe" }) %>
          Ouvrir l'espace équipe
        </a>
      </div>
    </div>
  <% } %>

  <%# ---- Cote employeur : ses annonces et les candidatures recues ----
      Un membre de l'equipe est techniquement enregistre comme employeur,
      mais il n'a pas le droit de publier : lui montrer "Mes annonces"
      serait lui proposer une action que le serveur refuse. %>
  <% if (jePeux.publier) { %>
    <h2>Mes demandes</h2>

    <%# L'action principale reste accessible en permanence, et non cachee
        dans un menu. Mais une seule fois : quand la liste est vide, c'est
        le bloc ci-dessous qui porte le bouton, et il est mieux place. %>
    <% if (mesAnnonces.length > 0) { %>
      <div class="actions">
        <a class="bouton" href="/publier-annonce">
          <%- include("partiels/icone", { nom: "ajouter" }) %>
          Publier une demande
        </a>
      </div>
    <% } %>

    <% if (mesAnnonces.length === 0) { %>
      <div class="vide">
        <p>Vous n'avez publié aucune demande.</p>
        <div class="actions">
          <a class="bouton" href="/publier-annonce">
            <%- include("partiels/icone", { nom: "ajouter" }) %>
            Publier une demande
          </a>
        </div>
      </div>
    <% } else { %>
      <%# CE QUI EST EN COURS D'ABORD. Une demande fermee garde ses
          discussions et la trace de son argent : on ne la supprime pas,
          on la range. %>
      <% const ouvertes = mesAnnonces.filter(function (a) { return !a.annulee; }); %>
      <% const fermees  = mesAnnonces.filter(function (a) { return a.annulee; }); %>

      <% if (ouvertes.length === 0) { %>
        <p class="vide">Aucune demande en cours.</p>
      <% } %>

      <% ouvertes.concat(fermees).forEach(function (annonce, rang) { %>
        <%# Le titre de la section fermee, pose juste avant la premiere
            d'entre elles. %>
        <% if (fermees.length > 0 && rang === ouvertes.length) { %>
          <h2>Demandes terminées</h2>
          <p class="chapeau">
            Retirées ou pourvues. Elles n'apparaissent plus dans la liste
            publique, mais vos discussions et vos versements y restent
            rattachés.
          </p>
        <% } %>
        <div class="carte">
          <h3><%= annonce.titre %></h3>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "experience" }) %>
              <span><%= annonce.metier %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span><%= annonce.horaire || "Horaire non précisé" %></span>
            </li>
            <% if (prixEnClair(annonce)) { %>
              <li>
                <%- include("partiels/icone", { nom: "remuneration" }) %>
                <span>
                  <%= prixEnClair(annonce) %>
                  <% if (annonce.duree_estimee) { %>
                    <span class="aide"><%= annonce.duree_estimee %></span>
                  <% } %>
                </span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "lieu" }) %>
              <span>
                <% if (annonce.quartier) { %><%= annonce.quartier %>, <% } %><%= annonce.arrondissement %>
              </span>
            </li>
          </ul>

          <%# Une demande fermee l'est pour deux raisons differentes : soit
              quelqu'un a ete choisi, soit l'employeur l'a retiree. On le
              DEDUIT des candidatures plutot que de le stocker : une
              information deduite ne peut pas se contredire. %>
          <% const pourvue = annonce.candidatures.some(function (c) { return c.statut === "acceptee"; }); %>
          <% if (annonce.annulee) { %>
            <p class="aide">
              <strong><%= pourvue ? "Vous avez choisi quelqu'un." : "Vous avez retiré cette demande." %></strong>
              Elle n'apparaît plus dans la liste et n'accepte plus de réponse.
              Vos discussions restent accessibles.
            </p>
          <% } else { %>
            <%# L'ETAT AVANT L'ACTION : une demande deja en avant n'a pas
                besoin d'un bouton, elle a besoin d'une date. %>
            <% if (annonce.enAvant) { %>
              <p>
                <span class="badge badge-info">Mise en avant</span>
                <span class="aide">
                  jusqu'au <%= dateLisible(annonce.mise_en_avant_jusqu_au) %>
                </span>
              </p>
            <% } %>

            <div class="actions">
              <a class="bouton bouton-secondaire" href="/annonces/<%= annonce.id %>/modifier">
                <%- include("partiels/icone", { nom: "profil" }) %>
                Modifier cette demande
              </a>
              <% if (!annonce.enAvant) { %>
                <a class="bouton bouton-secondaire" href="/annonces/<%= annonce.id %>/mettre-en-avant">
                  <%- include("partiels/icone", { nom: "jeton" }) %>
                  Mettre en avant
                </a>
              <% } %>
              <%# Retirer n'efface rien : la demande sort de la liste
                  publique, les discussions restent. %>
              <form action="/annonces/<%= annonce.id %>/annuler" method="POST">
                <button type="submit" class="bouton-danger">
                  <%- include("partiels/icone", { nom: "refuser" }) %>
                  Retirer cette demande
                </button>
              </form>
            </div>

            <%# DEUX ACTIONS ROUGES SUR LE MEME ECRAN. "Retirer cette
                demande" ferme l'offre pour tout le monde ; "Refuser cette
                candidature", plus bas, ecarte UNE personne et laisse la
                demande ouverte. Rien ne les distinguait a l'oeil : meme
                couleur, meme icone. On dit donc ce que chacune fait. %>
            <p class="aide">
              <strong>Retirer ferme votre demande</strong> : elle disparaît
              de la liste, personne ne peut plus y répondre, et la somme
              bloquée vous est rendue.
              Pour écarter une seule personne sans fermer votre demande,
              utilisez <strong>Refuser cette candidature</strong> plus bas :
              les autres pourront encore vous répondre.
            </p>
          <% } %>

          <% if (annonce.candidatures.length === 0) { %>
            <p class="aide" style="margin-top:1rem">Personne n'a encore répondu.</p>
          <% } else { %>
            <% annonce.candidatures.forEach(function (candidature) { %>
              <div class="candidature">
                <div class="fiche-tete">
                  <div class="portrait"><%= candidature.nomPrestataire.charAt(0) %></div>
                  <div>
                    <h3><%= candidature.nomPrestataire %></h3>
                    <div class="metier"><%= phraseCandidature(candidature.statut, true) %></div>
                  </div>
                </div>

                <p>
                  <span class="badge badge-<%= candidature.verificationPrestataire.replace(/ /g, "-") %>">
                    <% if (candidature.verificationPrestataire === "verifie") { %>
                      <%- include("partiels/icone", { nom: "verifie" }) %>
                    <% } %>
                    <%= libelleVerification(candidature.verificationPrestataire) %>
                  </span>

                  <%# SA NOTE, ICI. C'est sous sa demande que l'employeur
                      choisit : sans ces deux chiffres il devait ouvrir une
                      fiche, revenir, et recommencer pour chaque personne. %>
                  <%- include("partiels/note-personne", {
                        nbAvis: candidature.nbAvis,
                        moyenne: candidature.moyenne,
                        services: candidature.servicesTermines }) %>
                </p>

                <%# Le montant retenu pour CETTE candidature : celui du
                    profil, ou celui convenu en discutant. %>
                <ul class="infos">
                  <li>
                    <%- include("partiels/icone", { nom: "remuneration" }) %>
                    <span>
                      <%= prixEnClair(annonce) %>
                    </span>
                  </li>
                </ul>

                <% if (libelleExperience(candidature.experiencePrestataire)) { %>
                  <ul class="infos">
                    <li>
                      <%- include("partiels/icone", { nom: "experience" }) %>
                      <span><%= libelleExperience(candidature.experiencePrestataire) %></span>
                    </li>
                  </ul>
                <% } %>

                <% const dispos = disponibilitesLisibles(candidature.disponibilitesPrestataire); %>
                <% if (dispos.length > 0) { %>
                  <ul class="infos">
                    <li>
                      <%- include("partiels/icone", { nom: "calendrier" }) %>
                      <span>
                        Disponible
                        <strong><%= dispos.map(function (d) { return d.jour; }).join(", ") %></strong>
                      </span>
                    </li>
                  </ul>
                <% } %>

                <div class="actions">
                  <a class="bouton bouton-secondaire" href="/personnes/<%= candidature.prestataireId %>">
                    <%- include("partiels/icone", { nom: "profil" }) %>
                    Voir le profil
                  </a>
                  <a class="bouton bouton-secondaire" href="/messages/<%= candidature.id %>">
                    <%- include("partiels/icone", { nom: "message" }) %>
                    Discuter
                  </a>
                </div>

                <% if (candidature.statut === "en attente") { %>

                  <%# On n'engage personne dont l'identite n'est pas verifiee. %>
                  <% if (candidature.verificationPrestataire === "verifie") { %>
                    <div class="actions">
                      <%# Choisir quelqu'un est un engagement : on passe par
                          un ecran de confirmation. Refuser ne l'est pas. %>
                      <a class="bouton" href="/candidatures/<%= candidature.id %>/confirmer">
                        <%- include("partiels/icone", { nom: "valider" }) %>
                        Choisir cette personne
                      </a>
                      <form action="/candidatures/statut" method="POST">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">
                          <%- include("partiels/icone", { nom: "refuser" }) %>
                          Refuser cette candidature
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <p class="aide">
                      Vous pourrez accepter cette candidature dès que PamConnect aura
                      vérifié l'identité de cette personne.
                    </p>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">
                          <%- include("partiels/icone", { nom: "refuser" }) %>
                          Refuser cette candidature
                        </button>
                      </form>
                    </div>
                  <% } %>

                  <%# La question se pose exactement ici : refuser ferme-t-il la
                      demande ? Non - seul un choix la pourvoit. On le dit plutot
                      que de laisser deviner. %>
                  <p class="aide">
                    Refuser ne retire pas votre demande : elle reste visible,
                    et d'autres personnes peuvent encore y répondre.
                  </p>

                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  <% } %>

  <%# ---- Cote prestataire : les candidatures envoyees ---- %>
  <% if (utilisateur.role === "prestataire") { %>
    <h2>Mes candidatures</h2>

    <% if (mesCandidatures.length === 0) { %>
      <div class="vide">
        <p>Vous n'avez répondu à aucune demande.</p>
        <div class="actions">
          <a class="bouton" href="/annonces">
            <%- include("partiels/icone", { nom: "document" }) %>
            Voir les demandes
          </a>
        </div>
      </div>
    <% } else { %>
      <div class="grille">
        <% mesCandidatures.forEach(function (candidature) { %>
          <div class="carte">
            <h3><%= candidature.titreAnnonce %></h3>
            <ul class="infos">
              <li>
                <%- include("partiels/icone", { nom: "disponibilite" }) %>
                <span><strong><%= phraseCandidature(candidature.statut, false, candidature) %></strong></span>
              </li>
            </ul>
            <div class="actions">
              <a class="bouton bouton-secondaire" href="/messages/<%= candidature.id %>">
                <%- include("partiels/icone", { nom: "message" }) %>
                Discuter
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  <% } %>

<%- include("partiels/pied") %>
