<%- include("partiels/tete") %>

  <h1>Versements</h1>
  <p class="chapeau">
    L'argent que PamConnect a reçu des employeurs, et ce qu'il est devenu.
  </p>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin">
      <%- include("partiels/icone", { nom: "document" }) %>
      Dossiers à vérifier
    </a>
    <a class="bouton bouton-secondaire" href="/admin/signalements">
      <%- include("partiels/icone", { nom: "message" }) %>
      Messages signalés
    </a>
    <a class="bouton bouton-secondaire" href="/admin/problemes">
      <%- include("partiels/icone", { nom: "info" }) %>
      Problèmes signalés
    </a>
  </p>

  <%# CE QUE L'EQUIPE NE PEUT PAS FAIRE ICI, et c'est voulu : aucun
      bouton ne deplace de l'argent. Une somme part parce qu'un service a
      ete declare effectue, ou parce qu'une demande a ete retiree -
      jamais parce que quelqu'un a clique. %>
  <div class="carte confiance">
    <h3>Cette page se lit, elle n'agit pas</h3>
    <p>
      Aucun bouton ne déplace de l'argent. Une somme part parce qu'un
      service a été déclaré effectué, ou parce qu'une demande a été
      retirée sans que personne ait été choisi.
    </p>
    <p class="aide">
      Quand une somme attend trop longtemps alors que quelqu'un a déjà été
      choisi, c'est que l'employeur n'a pas déclaré le service. La personne
      qui a travaillé n'est pas payée tant qu'il ne l'a pas fait.
    </p>
    <p class="aide">
      Son nom et son adresse figurent sur la ligne concernée. PamConnect
      n'envoie aucun message : l'échange se fait en dehors de la plateforme.
    </p>
  </div>

  <%
    // Ce qui attend d'un cote, ce qui est fait de l'autre. Les melanger
    // obligerait a trier de l'oeil ce qui demande une attention de ce
    // qui n'est plus qu'une trace.
    const bloques = versements.filter(function (v) { return v.etat === "bloque"; });
    const denoues = versements.filter(function (v) { return v.etat !== "bloque"; });
  %>

  <h2>Sommes bloquées</h2>

  <% if (bloques.length === 0) { %>

    <div class="vide">
      <p>Aucune somme bloquée.</p>
    </div>

  <% } else { %>

    <% bloques.forEach(function (v) { %>
      <% const att = attenteVersement(v.cree_le); %>
      <div class="carte">

        <h3><%= v.titreAnnonce %></h3>

        <div class="detail-tarif">
          <div class="ligne-tarif total">
            <span>Somme bloquée</span>
            <strong><%= formaterMontant(v.montant) %></strong>
          </div>
        </div>

        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "experience" }) %>
            <span><%= v.metierAnnonce %></span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span>Versée par <strong><%= v.nomEmployeur %></strong> (<%= v.emailEmployeur %>)</span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "calendrier" }) %>
            <span>Reçue le <%= v.cree_le %></span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "document" }) %>
            <span>
              <% if (v.nomRetenu) { %>
                <strong><%= v.nomRetenu %></strong> a été retenue, le service n'est pas encore déclaré
              <% } else if (v.demandeFermee) { %>
                Demande retirée
              <% } else { %>
                Demande ouverte, personne n'a encore été choisi
              <% } %>
            </span>
          </li>
          <%# SA DECLARATION. C'est elle qui transforme un silence en
              desaccord date, et c'est sur elle que l'equipe s'appuiera
              pour trancher. %>
          <% if (v.declareeParElleLe) { %>
            <li>
              <%- include("partiels/icone", { nom: "info" }) %>
              <span>
                <strong><%= v.nomRetenu %></strong> indique avoir effectué le
                service le <strong><%= v.declareeParElleLe %></strong>.
                L'employeur ne l'a pas confirmé.
              </span>
            </li>
          <% } %>
        </ul>

        <%# Une somme posee sur une demande ou quelqu'un a ete choisi
            attend une declaration de service qui ne vient peut-etre
            jamais. C'est le seul cas ou quelqu'un peut rester impaye
            sans que rien ne le signale. %>
        <% if (v.nomRetenu && att && att.depasse) { %>
          <p>
            <span class="badge badge-refuse">
              Bloquée depuis <%= att.lisible %>, le service n'a pas été déclaré
            </span>
          </p>
          <p class="aide">
            <%= v.nomRetenu %> a peut-être travaillé sans être payée.
          </p>
        <% } else if (att) { %>
          <p>
            <span class="badge badge-en-attente">
              Bloquée depuis <%= att.lisible %>
            </span>
          </p>
        <% } %>

      </div>
    <% }); %>

  <% } %>

  <%# LA TRACE. Sans elle, l'equipe voyait ce qui attend et jamais ce qui
      s'est fait : impossible de repondre a "je n'ai jamais ete payee",
      alors que la reponse etait en base depuis le debut. %>
  <h2>Sommes dénouées</h2>

  <% if (denoues.length === 0) { %>

    <div class="vide">
      <p>Aucune somme n'a encore été versée ni rendue.</p>
    </div>

  <% } else { %>

    <div class="grille">
      <% denoues.forEach(function (v) { %>
        <div class="carte">

          <h3><%= v.titreAnnonce %></h3>
          <div class="metier"><%= v.metierAnnonce %></div>

          <p>
            <% if (v.etat === "verse") { %>
              <span class="badge badge-verifie">Versée à <%= v.nomBeneficiaire %></span>
            <% } else { %>
              <span class="badge badge-non-soumis">Rendue à <%= v.nomEmployeur %></span>
            <% } %>
          </p>

          <% if (v.etat === "verse") { %>
            <div class="detail-tarif">
              <div class="ligne-tarif">
                <span>Somme annoncée</span>
                <strong><%= formaterMontant(v.montant) %></strong>
              </div>
              <div class="ligne-tarif">
                <span>Commission PamConnect</span>
                <span class="retenue">− <%= formaterMontant(v.commission) %></span>
              </div>
              <div class="ligne-tarif total">
                <span><%= v.nomBeneficiaire %> a reçu</span>
                <strong><%= formaterMontant(v.net) %></strong>
              </div>
            </div>
          <% } else { %>
            <div class="detail-tarif">
              <div class="ligne-tarif total">
                <span>Somme rendue</span>
                <strong><%= formaterMontant(v.montant) %></strong>
              </div>
            </div>
          <% } %>

          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "profil" }) %>
              <span>Versée par <strong><%= v.nomEmployeur %></strong> (<%= v.emailEmployeur %>)</span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>Reçue le <%= v.cree_le %></span>
            </li>
            <% if (v.etat === "verse" && v.serviceTermineLe) { %>
              <li>
                <%- include("partiels/icone", { nom: "valider" }) %>
                <span>Service déclaré effectué le <strong><%= v.serviceTermineLe %></strong></span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span>
                <%= v.etat === "verse" ? "Versée" : "Rendue" %> le
                <strong><%= v.denoue_le %></strong>
              </span>
            </li>
          </ul>

        </div>
      <% }); %>
    </div>

  <% } %>

<%- include("partiels/pied") %>
