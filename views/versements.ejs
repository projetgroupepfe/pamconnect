<%- include("partiels/tete") %>

  <h1>Versements</h1>
  <p class="chapeau">
    L'argent que PamConnect a reçu des employeurs, et ce qu'il est devenu.
  </p>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin">
      <%- include("partiels/icone", { nom: "document" }) %>
      Dossiers à vérifier
    </a>
    <a class="bouton bouton-secondaire" href="/admin/signalements">
      <%- include("partiels/icone", { nom: "message" }) %>
      Messages signalés
    </a>
    <a class="bouton bouton-secondaire" href="/admin/problemes">
      <%- include("partiels/icone", { nom: "info" }) %>
      Problèmes signalés
    </a>
  </p>

  <%# LA SEULE PAGE OU L'EQUIPE DEPLACE DE L'ARGENT, et seulement en
      dernier recours. Tant que les deux peuvent encore s'accorder, elle
      regarde sans agir : c'est la declaration de l'employeur qui verse
      la somme, pas un clic d'ici. %>
  <div class="carte confiance">
    <h3>Cette page n'agit qu'en dernier recours</h3>
    <p>
      Une somme part normalement toute seule : quand le service est déclaré
      effectué, ou quand une demande est retirée sans que personne ait été
      choisi.
    </p>
    <p>
      Vous n'intervenez qu'en cas de <strong>désaccord</strong> : quelqu'un a
      été choisi, mais l'employeur n'a rien déclaré. Tant qu'il se tait, la
      personne qui a travaillé n'est pas payée.
    </p>
    <p class="aide">
      Interrogez les deux avant de décider, et écrivez pourquoi. Leurs noms et
      adresses figurent sur la ligne : PamConnect n'envoie aucun message,
      l'échange se fait en dehors de la plateforme.
    </p>
  </div>

  <%
    // Ce qui attend d'un cote, ce qui est fait de l'autre. Les melanger
    // obligerait a trier de l'oeil ce qui demande une attention de ce
    // qui n'est plus qu'une trace.
    const bloques = versements.filter(function (v) { return v.etat === "bloque"; });
    const denoues = versements.filter(function (v) { return v.etat !== "bloque"; });
  %>

  <h2>Sommes bloquées</h2>

  <% if (bloques.length === 0) { %>

    <div class="vide">
      <p>Aucune somme bloquée.</p>
    </div>

  <% } else { %>

    <% bloques.forEach(function (v) { %>
      <% const att = attenteVersement(v.cree_le); %>
      <div class="carte">

        <h3><%= v.titreAnnonce %></h3>

        <div class="detail-tarif">
          <div class="ligne-tarif total">
            <span>Somme bloquée</span>
            <strong><%= formaterMontant(v.montant) %></strong>
          </div>
        </div>

        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "experience" }) %>
            <span><%= v.metierAnnonce %></span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span>Versée par <strong><%= v.nomEmployeur %></strong> (<%= v.emailEmployeur %>)</span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "calendrier" }) %>
            <span>Reçue le <%= v.cree_le %></span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "document" }) %>
            <span>
              <% if (v.nomRetenu) { %>
                <strong><%= v.nomRetenu %></strong> a été retenue, le service n'est pas encore déclaré
              <% } else if (v.demandeFermee) { %>
                Demande retirée
              <% } else { %>
                Demande ouverte, personne n'a encore été choisi
              <% } %>
            </span>
          </li>
          <%# SA DECLARATION. C'est elle qui transforme un silence en
              desaccord date, et c'est sur elle que l'equipe s'appuiera
              pour trancher. %>
          <% if (v.declareeParElleLe) { %>
            <li>
              <%- include("partiels/icone", { nom: "info" }) %>
              <span>
                <strong><%= v.nomRetenu %></strong> indique avoir effectué le
                service le <strong><%= v.declareeParElleLe %></strong>.
                L'employeur ne l'a pas confirmé.
              </span>
            </li>
          <% } %>
        </ul>

        <%# Une somme posee sur une demande ou quelqu'un a ete choisi
            attend une declaration de service qui ne vient peut-etre
            jamais. C'est le seul cas ou quelqu'un peut rester impaye
            sans que rien ne le signale. %>
        <% if (v.nomRetenu && att && att.depasse) { %>
          <p>
            <span class="badge badge-refuse">
              Bloquée depuis <%= att.lisible %>, le service n'a pas été déclaré
            </span>
          </p>
          <p class="aide">
            <%= v.nomRetenu %> a peut-être travaillé sans être payée.
          </p>
        <% } else if (att) { %>
          <p>
            <span class="badge badge-en-attente">
              Bloquée depuis <%= att.lisible %>
            </span>
          </p>
        <% } %>

        <%# LE SEUL ENDROIT DE LA PLATEFORME OU UN CLIC DEPLACE DE L'ARGENT.
            Il n'apparait qu'en cas de desaccord : quelqu'un a ete choisi, et soit
            la personne a declare avoir travaille, soit le delai est depasse.
            Avant cela, l'employeur n'a encore rien manque. %>
        <% const desaccord = v.nomRetenu && (v.declareeParElleLe || (att && att.depasse)); %>
        <% if (desaccord) { %>
          <%# ECRIRE AVANT DE TRANCHER. L'equipe ne peut pas entrer dans la
              discussion des deux personnes - elle ne lit pas leurs echanges
              prives. Ce message est son seul moyen de poser une question, et
              il arrive en haut du profil de la personne. %>
          <div class="candidature">
            <h4>Écrire à <%= v.nomEmployeur %></h4>
            <p class="aide">
              Il lira ce message en haut de son profil. Demandez-lui de déclarer le
              service s'il a eu lieu, ou de vous signaler le problème sinon.
            </p>
            <form action="/admin/message/<%= v.employeurId %>" method="POST">
              <div class="champ">
                <label for="msg-<%= v.id %>">Votre message</label>
                <input type="text" id="msg-<%= v.id %>" name="texte" maxlength="500"
                       placeholder="ex : <%= v.nomRetenu %> indique avoir effectué le service. Pouvez-vous le confirmer ?">
              </div>
              <div class="actions">
                <button type="submit" class="bouton-secondaire">
                  <%- include("partiels/icone", { nom: "envoi" }) %>
                  Envoyer ce message
                </button>
              </div>
            </form>
          </div>


          <div class="candidature">
            <h4>Trancher ce désaccord</h4>
            <p class="aide">
              Interrogez les deux personnes avant de décider. Votre motif sera
              conservé avec votre nom : il devra expliquer cette décision des mois
              plus tard.
            </p>

            <form action="/admin/versements/<%= v.annonceId %>" method="POST">
              <div class="champ">
                <label for="motif-v<%= v.id %>">Motif de votre décision</label>
                <input type="text" id="motif-v<%= v.id %>" name="motif" maxlength="200"
                       placeholder="ex : l'employeur confirme par téléphone que le service a eu lieu">
              </div>
              <div class="actions">
                <button type="submit" name="decision" value="verser" class="bouton-secondaire">
                  <%- include("partiels/icone", { nom: "valider" }) %>
                  Verser à <%= v.nomRetenu %>
                </button>
                <button type="submit" name="decision" value="rendre" class="bouton-danger">
                  <%- include("partiels/icone", { nom: "refuser" }) %>
                  Rendre à <%= v.nomEmployeur %>
                </button>
              </div>
            </form>
          </div>
        <% } %>


      </div>
    <% }); %>

  <% } %>

  <%# LA TRACE. Sans elle, l'equipe voyait ce qui attend et jamais ce qui
      s'est fait : impossible de repondre a "je n'ai jamais ete payee",
      alors que la reponse etait en base depuis le debut. %>
  <h2>Sommes dénouées</h2>

  <% if (denoues.length === 0) { %>

    <div class="vide">
      <p>Aucune somme n'a encore été versée ni rendue.</p>
    </div>

  <% } else { %>

    <div class="grille">
      <% denoues.forEach(function (v) { %>
        <div class="carte">

          <h3><%= v.titreAnnonce %></h3>
          <div class="metier"><%= v.metierAnnonce %></div>

          <p>
            <% if (v.etat === "verse") { %>
              <span class="badge badge-verifie">Versée à <%= v.nomBeneficiaire %></span>
            <% } else { %>
              <span class="badge badge-non-soumis">Rendue à <%= v.nomEmployeur %></span>
            <% } %>
          </p>

          <% if (v.etat === "verse") { %>
            <div class="detail-tarif">
              <div class="ligne-tarif">
                <span>Somme annoncée</span>
                <strong><%= formaterMontant(v.montant) %></strong>
              </div>
              <div class="ligne-tarif">
                <span>Commission PamConnect</span>
                <span class="retenue">− <%= formaterMontant(v.commission) %></span>
              </div>
              <div class="ligne-tarif total">
                <span><%= v.nomBeneficiaire %> a reçu</span>
                <strong><%= formaterMontant(v.net) %></strong>
              </div>
            </div>
          <% } else { %>
            <div class="detail-tarif">
              <div class="ligne-tarif total">
                <span>Somme rendue</span>
                <strong><%= formaterMontant(v.montant) %></strong>
              </div>
            </div>
          <% } %>

          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "profil" }) %>
              <span>Versée par <strong><%= v.nomEmployeur %></strong> (<%= v.emailEmployeur %>)</span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>Reçue le <%= v.cree_le %></span>
            </li>
            <% if (v.etat === "verse" && v.serviceTermineLe) { %>
              <li>
                <%- include("partiels/icone", { nom: "valider" }) %>
                <span>Service déclaré effectué le <strong><%= v.serviceTermineLe %></strong></span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span>
                <%= v.etat === "verse" ? "Versée" : "Rendue" %> le
                <strong><%= v.denoue_le %></strong>
              </span>
            </li>

            <%# QUAND C'EST L'EQUIPE QUI A TRANCHE. Une somme deplacee par une
                decision humaine ne se lit pas comme une somme partie toute
                seule : on nomme qui a decide, et on cite son motif. %>
            <% if (v.motif_decision) { %>
              <li>
                <%- include("partiels/icone", { nom: "equipe" }) %>
                <span>
                  Tranché par <strong><%= v.nomDecideur %></strong>
                </span>
              </li>
            <% } %>

          </ul>

          <% if (v.motif_decision) { %>
            <blockquote class="message-signale"><%= v.motif_decision %></blockquote>
          <% } %>


        </div>
      <% }); %>
    </div>

  <% } %>

<%- include("partiels/pied") %>
