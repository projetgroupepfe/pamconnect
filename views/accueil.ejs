      Ménage et entretien
    </li>
    <li>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <g fill="none" stroke="#1F4E79" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="19" cy="14" r="6"/><path d="M8 40a11 11 0 0 1 22 0"/>
          <circle cx="34" cy="24" r="4"/><path d="M28 40a6 6 0 0 1 12 0"/>
        </g>
      </svg>
      Garde d'enfants
    </li>
    <li>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <g fill="none" stroke="#1F4E79" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M24 5 8 11v12c0 11 7 18.5 16 21 9-2.5 16-10 16-21V11L24 5Z"/>
          <path d="M24 17v10"/>
        </g>
      </svg>
      Gardiennage
    </li>
    <li>
      <svg viewBox="0 0 48 48" aria-hidden="true">
