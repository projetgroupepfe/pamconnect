<%- include("partiels/tete") %>

  <h1>Trouver quelqu'un</h1>

  <div class="carte">
    <form id="formulaireRecherche" action="/recherche" method="GET">
      <div class="champ">
        <label for="metier">Quel métier cherchez-vous ?</label>
        <input type="text" id="metier" name="metier"
               placeholder="ex : ménage, nounou, jardinage..."
               value="<%= locals.metierRecherche || "" %>">
      </div>

      <input type="hidden" id="latitude" name="latitude">
      <input type="hidden" id="longitude" name="longitude">

      <div class="actions">
        <button type="submit" id="boutonProximite">
          <%- include("partiels/icone", { nom: "lieu" }) %>
          Chercher près de moi
        </button>
        <button type="submit" class="bouton-secondaire" id="boutonSimple" formnovalidate>
          <%- include("partiels/icone", { nom: "recherche" }) %>
          Chercher sans ma position
        </button>
      </div>
      <p class="aide" id="messageGps"></p>
    </form>
  </div>

  <%# LE NOMBRE REPOND A UNE QUESTION, ou il ne sert a rien.
      "3 personnes pour menage" renseigne. "10 personnes au total"
      compte les inscrits : ce n'est pas ce que l'employeur cherche a
      savoir, et un petit nombre decourage au lieu d'informer. %>
  <h2><%= titreResultats %></h2>
  <%# Sans position, la proximite se mesure a partir du quartier de
      l'employeur : on le lui dit. La phrase vient de rechercherPersonnes,
      que l'application lit aussi. %>
  <% if (phraseLieu) { %>
    <p class="aide"><%= phraseLieu %></p>
  <% } %>

  <%# ON DIT CE QUI COMPTE, sans donner de note. Un classement qu'on
      n'explique pas est un classement qu'on subit ; un score affiche,
      lui, finit par se chercher au lieu de se meriter.

      Et ce qui N'ENTRE PAS dans le calcul est aussi important a dire :
      personne ne peut payer pour monter. %>
  <% if (prestataires.length > 1) { %>
    <p class="aide">
      Le classement tient compte de l'<strong>identité vérifiée</strong>, des
      <strong>avis</strong>, des <strong>services terminés</strong> sans désaccord,
      des <strong>disponibilités</strong> et de la <strong>proximité</strong>.
      Personne ne peut payer pour apparaître en premier.
    </p>
  <% } %>

  <% if (prestataires.length === 0) { %>

    <%# ILLUSTRATION 1 sur 2 : un etat vide, pour ne pas laisser
        la personne devant une page blanche. %>
    <div class="vide">
      <svg class="illustration" width="72" height="72" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/>
      </svg>
      <p>Personne ne correspond à cette recherche.</p>
      <p class="aide">Essayez un autre mot, par exemple « ménage » au lieu de « nettoyage ».</p>
    </div>

  <% } else { %>

    <%# Une seule fois, en haut : la phrase vaut pour toute la liste.
        La repeter sous chaque fiche la rendrait invisible. %>
    <%- include("partiels/portee-verification", { court: true }) %>

    <div class="grille">
      <% prestataires.forEach(function (prestataire) { %>
        <div class="carte">

          <div class="fiche-tete">
            <%# En attendant les photos de profil, l'initiale du prenom
                donne deja un repere visuel a chaque fiche. %>
            <div class="portrait"><%= prestataire.nom.charAt(0) %></div>
            <div>
              <h3><%= prestataire.nom %></h3>
              <div class="metier"><%= prestataire.metier %></div>
            </div>
          </div>

          <p>
            <% if (prestataire.verifiee) { %>
              <span class="badge badge-verifie">
                <%- include("partiels/icone", { nom: "verifie" }) %>
                Identité vérifiée
              </span>
            <% } else { %>
              <span class="badge badge-non-soumis">Identité non vérifiée</span>
            <% } %>

            <%# LA REPUTATION, A COTE DE LA VERIFICATION. Ce sont les deux
                seules choses de cette carte qui ne viennent pas de la
                personne elle-meme.

                Le meme morceau que la fiche, le profil et l'ecran de
                confirmation. Cette carte avait son propre code, et les
                deux ecrans ont fini par dire deux choses de la meme
                personne : la fiche annoncait "Nouveau prestataire", la
                carte n'affichait rien du tout. %>
            <%- include("partiels/note-personne", {
                  nbAvis: prestataire.nbAvis,
                  moyenne: prestataire.moyenne,
                  services: prestataire.services }) %>
          </p>

          <ul class="infos">
            <%# Ce qu'un employeur regarde avant tout : quand la personne
                peut venir, et depuis combien de temps elle exerce. %>
            <% if (prestataire.joursDisponibles) { %>
              <li>
                <%- include("partiels/icone", { nom: "calendrier" }) %>
                <span>
                  Disponible
                  <strong><%= prestataire.joursDisponibles %></strong>
                </span>
              </li>
            <% } %>

            <% if (prestataire.experience) { %>
              <li>
                <%- include("partiels/icone", { nom: "experience" }) %>
                <span><%= prestataire.experience %></span>
              </li>
            <% } %>

            <%# Aucune tranche d'age dans une liste : c'est une donnee
                personnelle, et elle n'aide pas a choisir. Elle n'apparait
                que sur la fiche, et seulement apres une embauche. %>

            <% if (prestataire.lieu) { %>
              <li>
                <%- include("partiels/icone", { nom: "lieu" }) %>
                <span><%= prestataire.lieu %></span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span>Tarif demandé : <strong><%= prestataire.tarif %></strong></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "disponibilite" }) %>
              <span><%= prestataire.distance || "Distance inconnue" %></span>
            </li>
          </ul>

          <div class="actions">
            <a class="bouton bouton-secondaire" href="/personnes/<%= prestataire.id %>">
              <%- include("partiels/icone", { nom: "profil" }) %>
              Voir le profil
            </a>
          </div>

        </div>
      <% }); %>
    </div>

  <% } %>

<script>
  // Le bouton "pres de moi" demande la position AVANT d'envoyer le formulaire.
  const formulaire = document.getElementById("formulaireRecherche");
  const message = document.getElementById("messageGps");
  let utiliserPosition = false;

  document.getElementById("boutonProximite").addEventListener("click", function () {
    utiliserPosition = true;
  });
  document.getElementById("boutonSimple").addEventListener("click", function () {
    utiliserPosition = false;
  });

  formulaire.addEventListener("submit", function (evenement) {
    if (!utiliserPosition) return;          // recherche sans position : rien a faire

    if (!navigator.geolocation) {
      message.textContent = "La localisation n'est pas disponible sur cet appareil.";
      return;                                // on laisse partir la recherche sans position
    }

    // On arrete l'envoi le temps d'obtenir la position, puis on relance.
    evenement.preventDefault();
    message.textContent = "Recherche de votre position...";

    navigator.geolocation.getCurrentPosition(
      function (position) {
        document.getElementById("latitude").value = position.coords.latitude;
        document.getElementById("longitude").value = position.coords.longitude;
        formulaire.submit();
      },
      function (erreur) {
        message.textContent = "Position indisponible. Recherche sans classement par distance.";
        utiliserPosition = false;
        formulaire.submit();
      }
    );
  });
</script>


  <%# L'IMPASSE. Il a trouve quelqu'un, et ensuite ? Sur cette
      plateforme on n'embauche pas depuis une fiche : on publie une
      demande, et les personnes y repondent.

      C'est un choix - la somme est bloquee des la publication, et les
      autres gardent leur chance - mais un choix que personne ne devine.
      On le dit ici, la ou la question se pose. %>
  <% if (locals.jePeux && jePeux.publier && prestataires.length > 0) { %>
    <div class="carte confiance">
      <h3>Vous avez trouvé quelqu'un ?</h3>
      <p>
        On n'embauche pas directement depuis cette page. Publiez votre
        demande avec le service, l'horaire et le prix : les personnes qui
        vous intéressent pourront y répondre, et vous choisirez parmi elles.
      </p>
      <p class="aide">
        C'est ce qui vous protège : la somme que vous annoncez est bloquée
        dès la publication, et vous ne payez qu'après le service.
      </p>
      <div class="actions">
        <a class="bouton" href="/publier-annonce">
          <%- include("partiels/icone", { nom: "ajouter" }) %>
          Publier une demande
        </a>
      </div>
    </div>
  <% } %>

<%- include("partiels/pied") %>
