<%- include("partiels/tete") %>

  <h1>Resultats de recherche</h1>

  <% if (prestataires.length === 0) { %>
    <p>Aucun prestataire trouve.</p>
  <% } else { %>
    <% prestataires.forEach(function (prestataire) { %>
      <div class="carte">
        <p>
          <strong><%= prestataire.nom %></strong> - <%= prestataire.metier %>
          <% if (prestataire.statut_verification === "verifie") { %>
            <span class="badge badge-verifie">Identité vérifiée</span>
          <% } %>
        </p>
        <p><%= prestataire.arrondissement %>, <%= prestataire.quartier || "" %></p>
        <p>Tarif : <%= formaterTarif(prestataire.tarif) %></p>
        <p>Distance : <%= prestataire.distanceTexte %></p>
      </div>
    <% }); %>
  <% } %>

  <p><a href="/recherche.html">Nouvelle recherche</a></p>

<%- include("partiels/pied") %>
