<%- include("partiels/tete") %>

  <h1>Trouver quelqu'un</h1>

  <div class="carte">
    <form id="formulaireRecherche" action="/recherche" method="GET">
      <div class="champ">
        <label for="metier">Qu'est-ce que vous cherchez ?</label>
        <input type="text" id="metier" name="metier"
               placeholder="ménage, nounou, jardinage..."
               value="<%= locals.metierRecherche || "" %>">
      </div>

      <input type="hidden" id="latitude" name="latitude">
      <input type="hidden" id="longitude" name="longitude">

      <div class="actions">
        <button type="submit" id="boutonProximite">
          <%- include("partiels/icone", { nom: "lieu" }) %>
          Chercher près de moi
        </button>
        <button type="submit" class="bouton-secondaire" id="boutonSimple" formnovalidate>
          <%- include("partiels/icone", { nom: "recherche" }) %>
          Chercher sans ma position
        </button>
      </div>
      <p class="aide" id="messageGps"></p>
    </form>
  </div>

  <h2>
    <%= prestataires.length %>
    personne<%= prestataires.length > 1 ? "s" : "" %>
    <%= locals.metierRecherche ? "pour « " + metierRecherche + " »" : "au total" %>
  </h2>

  <% if (prestataires.length === 0) { %>

    <%# ILLUSTRATION 2 sur 3 : un etat vide, pour ne pas laisser
        la personne devant une page blanche. %>
    <div class="vide">
      <svg class="illustration" width="72" height="72" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/><path d="M8 11h6"/>
      </svg>
      <p>Personne ne correspond à cette recherche.</p>
      <p class="aide">Essayez un autre mot, par exemple « ménage » au lieu de « nettoyage ».</p>
    </div>

  <% } else { %>

    <div class="grille">
      <% prestataires.forEach(function (prestataire) { %>
        <div class="carte">

          <div class="fiche-tete">
            <%# En attendant les photos de profil, l'initiale du prenom
                donne deja un repere visuel a chaque fiche. %>
            <div class="portrait"><%= prestataire.nom.charAt(0) %></div>
            <div>
              <h3><%= prestataire.nom %></h3>
              <div class="metier"><%= prestataire.metier %></div>
            </div>
          </div>

          <p>
            <% if (prestataire.statut_verification === "verifie") { %>
              <span class="badge badge-verifie">
                <%- include("partiels/icone", { nom: "verifie" }) %>
                Identité vérifiée
              </span>
            <% } else { %>
              <span class="badge badge-non-soumis">Identité non vérifiée</span>
            <% } %>
          </p>

          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "lieu" }) %>
              <span><%= prestataire.arrondissement %><%= prestataire.quartier ? ", " + prestataire.quartier : "" %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span><%= formaterTarif(prestataire.tarif) %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "disponibilite" }) %>
              <span><%= prestataire.distanceTexte %></span>
            </li>
          </ul>

        </div>
      <% }); %>
    </div>

  <% } %>

<script>
  // Le bouton "pres de moi" demande la position AVANT d'envoyer le formulaire.
  const formulaire = document.getElementById("formulaireRecherche");
  const message = document.getElementById("messageGps");
  let utiliserPosition = false;

  document.getElementById("boutonProximite").addEventListener("click", function () {
    utiliserPosition = true;
  });
  document.getElementById("boutonSimple").addEventListener("click", function () {
    utiliserPosition = false;
  });

  formulaire.addEventListener("submit", function (evenement) {
    if (!utiliserPosition) return;          // recherche sans position : rien a faire

    if (!navigator.geolocation) {
      message.textContent = "La localisation n'est pas disponible sur cet appareil.";
      return;                                // on laisse partir la recherche sans position
    }

    // On arrete l'envoi le temps d'obtenir la position, puis on relance.
    evenement.preventDefault();
    message.textContent = "Recherche de votre position...";

    navigator.geolocation.getCurrentPosition(
      function (position) {
        document.getElementById("latitude").value = position.coords.latitude;
        document.getElementById("longitude").value = position.coords.longitude;
        formulaire.submit();
      },
      function (erreur) {
        message.textContent = "Position indisponible. Recherche sans classement par distance.";
        utiliserPosition = false;
        formulaire.submit();
      }
    );
  });
</script>

<%- include("partiels/pied") %>
