<%- include("partiels/tete") %>

  <div class="colonne">

    <div class="carte">
      <div class="fiche-tete">
        <div class="portrait"><%= personne.nom.charAt(0) %></div>
        <div>
          <h1><%= personne.nom %></h1>
          <div class="metier"><%= personne.metier %></div>
        </div>
      </div>

      <%# Les badges : le vert pour ce que l'equipe a controle, le bleu
          pour ce que la personne declare. La nuance compte - un employeur
          doit savoir ce qui a ete verifie et ce qui ne l'a pas ete. %>
      <p class="confiance">
        <% if (personne.statut_verification === "verifie") { %>
          <span class="badge badge-verifie">
            <%- include("partiels/icone", { nom: "verifie" }) %>
            Identité et casier vérifiés
          </span>
        <% } else { %>
          <span class="badge badge-non-soumis">Identité non vérifiée</span>
        <% } %>

        <%# LA NOTE A COTE DE LA VERIFICATION : ce sont les deux seules
            choses de cette page qui ne viennent pas d'elle. Tout le
            reste - metier, tarif, disponibilites - est declare. %>
        <%- include("partiels/note-personne", {
              nbAvis: reputation.nombre,
              moyenne: reputation.moyenne,
              services: reputation.services }) %>

        <% badgesDe(personne).filter(function (b) { return b.cle !== "verifie"; })
             .forEach(function (b) { %>
          <span class="badge badge-info">
            <%- include("partiels/icone", { nom: b.icone }) %>
            <%= b.texte %>
          </span>
        <% }); %>
      </p>

      <ul class="infos">
        <%# La tranche d'age n'est pas une information publique. Elle
            n'apparait qu'a l'employeur qui a deja embauche cette
            personne : a ce moment-la, ils se connaissent. Avant, la
            montrer serait exposer une donnee personnelle sans raison. %>
        <% if (peutVoirAge && trancheAge(personne.date_naissance)) { %>
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span><%= trancheAge(personne.date_naissance) %></span>
          </li>
        <% } %>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span>
            <% if (personne.quartier) { %><strong><%= personne.quartier %></strong>, <% } %><%= personne.arrondissement %>
          </span>
        </li>
      </ul>
    </div>

    <% const creneaux = disponibilitesLisibles(personne.disponibilites); %>
    <% if (creneaux.length > 0) { %>
      <h2>Ses disponibilités</h2>
      <div class="carte">
        <ul class="infos">
          <% creneaux.forEach(function (c) { %>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>
                <strong><%= c.jour.charAt(0).toUpperCase() + c.jour.slice(1) %></strong> : <%= c.moments.join(", ") %>
              </span>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <%# Le tarif souhaite par la personne n'est pas montre a l'employeur :
        l'equipe PamConnect le voit, appelle les deux parties et annonce
        le prix a l'employeur (commission comprise). %>

    <%- include("partiels/portee-verification", { court: false }) %>

    <%# LA MEME IMPASSE, sur la fiche. Il regarde la personne qu'il
        veut et n'a qu'un bouton de retour. %>
    <%# On ne propose une demande qu'a une personne verifiee : les autres
        ne peuvent pas y repondre. %>
    <% const peutProposer = locals.jePeux && jePeux.publier && personne.statut_verification === "verifie"; %>
    <% if (locals.jePeux && jePeux.publier) { %>
      <div class="carte confiance">
        <h3>Travailler avec cette personne</h3>
        <% if (peutProposer) { %>
          <p>
            Publiez une demande pour cette personne : elle la verra en
            premier.
          </p>
        <% } else { %>
          <%# L'ancienne phrase promettait une reponse qui ne pouvait pas
              venir : sans verification, on ne repond a aucune demande. %>
          <p>
            Cette personne ne peut pas encore répondre aux demandes : son
            identité n'est pas vérifiée.
          </p>
        <% } %>
      </div>
    <% } %>

    <div class="actions">
      <% if (peutProposer) { %>
        <a class="bouton" href="/publier-annonce?pour=<%= personne.id %>">
          <%- include("partiels/icone", { nom: "ajouter" }) %>
          Publier une demande pour cette personne
        </a>
      <% } else if (locals.jePeux && jePeux.publier) { %>
        <a class="bouton" href="/publier-annonce">
          <%- include("partiels/icone", { nom: "ajouter" }) %>
          Publier une demande
        </a>
      <% } %>
      <a class="bouton bouton-secondaire" href="/recherche">Retour à la recherche</a>
    </div>

  </div>

  <%- include("partiels/avis-recus", {
        reputation: reputation,
        avis: avis,
        titre: "Ce que disent les employeurs",
        vide: "Personne ne l'a encore notée." }) %>

<%- include("partiels/pied") %>
