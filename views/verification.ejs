<%- include("partiels/tete") %>

  <%# Tout ce qui depend du compte vient de ecranDeVerification :
      l'application lit exactement la meme chose. %>
  <div class="colonne">
    <h1>Vérification d'identité</h1>

    <p>
      <span class="badge badge-<%= verification.statut.replace(/ /g, "-") %>">
        <%= verification.libelle %>
      </span>
    </p>

    <%# Un dossier envoye n'est pas un dossier oublie. Tant que la
        personne ne sait pas combien de temps elle attend, chaque heure
        ressemble a un abandon. %>
    <% if (verification.attente) { %>
      <div class="carte confiance">
        <h3>Votre dossier est entre les mains de l'équipe</h3>
        <p><% verification.attente.morceaux.forEach(function (m) { %><% if (m.gras) { %><strong><%= m.texte %></strong><% } else { %><%= m.texte %><% } %><% }); %></p>
        <p class="aide"><%= verification.attente.aide %></p>
      </div>
    <% } %>

    <% if (verification.motifRefus) { %>
      <div class="carte">
        <h3>Motif du refus</h3>
        <p class="discret"><%= verification.motifRefus %></p>
      </div>
    <% } %>

    <% if (verification.verifiee) { %>

      <div class="carte">
        <p>Votre identité a été validée par notre équipe. Vous n'avez rien d'autre à faire.</p>
        <p class="discret">Vos documents ont été supprimés de nos serveurs après la validation. Seule votre photo est gardée.</p>
        <p class="actions"><a class="bouton" href="<%= verification.suite.url %>"><%= verification.suite.texte %></a></p>
      </div>

    <% } else { %>

      <p class="chapeau"><%= verification.chapeau %></p>

      <%# Le delai est annonce AVANT l'envoi, et il est le meme des deux
          cotes. Une personne qui sait combien de temps elle attend ne
          renvoie pas ses documents trois fois en croyant a une panne. %>
      <p class="aide">
        Notre équipe examine votre dossier sous
        <strong><%= verification.delaiHeures %> heures</strong>.
      </p>

      <div class="carte confiance">
        <h3>Ce que nous faisons de vos documents</h3>
        <p>
          Ils sont consultables uniquement par l'équipe qui effectue la vérification.
          Personne d'autre n'y a accès, d'aucun côté.
          <strong>Ils sont définitivement supprimés dès que votre dossier est traité</strong> :
          seules la mention « identité vérifiée », sa date et votre photo sont conservées.
        </p>
      </div>

      <div class="carte">
        <%# enctype est indispensable : sans lui le navigateur enverrait le NOM
            du fichier, pas son contenu. %>
        <form action="/verification" method="POST" enctype="multipart/form-data">

          <div class="champ">
            <label for="cni">Pièce d'identité</label>
            <input type="file" id="cni" name="cni" accept="<%= verification.extensions.join(",") %>" required>
            <span class="aide">Carte nationale d'identité ou passeport.</span>
          </div>

          <div class="champ">
            <label for="casier">Extrait de casier judiciaire</label>
            <input type="file" id="casier" name="casier" accept="<%= verification.extensions.join(",") %>" required>
            <%# Un extrait recent : la date est imprimee dessus, l'equipe la controle. %>
            <span class="aide">Datant de moins de 3 mois. Formats acceptés : <%= verification.extensions.join(", ") %>. <%= verification.tailleMaxMo %> Mo maximum par document.</span>
          </div>

          <%# Sur un telephone, accept limite aux images propose aussi
              l'appareil photo. %>
          <div class="champ">
            <label for="photo">Une photo de votre visage</label>
            <input type="file" id="photo" name="photo" accept="<%= verification.extensionsPhoto.join(",") %>" required>
            <span class="aide">L'équipe la compare à votre pièce d'identité. Ensuite, seule la personne avec qui vous travaillerez la verra, une fois le choix fait.</span>
          </div>

          <div class="actions">
            <button type="submit">Envoyer mes documents</button>
            <a class="bouton bouton-secondaire" href="/mon-profil">Retour à mon profil</a>
          </div>
        </form>
      </div>

      <% if (verification.remplaceUnDossier) { %>
        <p class="aide">Un dossier est déjà en cours d'examen. Un nouvel envoi remplacera le précédent.</p>
      <% } %>

    <% } %>
  </div>

<%- include("partiels/pied") %>
