<%- include("partiels/tete") %>

  <h1>Vérification d'identité</h1>

  <p>
    Statut actuel :
    <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
      <%= libelleVerification(utilisateur.statut_verification) %>
    </span>
  </p>

  <% if (utilisateur.statut_verification === "refuse" && utilisateur.motif_refus) { %>
    <p class="carte"><strong>Motif du refus :</strong> <%= utilisateur.motif_refus %></p>
  <% } %>

  <% if (utilisateur.statut_verification === "verifie") { %>

    <p>Ton identité a été validée par notre équipe. Tu n'as rien d'autre à faire.</p>
    <p>Tes documents ont été supprimés de nos serveurs après la validation.</p>

  <% } else { %>

    <p>
      Les employeurs confient l'accès à leur domicile. Pour être visible comme
      prestataire de confiance, deux documents sont demandés.
    </p>

    <div class="carte">
      <p><strong>Ce que nous faisons de tes documents</strong></p>
      <p>
        Ils sont consultables uniquement par l'équipe qui effectue la vérification.
        Ni les employeurs, ni les autres prestataires n'y ont accès.
        <strong>Ils sont définitivement supprimés dès que ton dossier est validé</strong> :
        seule la mention « identité vérifiée » et sa date sont conservées.
      </p>
    </div>

    <%# enctype est indispensable : sans lui le navigateur enverrait le NOM %>
    <%# du fichier, pas son contenu.                                        %>
    <form action="/verification" method="POST" enctype="multipart/form-data">
      <p>
        <label for="cni">Pièce d'identité (CNI, passeport) :</label><br>
        <input type="file" id="cni" name="cni" accept=".jpg,.jpeg,.png,.pdf" required>
      </p>
      <p>
        <label for="casier">Extrait de casier judiciaire :</label><br>
        <input type="file" id="casier" name="casier" accept=".jpg,.jpeg,.png,.pdf" required>
      </p>
      <p>
        Formats acceptés : <%= extensions %> — <%= tailleMaxMo %> Mo maximum par document.
      </p>
      <p>
        <button type="submit">Envoyer mes documents</button>
      </p>
    </form>

    <% if (utilisateur.statut_verification === "en attente") { %>
      <p>Un dossier est déjà en cours d'examen. Un nouvel envoi remplacera le précédent.</p>
    <% } %>

  <% } %>

<%- include("partiels/pied") %>
