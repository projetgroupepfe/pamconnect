<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Vérification d'identité</h1>

    <p>
      <span class="badge badge-<%= utilisateur.statut_verification.replace(/ /g, "-") %>">
        <%= libelleVerification(utilisateur.statut_verification) %>
      </span>
    </p>

    <% if (utilisateur.statut_verification === "refuse" && utilisateur.motif_refus) { %>
      <div class="carte">
        <h3>Motif du refus</h3>
        <p class="discret"><%= utilisateur.motif_refus %></p>
      </div>
    <% } %>

    <% if (utilisateur.statut_verification === "verifie") { %>

      <div class="carte">
        <p>Votre identité a été validée par notre équipe. Vous n'avez rien d'autre à faire.</p>
        <p class="discret">Vos documents ont été supprimés de nos serveurs après la validation.</p>
        <p class="actions"><a class="bouton" href="/annonces">Voir les annonces</a></p>
      </div>

    <% } else { %>

      <p class="chapeau">
        <% if (utilisateur.role === "employeur") { %>
          Les personnes qui vous répondront se déplaceront chez vous, seules,
          souvent tôt le matin. Elles ont le droit de savoir qui vous êtes :
          deux documents sont demandés.
        <% } else { %>
          Les employeurs confient l'accès à leur domicile. Pour que votre profil
          inspire confiance, deux documents sont demandés.
        <% } %>
      </p>

      <div class="carte confiance">
        <h3>Ce que nous faisons de vos documents</h3>
        <p>
          Ils sont consultables uniquement par l'équipe qui effectue la vérification.
          Personne d'autre n'y a accès, d'aucun côté.
          <strong>Ils sont définitivement supprimés dès que votre dossier est traité</strong> :
          seule la mention « identité vérifiée » et sa date sont conservées.
        </p>
      </div>

      <div class="carte">
        <%# enctype est indispensable : sans lui le navigateur enverrait le NOM
            du fichier, pas son contenu. %>
        <form action="/verification" method="POST" enctype="multipart/form-data">

          <div class="champ">
            <label for="cni">Pièce d'identité</label>
            <input type="file" id="cni" name="cni" accept=".jpg,.jpeg,.png,.pdf" required>
            <span class="aide">Carte nationale d'identité ou passeport.</span>
          </div>

          <div class="champ">
            <label for="casier">Extrait de casier judiciaire</label>
            <input type="file" id="casier" name="casier" accept=".jpg,.jpeg,.png,.pdf" required>
            <span class="aide">Formats acceptés : <%= extensions %> — <%= tailleMaxMo %> Mo maximum par document.</span>
          </div>

          <div class="actions">
            <button type="submit">Envoyer mes documents</button>
            <a class="bouton bouton-secondaire" href="/mon-profil">Retour à mon profil</a>
          </div>
        </form>
      </div>

      <% if (utilisateur.statut_verification === "en attente") { %>
        <p class="aide">Un dossier est déjà en cours d'examen. Un nouvel envoi remplacera le précédent.</p>
      <% } %>

    <% } %>
  </div>

<%- include("partiels/pied") %>
