<%# Page de message simple : un titre, un texte, un ou plusieurs liens. %>
<%- include("partiels/tete") %>

  <div class="colonne">
    <div class="carte">
      <h1><%= titre %></h1>

      <% if (locals.texte) { %>
        <p class="discret"><%= texte %></p>
      <% } %>

      <p class="actions">
        <% (locals.liens || []).forEach(function (lien, index) { %>
          <a class="bouton <%= index === 0 ? "" : "bouton-secondaire" %>" href="<%= lien.url %>"><%= lien.texte %></a>
        <% }); %>
      </p>
    </div>
  </div>

<%- include("partiels/pied") %>
