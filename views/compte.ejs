<%- include("partiels/tete") %>

  <h1>Mon compte</h1>

  <%# CE QUE CETTE PAGE N'EST PAS. Elle n'affiche aucun numero Mobile
      Money ni coordonnee bancaire : la plateforme n'en range pas. %>
  <div class="carte confiance">
    <h3>Comment l'argent circule</h3>
    <p>
      Rien n'est payé à la publication. Après le service, l'employeur paie
      PamConnect, qui reverse à la personne qui a travaillé.
    </p>
    <p class="aide">
      Le paiement se fait à l'agence ou par Mobile Money, jamais sur la
      plateforme : elle en garde seulement la trace.
    </p>
  </div>

  <% if (jeSuisEmployeur) { %>

    <h2>Vos services</h2>

    <% if (envoyes.length === 0) { %>
      <div class="vide">
        <p>Aucun service pour le moment.</p>
        <p class="aide">
          Un montant apparaît ici quand l'équipe vous a mis en relation.
        </p>
      </div>
    <% } else { %>
      <div class="grille">
        <% envoyes.forEach(function (v) { %>
          <div class="carte">
            <h3><%= v.titreDemande %></h3>
            <div class="metier">Avec <%= v.avec %></div>

            <p>
              <span class="badge <%= v.etat === "paye" ? "badge-verifie" : "badge-en-attente" %>"><%= v.libelleEtat %></span>
            </p>

            <ul class="infos">
              <li>
                <%- include("partiels/icone", { nom: "remuneration" }) %>
                <span><strong><%= v.montant %></strong></span>
              </li>
              <li>
                <%- include("partiels/icone", { nom: "calendrier" }) %>
                <span>Convenu le <%= v.convenuLe %></span>
              </li>
              <% if (v.paye) { %>
                <li>
                  <%- include("partiels/icone", { nom: "valider" }) %>
                  <span><%= v.paye %></span>
                </li>
              <% } %>
            </ul>

            <% if (v.rappelPaiement) { %>
              <%# L'OBLIGATION, ecrite la ou la somme est encore due. %>
              <p class="aide">
                <strong>Après le service, payez ce montant à PamConnect.</strong>
                L'équipe le reverse ensuite à la personne qui a travaillé.
              </p>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

  <% } else { %>

    <h2>Ce que vous avez reçu</h2>

    <div class="carte">
      <div class="detail-tarif">
        <div class="ligne-tarif total">
          <span>Total reçu</span>
          <strong><%= totalRecu %></strong>
        </div>
      </div>
      <p class="aide">
        Vous recevez <strong>exactement le prix que vous annoncez</strong> à
        l'équipe : la commission s'ajoute par-dessus, elle ne vous est pas
        retirée.
      </p>
    </div>

    <% if (recus.length === 0) { %>
      <div class="vide">
        <p>Aucun service pour le moment.</p>
        <p class="aide">
          L'équipe vous appelle quand un service vous est proposé.
        </p>
      </div>
    <% } else { %>
      <div class="grille">
        <% recus.forEach(function (v) { %>
          <div class="carte">
            <h3><%= v.titreDemande %></h3>
            <div class="metier">Chez <%= v.chez %></div>

            <p>
              <span class="badge <%= v.reverse ? "badge-verifie" : "badge-en-attente" %>"><%= v.libelleEtat %></span>
            </p>

            <div class="detail-tarif">
              <% v.lignes.forEach(function (ligne) { %>
                <div class="ligne-tarif<%= ligne.total ? " total" : "" %>">
                  <span><%= ligne.libelle %></span>
                  <strong><%= ligne.montant %></strong>
                </div>
              <% }); %>
            </div>

            <% if (v.verseLe) { %>
              <ul class="infos">
                <li>
                  <%- include("partiels/icone", { nom: "calendrier" }) %>
                  <span>Reversé le <%= v.verseLe %><%= v.moyen ? " (" + v.moyen + ")" : "" %></span>
                </li>
              </ul>
            <% } %>
          </div>
        <% }); %>
      </div>
    <% } %>

  <% } %>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/mon-profil">
      <%- include("partiels/icone", { nom: "profil" }) %>
      Retour à mon profil
    </a>
  </p>

<%- include("partiels/pied") %>
