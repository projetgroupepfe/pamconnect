<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Publier une demande</h1>
    <p class="discret">
      Dites ce dont vous avez besoin et quand. Les personnes que l'horaire
      arrange vous répondront.
    </p>

    <div class="carte">
      <form action="/annonces" method="POST">

        <div class="champ">
          <label for="titre">Titre de l'annonce</label>
          <input type="text" id="titre" name="titre" placeholder="ex : Ménage deux fois par semaine" required>
        </div>

        <div class="champ">
          <label for="description">Description</label>
          <textarea id="description" name="description"
                    placeholder="Précisez le volume de travail, les jours souhaités, les conditions..." required></textarea>
        </div>

        <div class="champ">
          <label for="metier">Qui cherchez-vous ?</label>
          <input type="text" id="metier" name="metier" placeholder="Ménage, nounou, jardinage..." required>
          <span class="aide">Ce mot sert aux candidates pour retrouver votre demande.</span>
        </div>

        <div class="champ">
          <label for="horaire">Quand avez-vous besoin de quelqu'un ?</label>
          <input type="text" id="horaire" name="horaire"
                 placeholder="Lundi et jeudi, 8h à 12h" required>
          <span class="aide">
            C'est la première chose que les candidates regardent : indiquez
            les jours et les heures aussi précisément que possible.
          </span>
        </div>

        <div class="champ">
          <label for="arrondissement">Arrondissement</label>
          <select id="arrondissement" name="arrondissement" required>
            <option value="Yaoundé 1">Yaoundé 1</option>
            <option value="Yaoundé 2">Yaoundé 2</option>
            <option value="Yaoundé 3">Yaoundé 3</option>
            <option value="Yaoundé 4">Yaoundé 4</option>
            <option value="Yaoundé 5">Yaoundé 5</option>
            <option value="Yaoundé 6">Yaoundé 6</option>
            <option value="Yaoundé 7">Yaoundé 7</option>
          </select>
        </div>

        <div class="actions">
          <button type="submit">Publier ma demande</button>
          <a class="bouton bouton-secondaire" href="/mon-profil">Annuler</a>
        </div>
      </form>
    </div>
  </div>

<%- include("partiels/pied") %>
