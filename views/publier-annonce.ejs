<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Publier une demande</h1>
    <p class="discret">
      Dites ce dont vous avez besoin et quand. Les personnes que l'horaire
      arrange vous répondront.
    </p>

    <div class="carte">
      <form action="/annonces" method="POST">

        <div class="champ">
          <label for="titre">Votre demande en une phrase</label>
          <input type="text" id="titre" name="titre"
                 placeholder="Ménage deux fois par semaine" required>
        </div>

        <div class="champ">
          <label for="metier">Qui cherchez-vous ?</label>
          <input type="text" id="metier" name="metier" placeholder="Ménage, nounou, jardinage..." required>
          <span class="aide">Ce mot sert aux candidates pour retrouver votre demande.</span>
        </div>

        <div class="champ">
          <label for="horaire">Quand avez-vous besoin de quelqu'un ?</label>
          <input type="text" id="horaire" name="horaire"
                 placeholder="Lundi et jeudi, 8h à 12h" required>
          <span class="aide">
            C'est la première chose que les candidates regardent : indiquez
            les jours et les heures aussi précisément que possible.
          </span>
        </div>

        <%# Le nom du quartier suffit : jamais l'adresse exacte. %>
        <%- include("partiels/champ-lieu", {
              quartier: null, arrondissement: null, obligatoire: true }) %>

        <h2>Ce que vous êtes prêt à payer</h2>
        <p class="aide">
          Facultatif, mais très utile : sans repère, une candidate propose
          son montant à l'aveugle. Elle reste libre de proposer autre chose,
          et vous restez libre de refuser.
        </p>

        <div class="champ">
          <label for="budget">Votre budget (FCFA)</label>
          <input type="number" id="budget" name="budget" min="500" step="500"
                 placeholder="10000">
        </div>

        <div class="champ">
          <label for="unite_tarif">Ce montant, c'est…</label>
          <select id="unite_tarif" name="unite_tarif">
            <%# La liste vient du serveur : ajouter une facon de compter ne
                demandera pas de retoucher cet ecran. %>
            <% Object.keys(unitesTarif).forEach(function (cle) { %>
              <option value="<%= cle %>" <%= cle === "forfaitaire" ? "selected" : "" %>>
                <%= unitesTarif[cle] %>
              </option>
            <% }); %>
          </select>
          <span class="aide">
            3 000 FCFA de l'heure et 3 000 FCFA pour la prestation ne veulent
            pas dire la même chose.
          </span>
        </div>

        <div class="champ">
          <label for="duree_estimee">Combien de temps, à votre avis ? <span class="aide">(facultatif)</span></label>
          <input type="text" id="duree_estimee" name="duree_estimee"
                 placeholder="Environ 3 heures">
          <span class="aide">C'est ce qui rend votre budget compréhensible.</span>
        </div>

        <div class="champ">
          <label for="conditions">Quelque chose à savoir avant de venir ? <span class="aide">(facultatif)</span></label>
          <input type="text" id="conditions" name="conditions" maxlength="300"
                 placeholder="Il y a un chien. Deuxième étage sans ascenseur.">
        </div>

        <div class="actions">
          <button type="submit">Publier ma demande</button>
          <a class="bouton bouton-secondaire" href="/mon-profil">Annuler</a>
        </div>
      </form>
    </div>
  </div>

<%- include("partiels/pied") %>
