<%- include("partiels/tete") %>

  <h1>Jetons</h1>
  <p class="chapeau">
    Les demandes d'achat en attente, et les prix de la plateforme.
  </p>

  <h2>Demandes d'achat</h2>

  <%# CONFIRMER CREE DES JETONS. C'est la seule facon d'en faire
      apparaitre par un achat : a ne faire qu'apres avoir constate le
      paiement. %>
  <div class="carte confiance">
    <p class="aide">
      Confirmer une demande <strong>ajoute les jetons</strong> au solde de la
      personne. Ne confirmez qu'après avoir constaté le paiement.
      Un refus demande un motif : la personne le lira sur sa page.
    </p>
  </div>

  <% if (achats.length === 0) { %>

    <p class="vide">Aucune demande en attente.</p>

  <% } else { %>

    <% achats.forEach(function (achat) { %>
      <div class="carte">
        <h3><%= achat.nom %></h3>
        <p class="discret">
          <strong><%= achat.role === "employeur" ? "Employeur" : "Prestataire" %></strong><br>
          <%= achat.email %>
        </p>

        <div class="detail-tarif">
          <div class="ligne-tarif total">
            <span><%= achat.quantite %> jetons</span>
            <strong><%= formaterMontant(achat.montant) %></strong>
          </div>
        </div>

        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "calendrier" }) %>
            <span>Demandé le <%= dateLisible(achat.cree_le) %></span>
          </li>
        </ul>

        <form action="/admin/jetons/<%= achat.id %>" method="POST">
          <div class="champ">
            <label for="motif-<%= achat.id %>">Motif, si vous refusez</label>
            <input id="motif-<%= achat.id %>" type="text" name="motif" maxlength="200"
                   placeholder="Paiement non reçu">
          </div>

          <div class="actions">
            <button type="submit" name="decision" value="confirmer" class="bouton">
              <%- include("partiels/icone", { nom: "valider" }) %>
              Confirmer le paiement
            </button>
            <button type="submit" name="decision" value="refuser"
                    class="bouton bouton-secondaire">
              <%- include("partiels/icone", { nom: "refuser" }) %>
              Refuser
            </button>
          </div>
        </form>
      </div>
    <% }); %>

  <% } %>

  <h2>Les prix et les jetons offerts</h2>

  <%# UN SEUL NOMBRE COMMANDE TOUT. Le prix d'un pack ne se saisit pas :
      il se calcule. Saisir les deux laisserait l'equipe ecrire un jeton
      a 200 FCFA et un pack de 10 a 1 000, et plus rien ne dirait lequel
      des deux a raison. %>
  <div class="carte">
    <p class="aide">
      Un prix modifié ici s'applique <strong>à tous les utilisateurs</strong>
      immédiatement. Les demandes d'achat déjà envoyées gardent le montant
      qu'elles avaient au moment de la demande.
    </p>

    <form action="/admin/parametres" method="POST">

      <div class="champ">
        <label for="valeur-jeton">Valeur d'un jeton, en FCFA</label>
        <input id="valeur-jeton" type="number" name="jeton_valeur_fcfa"
               value="<%= valeurJeton === null ? "" : valeurJeton %>"
               min="1" step="1" inputmode="numeric" required>
        <small class="aide">
          C'est ce nombre qui donne le prix de tout le reste. Un pack de
          10 jetons se vendra dix fois cette somme.
        </small>
      </div>

      <h3>Les packs en vente</h3>

      <%# Une case par pack, plus une case vide pour en ajouter un.
          Vider une case retire le pack : pas de bouton Supprimer a
          construire, et rien de plus a expliquer. %>
      <% packs.forEach(function (pack, rang) { %>
        <div class="champ">
          <label for="pack-<%= rang %>">Pack de <%= pack.quantite %> jetons</label>
          <input id="pack-<%= rang %>" type="number" name="pack"
                 value="<%= pack.quantite %>" min="1" step="1" inputmode="numeric">
          <small class="aide">
            Se vend <strong><%= formaterMontant(pack.prix) %></strong>.
            Videz cette case pour retirer ce pack.
          </small>
        </div>
      <% }); %>

      <div class="champ">
        <label for="pack-nouveau">Mettre un nouveau pack en vente</label>
        <input id="pack-nouveau" type="number" name="pack" value=""
               min="1" step="1" inputmode="numeric" placeholder="Nombre de jetons">
        <small class="aide">
          Tapez le nombre de jetons du pack à créer, par exemple 5 pour
          vendre un pack de 5 jetons. Laissez vide si vous n'en créez pas.
        </small>
      </div>

      <h3>Ce qu'une action coûte</h3>

      <%# Ces deux nombres ne prelevent encore rien : ils servent a DIRE
          la verite sur la page de chacun. Les etapes suivantes les
          depenseront. %>
      <div class="champ">
        <label for="cout-candidature">Répondre à une demande, en jetons</label>
        <input id="cout-candidature" type="number" name="cout_candidature"
               value="<%= coutCandidature === null ? "" : coutCandidature %>"
               min="1" step="1" inputmode="numeric" required>
        <small class="aide">
          Ce que dépense une personne qui propose ses services pour répondre
          à une annonce.
          <% if (coutCandidature !== null && valeurJeton !== null) { %>
            Soit <strong><%= formaterMontant(coutCandidature * valeurJeton) %></strong>.
          <% } %>
        </small>
      </div>

      <div class="champ">
        <label for="cout-avant">Mettre une demande en avant, en jetons</label>
        <input id="cout-avant" type="number" name="cout_mise_en_avant"
               value="<%= coutMiseEnAvant === null ? "" : coutMiseEnAvant %>"
               min="1" step="1" inputmode="numeric" required>
        <small class="aide">
          Ce que dépense un employeur pour que sa demande passe devant les
          autres.
          <% if (coutMiseEnAvant !== null && valeurJeton !== null) { %>
            Soit <strong><%= formaterMontant(coutMiseEnAvant * valeurJeton) %></strong>.
          <% } %>
        </small>
      </div>

      <h3>Les jetons offerts à la vérification</h3>

      <%# CE N'EST PAS UN CADEAU : ils arrivent apres l'envoi des papiers
          et l'attente, une seule fois par compte, et ils periment. Mettre
          zero les supprime - c'est un choix, pas une panne. %>
      <div class="champ">
        <label for="offert-employeur">Jetons offerts à un employeur</label>
        <input id="offert-employeur" type="number" name="bienvenue_employeur"
               value="<%= bienvenueEmployeur === null ? "" : bienvenueEmployeur %>"
               min="0" step="1" inputmode="numeric" required>
        <small class="aide">
          Reçus une seule fois, dès que son identité est vérifiée.
          Mettez zéro pour ne plus rien offrir.
        </small>
      </div>

      <div class="champ">
        <label for="offert-prestataire">Jetons offerts à une personne qui propose ses services</label>
        <input id="offert-prestataire" type="number" name="bienvenue_prestataire"
               value="<%= bienvenuePrestataire === null ? "" : bienvenuePrestataire %>"
               min="0" step="1" inputmode="numeric" required>
        <small class="aide">
          De quoi répondre à quelques demandes avant d'avoir à en acheter.
        </small>
      </div>

      <div class="champ">
        <label for="offert-jours">Durée de validité des jetons offerts, en jours</label>
        <input id="offert-jours" type="number" name="bienvenue_jours"
               value="<%= bienvenueJours === null ? "" : bienvenueJours %>"
               min="1" step="1" inputmode="numeric" required>
        <small class="aide">
          Passé ce délai, les jetons offerts non utilisés disparaissent.
          Les jetons achetés, eux, ne périment jamais.
        </small>
      </div>

      <div class="actions">
        <button type="submit" class="bouton">
          <%- include("partiels/icone", { nom: "reglage" }) %>
          Enregistrer les prix
        </button>
      </div>
    </form>

    <%# QUI A MIS CE PRIX. Partout ailleurs dans l'espace equipe, une
        decision garde le nom de qui l'a prise. Un tarif n'y echappe pas :
        c'est ce que paient les utilisateurs. %>
    <p class="aide">
      <% if (dernierChangement && dernierChangement.modifie_le) { %>
        Dernier changement : le <%= dateLisible(dernierChangement.modifie_le) %>
        par <%= dernierChangement.nom || "un compte supprimé depuis" %>.
      <% } else { %>
        Aucun changement depuis la mise en service.
      <% } %>
    </p>
  </div>

  <h2>Demandes déjà traitées</h2>

  <% if (traites.length === 0) { %>
    <p class="vide">Aucune demande traitée.</p>
  <% } else { %>
    <div class="grille">
      <% traites.forEach(function (a) { %>
        <div class="carte">
          <h3><%= a.nom %></h3>
          <p>
            <% if (a.etat === "confirme") { %>
              <span class="badge badge-verifie"><%= a.quantite %> jetons ajoutés</span>
            <% } else { %>
              <span class="badge badge-refuse">Refusée</span>
            <% } %>
          </p>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span><%= formaterMontant(a.montant) %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>Traitée le <%= dateLisible(a.traite_le) %></span>
            </li>
            <% if (a.nomDecideur) { %>
              <li>
                <%- include("partiels/icone", { nom: "equipe" }) %>
                <span>Par <%= a.nomDecideur %></span>
              </li>
            <% } %>
          </ul>
          <% if (a.motif_refus) { %>
            <p class="aide">Motif : <%= a.motif_refus %></p>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin">
      <%- include("partiels/icone", { nom: "equipe" }) %>
      Retour à l'espace équipe
    </a>
  </p>

<%- include("partiels/pied") %>
