<%#
  Ce sur quoi un employeur travaille : ses demandes et les reponses
  recues. Sortie du profil, qui melangeait trois choses sans rapport.

  TOUT CE QUI DEPEND DES DONNEES EST DECIDE PAR demandesDeLEmployeur, dans
  server.js : demande pourvue ou retiree, mise en avant, phrases de statut,
  note, boutons proposes. L'application mobile lit la meme fonction ; la
  page ne recalcule rien, sinon les deux finiraient par se contredire.

  La garde jePeux.publier reste, bien que la route la verifie deja :
  une vue qui ne suppose rien ne peut pas fuir.
%>
<%- include("partiels/tete") %>

  <h1>Mes demandes</h1>

  <p class="chapeau">Ce que vous avez publié, et qui vous a répondu.</p>

  <%# ---- Cote employeur : ses annonces et les candidatures recues ----
      Un membre de l'equipe est techniquement enregistre comme employeur,
      mais il n'a pas le droit de publier : lui montrer "Mes annonces"
      serait lui proposer une action que le serveur refuse. %>
  <% if (jePeux.publier) { %>
    <%# L'action principale reste accessible en permanence, et non cachee
        dans un menu. Mais une seule fois : quand la liste est vide, c'est
        le bloc ci-dessous qui porte le bouton, et il est mieux place. %>
    <% if (mesAnnonces.length > 0) { %>
      <div class="actions">
        <a class="bouton" href="/publier-annonce">
          <%- include("partiels/icone", { nom: "ajouter" }) %>
          Publier une demande
        </a>
      </div>
    <% } %>

    <% if (mesAnnonces.length === 0) { %>
      <div class="vide">
        <p>Vous n'avez publié aucune demande.</p>
        <div class="actions">
          <a class="bouton" href="/publier-annonce">
            <%- include("partiels/icone", { nom: "ajouter" }) %>
            Publier une demande
          </a>
        </div>
      </div>
    <% } else { %>
      <%# CE QUI EST EN COURS D'ABORD. La liste arrive deja rangee par le
          serveur : les demandes fermees apres les ouvertes. %>
      <% const ouvertes = mesAnnonces.filter(function (a) { return !a.fermee; }); %>
      <% const fermees  = mesAnnonces.filter(function (a) { return a.fermee; }); %>

      <%# Le titre n'apparait que s'il y a une seconde section : seul,
          au-dessus de la seule liste de la page, il n'apprendrait rien. %>
      <% if (ouvertes.length > 0 && fermees.length > 0) { %>
        <h2>Demandes en cours</h2>
      <% } %>

      <% if (ouvertes.length === 0) { %>
        <p class="vide">Aucune demande en cours.</p>
      <% } %>

      <% mesAnnonces.forEach(function (annonce, rang) { %>
        <%# Le titre de la section fermee, pose juste avant la premiere
            d'entre elles. %>
        <% if (fermees.length > 0 && rang === ouvertes.length) { %>
          <h2>Demandes terminées</h2>
          <p class="chapeau">
            Retirées ou pourvues. Elles n'apparaissent plus dans la liste
            publique, mais vos discussions et vos versements y restent
            rattachés.
          </p>
        <% } %>
        <div class="carte">
          <h3><%= annonce.titre %></h3>
          <% if (annonce.proposeeA) { %>
            <p class="aide">Proposée à <strong><%= annonce.proposeeA %></strong></p>
          <% } %>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "experience" }) %>
              <span><%= annonce.metier %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span><%= annonce.horaireLisible %></span>
            </li>
            <% if (annonce.prixLisible) { %>
              <li>
                <%- include("partiels/icone", { nom: "remuneration" }) %>
                <span>
                  <%= annonce.prixLisible %>
                  <% if (annonce.duree_estimee) { %>
                    <span class="aide"><%= annonce.duree_estimee %></span>
                  <% } %>
                </span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "lieu" }) %>
              <span><%= annonce.lieu %></span>
            </li>
          </ul>

          <% if (annonce.fermee) { %>
            <p class="aide">
              <strong><%= annonce.phraseFermeture %></strong>
              Elle n'apparaît plus dans la liste et n'accepte plus de réponse.
              Vos discussions restent accessibles.
            </p>
          <% } else { %>
            <% if (annonce.enAvant) { %>
              <p>
                <span class="badge badge-info">Mise en avant</span>
                <span class="aide">
                  jusqu'au <%= annonce.enAvantJusquAu %>
                </span>
              </p>
            <% } %>

            <div class="actions">
              <% if (annonce.peutModifier) { %>
                <a class="bouton bouton-secondaire" href="/annonces/<%= annonce.id %>/modifier">
                  <%- include("partiels/icone", { nom: "modifier" }) %>
                  Modifier cette demande
                </a>
              <% } %>
              <% if (annonce.peutMettreEnAvant) { %>
                <a class="bouton bouton-secondaire" href="/annonces/<%= annonce.id %>/mettre-en-avant">
                  <%- include("partiels/icone", { nom: "jeton" }) %>
                  Mettre en avant
                </a>
              <% } %>
              <% if (annonce.peutRetirer) { %>
                <%# Retirer n'efface rien : la demande sort de la liste
                    publique, les discussions restent. %>
                <form action="/annonces/<%= annonce.id %>/annuler" method="POST"
                      data-question="Voulez-vous vraiment retirer cette demande ?"
                      data-precision="Elle disparaîtra de la liste, personne ne pourra plus y répondre, et la somme bloquée vous sera rendue.">
                  <button type="submit" class="bouton-danger">
                    <%- include("partiels/icone", { nom: "refuser" }) %>
                    Retirer cette demande
                  </button>
                </form>
              <% } %>
            </div>

            <%# DEUX ACTIONS ROUGES SUR LE MEME ECRAN. "Retirer cette
                demande" ferme l'offre pour tout le monde ; "Refuser cette
                candidature", plus bas, ecarte UNE personne et laisse la
                demande ouverte. Rien ne les distinguait a l'oeil : meme
                couleur, meme icone. On dit donc ce que chacune fait. %>
            <p class="aide">
              <strong>Retirer ferme votre demande</strong> : elle disparaît
              de la liste, personne ne peut plus y répondre, et la somme
              bloquée vous est rendue.
              Pour écarter une seule personne sans fermer votre demande,
              utilisez <strong>Refuser cette candidature</strong> plus bas :
              les autres pourront encore vous répondre.
            </p>
          <% } %>

          <% if (annonce.candidatures.length === 0) { %>
            <p class="aide" style="margin-top:1rem">Personne n'a encore répondu.</p>
          <% } else { %>
            <% annonce.candidatures.forEach(function (candidature) { %>
              <div class="candidature">
                <div class="fiche-tete">
                  <div class="portrait"><%= candidature.nomPrestataire.charAt(0) %></div>
                  <div>
                    <h3><%= candidature.nomPrestataire %></h3>
                    <div class="metier"><%= candidature.phrase %></div>
                  </div>
                </div>

                <p>
                  <span class="badge badge-<%= candidature.verificationPrestataire.replace(/ /g, "-") %>">
                    <% if (candidature.verificationPrestataire === "verifie") { %>
                      <%- include("partiels/icone", { nom: "verifie" }) %>
                    <% } %>
                    <%= candidature.libelleVerification %>
                  </span>

                  <%# SA NOTE, ICI. C'est sous sa demande que l'employeur
                      choisit : sans ces deux chiffres il devait ouvrir une
                      fiche, revenir, et recommencer pour chaque personne. %>
                  <%- include("partiels/note-personne", {
                        nbAvis: candidature.nbAvis,
                        moyenne: candidature.moyenne,
                        services: candidature.servicesTermines }) %>
                </p>

                <%# Le montant retenu pour CETTE candidature : celui du
                    profil, ou celui convenu en discutant. %>
                <ul class="infos">
                  <li>
                    <%- include("partiels/icone", { nom: "remuneration" }) %>
                    <span>
                      <%= annonce.prixLisible %>
                    </span>
                  </li>
                </ul>

                <% if (candidature.experience) { %>
                  <ul class="infos">
                    <li>
                      <%- include("partiels/icone", { nom: "experience" }) %>
                      <span><%= candidature.experience %></span>
                    </li>
                  </ul>
                <% } %>

                <% if (candidature.disponibilites) { %>
                  <ul class="infos">
                    <li>
                      <%- include("partiels/icone", { nom: "calendrier" }) %>
                      <span>
                        Disponible
                        <strong><%= candidature.disponibilites %></strong>
                      </span>
                    </li>
                  </ul>
                <% } %>

                <div class="actions">
                  <a class="bouton bouton-secondaire" href="/personnes/<%= candidature.prestataireId %>">
                    <%- include("partiels/icone", { nom: "profil" }) %>
                    Voir le profil
                  </a>
                  <a class="bouton bouton-secondaire" href="/messages/<%= candidature.id %>">
                    <%- include("partiels/icone", { nom: "message" }) %>
                    <%= candidature.libelleDiscussion %>
                  </a>
                </div>

                <% if (candidature.peutRefuser) { %>

                  <% if (candidature.peutChoisir) { %>
                    <div class="actions">
                      <%# Choisir quelqu'un est un engagement : on passe par
                          un ecran de confirmation. Refuser ne l'est pas. %>
                      <a class="bouton" href="/candidatures/<%= candidature.id %>/confirmer">
                        <%- include("partiels/icone", { nom: "valider" }) %>
                        Choisir cette personne
                      </a>
                      <form action="/candidatures/statut" method="POST"
                            data-question="Voulez-vous vraiment refuser la candidature de <%= candidature.nomPrestataire %> ?"
                            data-precision="Votre demande reste ouverte : d'autres personnes pourront encore y répondre.">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">
                          <%- include("partiels/icone", { nom: "refuser" }) %>
                          Refuser cette candidature
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <%# On n'engage personne dont l'identite n'est pas verifiee. %>
                    <% if (candidature.attendVerification) { %>
                      <p class="aide">
                        Vous pourrez accepter cette candidature dès que PamConnect aura
                        vérifié l'identité de cette personne.
                      </p>
                    <% } %>
                    <div class="actions">
                      <form action="/candidatures/statut" method="POST"
                            data-question="Voulez-vous vraiment refuser la candidature de <%= candidature.nomPrestataire %> ?"
                            data-precision="Votre demande reste ouverte : d'autres personnes pourront encore y répondre.">
                        <input type="hidden" name="candidatureId" value="<%= candidature.id %>">
                        <input type="hidden" name="statut" value="refusee">
                        <button type="submit" class="bouton-danger">
                          <%- include("partiels/icone", { nom: "refuser" }) %>
                          Refuser cette candidature
                        </button>
                      </form>
                    </div>
                  <% } %>

                  <%# La question se pose exactement ici : refuser ferme-t-il la
                      demande ? Non, seul un choix la pourvoit. On le dit plutot
                      que de laisser deviner. %>
                  <p class="aide">
                    Refuser ne retire pas votre demande : elle reste visible,
                    et d'autres personnes peuvent encore y répondre.
                  </p>

                <% } %>
              </div>
            <% }); %>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  <% } %>

<%- include("partiels/pied") %>
