<%
/* Le detail d'un tarif, affiche a l'identique partout ou la question
   se pose : au moment de s'inscrire, sur son profil, et avant de
   repondre a une demande. Ecrit une seule fois pour que le montant
   annonce ne varie jamais d'un ecran a l'autre. */
const detail = detaillerTarif(locals.tarif);

/* Le CALCUL est le meme pour tout le monde - c'est le but de ce bloc :
   la personne recoit son prix ENTIER, la commission est ajoutee par-dessus
   et payee par l'employeur, qui paie donc le total.

   Ce qui change, ce sont les PHRASES, selon celui a qui on parle.

   Par defaut on s'adresse a la personne qui travaille : c'est le cas le
   plus frequent (son inscription, son profil). */
const pourEmployeur = locals.pourEmployeur === true;
const beneficiaire  = locals.beneficiaire || "La personne";

/* Le tarif de la personne n'est jamais montre a un employeur : ce bloc ne
   s'affiche, en pratique, que sur SON profil. */
%>
<% if (detail.brut <= 0) { %>

  <%# Cas des comptes crees avant que le tarif ne devienne obligatoire. %>
  <div class="detail-tarif">
    <% if (pourEmployeur) { %>
      <div class="ligne-tarif">
        <span><%= beneficiaire %> n'a pas encore indiqué de tarif.</span>
      </div>
      <div class="ligne-tarif">
        <span class="aide">L'équipe PamConnect vous annoncera le prix.</span>
      </div>
    <% } else { %>
      <div class="ligne-tarif">
        <span>Vous n'avez pas encore indiqué votre tarif souhaité.</span>
      </div>
      <div class="ligne-tarif">
        <span class="aide">Sans tarif souhaité, l'équipe n'a pas de point de départ quand elle vous appelle.</span>
      </div>
    <% } %>
  </div>

<% } else { %>

  <div class="detail-tarif">
    <div class="ligne-tarif">
      <span><%= pourEmployeur ? beneficiaire + " reçoit" : "Vous recevez" %></span>
      <strong><%= formaterMontant(detail.brut) %></strong>
    </div>
    <div class="ligne-tarif">
      <span>Commission PamConnect (<%= pourcentageCommission %> %), ajoutée pour l'employeur</span>
      <span class="retenue">+ <%= formaterMontant(detail.commission) %></span>
    </div>
    <div class="ligne-tarif total">
      <span><%= pourEmployeur ? "Vous payez" : "L'employeur paie" %></span>
      <strong><%= formaterMontant(detail.employeur) %></strong>
    </div>
  </div>

  <%# Sur SON profil, ce montant n'est qu'un point de depart : seule
      l'equipe le voit, et le prix se fixe au telephone. %>
  <% if (locals.indicatif && !pourEmployeur) { %>
    <p class="aide">
      Ce tarif est un point de départ : seule l'équipe PamConnect le voit,
      jamais les employeurs. C'est au téléphone que le prix est fixé, avec vous.
    </p>
  <% } %>

<% } %>
