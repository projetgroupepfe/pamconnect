<%
/* Le detail d'un tarif, affiche a l'identique partout ou la question
   se pose : au moment de s'inscrire, sur son profil, et avant de
   repondre a une demande. Ecrit une seule fois pour que le montant
   annonce ne varie jamais d'un ecran a l'autre. */
const detail = detaillerTarif(locals.tarif);

/* Le CALCUL est le meme pour tout le monde - c'est le but de ce bloc.
   Ce qui change, ce sont les PHRASES : la personne qui travaille demande
   un montant et en recoit un autre ; l'employeur, lui, paie. Lui
   afficher "Vous demandez" etait une erreur.

   Par defaut on s'adresse a la personne qui travaille : c'est le cas le
   plus frequent (son inscription, son profil, la liste des annonces). */
const pourEmployeur = locals.pourEmployeur === true;
const beneficiaire  = locals.beneficiaire || "La personne";

/* TROISIEME CAS : la personne qui travaille regarde le prix D'UNE
   DEMANDE, et non son propre tarif.

   "Vous demandez" etait faux la : elle ne demande rien, elle a postule
   a un prix annonce par quelqu'un d'autre. On nomme donc celui qui
   paie, ce qui evite aussi de repeter mot pour mot le "Prix annonce"
   affiche juste au-dessus. */
const prixAnnonce = locals.prixAnnonce === true;
%>
<% if (detail.brut <= 0) { %>

  <%# Cas des comptes crees avant que le tarif ne devienne obligatoire. %>
  <div class="detail-tarif">
    <% if (pourEmployeur) { %>
      <div class="ligne-tarif">
        <span><%= beneficiaire %> n'a pas encore indiqué de tarif.</span>
      </div>
      <div class="ligne-tarif">
        <span class="aide">Demandez-lui son montant dans la discussion.</span>
      </div>
    <% } else { %>
      <div class="ligne-tarif">
        <span>Vous n'avez pas encore indiqué votre tarif.</span>
      </div>
      <div class="ligne-tarif">
        <span class="aide">Sans tarif, les employeurs ne savent pas ce que vous demandez.</span>
      </div>
    <% } %>
  </div>

<% } else { %>

  <div class="detail-tarif">
    <div class="ligne-tarif">
      <span><%= pourEmployeur ? "Vous payez" : (prixAnnonce ? "L'employeur paie" : "Vous demandez") %></span>
      <strong><%= formaterMontant(detail.brut) %></strong>
    </div>
    <div class="ligne-tarif">
      <span>Commission PamConnect (<%= pourcentageCommission %> %)</span>
      <span class="retenue">− <%= formaterMontant(detail.commission) %></span>
    </div>
    <div class="ligne-tarif total">
      <span><%= pourEmployeur ? beneficiaire + " reçoit" : "Vous recevez" %></span>
      <strong><%= formaterMontant(detail.net) %></strong>
    </div>
  </div>

  <%# Sur SON profil, ce montant n'est qu'une indication : le prix
      reellement paye est celui annonce dans la demande a laquelle elle
      repond. Sans cette phrase, l'ecran promettait une somme qui n'a
      aucune raison d'etre celle qu'elle touchera. %>
  <% if (locals.indicatif && !pourEmployeur) { %>
    <p class="aide">
      Ce tarif est indicatif. Le montant réellement reçu dépend de la demande
      à laquelle vous répondez : la commission de <%= pourcentageCommission %> %
      s'applique au prix annoncé par l'employeur.
    </p>
  <% } %>

<% } %>
