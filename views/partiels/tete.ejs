<%# Debut de page commun a TOUTES les vues.
    Sur telephone, le menu est une barre fixe en bas de l'ecran, comme
    dans une application : chaque bouton porte une icone ET son mot.
    Sur grand ecran, ce meme menu remonte dans l'en-tete (voir style.css). %>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PamConnect - <%= titre %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <header class="entete">
    <div class="entete-interieur">

      <div class="marque">
        <a class="logo" href="/">
          <%# Un bouclier avec une coche : la verification d'identite,
              qui est la promesse centrale de la plateforme. %>
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#1F4E79"
               stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
               aria-hidden="true" focusable="false">
            <path d="M20 13c0 5-3.5 7.5-7.7 9a1 1 0 0 1-.7 0C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.2-2.7a1.2 1.2 0 0 1 1.5 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1Z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
          <span>Pam<strong>Connect</strong></span>
        </a>

        <%# La zone couverte est annoncee des l'entree, a cote du nom :
            un visiteur sait immediatement si la plateforme le concerne. %>
        <span class="lieu-entete">
          <%- include("icone", { nom: "lieu", taille: 15 }) %>
          Yaoundé
        </span>
      </div>

      <%
        /* Le menu ne montre a chacun que ce qui le concerne.

           "Rechercher" sert a trouver une aide-menagere : c'est l'outil
           de l'employeur, il n'a rien a faire chez la personne qui
           propose ses services. Un membre de l'equipe, lui, ne cherche
           personne et ne repond a rien : il verifie des dossiers.

           Une barre de telephone supporte quatre ou cinq entrees. Au-dela
           elles deviennent trop etroites pour etre touchees du pouce -
           c'est pourquoi chaque role n'a que les siennes. */
        const entrees = [{ url: "/", icone: "maison", texte: "Accueil" }];

        if (!locals.moi || locals.jePeux.publier) {
          entrees.push({ url: "/recherche", icone: "recherche", texte: "Rechercher" });
        }
        if (!locals.moi || !locals.jePeux.verifierDossiers) {
          entrees.push({ url: "/annonces", icone: "document", texte: "Annonces" });
        }
        if (locals.moi && !locals.jePeux.verifierDossiers) {
          /* La plateforme n'envoie ni email ni SMS. La seule notification
             qu'elle peut donner, c'est celle-ci : ce qui attend la
             personne, la ou elle regarde deja.
             Messages non lus ET decisions non vues : etre choisi sans que
             rien ne s'allume revenait a ne pas etre prevenu. */
          entrees.push({ url: "/messages", icone: "message", texte: "Messages",
                         pastille: locals.aVoir });
        }
        if (locals.moi && locals.jePeux.verifierDossiers) {
          entrees.push({ url: "/admin", icone: "equipe", texte: "Équipe" });
        }
        /* La pastille sert aussi ici : un message de l'equipe ou un
           avertissement attend sur le profil, et sans signal il pouvait
           y rester des semaines sans etre vu. */
        entrees.push(locals.moi
          ? { url: "/mon-profil", icone: "profil", texte: "Mon profil",
              pastille: locals.aLireSurMonProfil }
          : { url: "/connexion", icone: "profil", texte: "Connexion" });
      %>
      <nav class="menu" aria-label="Navigation principale">
        <% entrees.forEach(function (entree) { %>
          <%# La page ouverte est marquee de deux facons : par la couleur,
              et par aria-current que les lecteurs d'ecran annoncent. Une
              couleur seule laisse de cote qui ne la distingue pas. %>
          <% const active = entree.url === "/"
               ? locals.chemin === "/"
               : String(locals.chemin || "").startsWith(entree.url); %>
          <a href="<%= entree.url %>"
             class="<%= active ? "actif" : "" %>"
             <%# La balise d affichage ordinaire echapperait les guillemets
                 de l attribut, qui ne vaudrait plus rien. On ecrit donc
                 le texte tel quel : sa valeur vient de nous, jamais d un
                 utilisateur. %>
             <%- active ? 'aria-current="page"' : "" %>>
            <%- include("icone", { nom: entree.icone }) %><%= entree.texte %><% if (entree.pastille > 0) { %><span class="pastille" aria-label="<%= entree.pastille %> message<%= entree.pastille > 1 ? "s" : "" %> non lu<%= entree.pastille > 1 ? "s" : "" %>"><%= entree.pastille %></span><% } %>
          </a>
        <% }); %>
      </nav>

      <div class="entete-actions">
        <% if (locals.moi) { %>
          <%# La deconnexion passe par un formulaire POST : une simple
              adresse GET pourrait etre declenchee a l'insu de la personne. %>
          <form action="/deconnexion" method="POST">
            <button type="submit" class="bouton-icone" title="Déconnexion">
              <%- include("icone", { nom: "deconnexion" }) %>
              <span class="lecture-ecran">Déconnexion</span>
            </button>
          </form>
        <% } else { %>
          <a class="bouton" href="/inscription">Créer un compte</a>
        <% } %>
      </div>

    </div>
  </header>

  <main class="contenu">
