<%- include("partiels/tete") %>

  <h1>Annonces disponibles</h1>
  <p class="chapeau">Les demandes publiées par les employeurs de Yaoundé.</p>

  <% if (role === "employeur") { %>
    <div class="actions">
      <a class="bouton" href="/publier-annonce">
        <%- include("partiels/icone", { nom: "ajouter" }) %>
        Publier une annonce
      </a>
    </div>
  <% } %>

  <% if (annonces.length === 0) { %>

    <%# ILLUSTRATION 3 sur 3 : un etat vide. %>
    <div class="vide">
      <svg class="illustration" width="72" height="72" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
        <path d="M14 2v6h6"/><path d="M9 15h6"/>
      </svg>
      <p>Aucune annonce pour le moment.</p>
    </div>

  <% } else { %>

    <div class="grille">
      <% annonces.forEach(function (annonce) { %>
        <div class="carte">
          <h3><%= annonce.titre %></h3>

          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "experience" }) %>
              <span><strong><%= annonce.metier %></strong></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span><strong><%= annonce.horaire || "Horaire non précisé" %></strong></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "lieu" }) %>
              <span>
                <% if (annonce.quartier) { %><strong><%= annonce.quartier %></strong>, <% } %><%= annonce.arrondissement %>
              </span>
            </li>
          </ul>

          <% if (role === "prestataire") { %>
            <%# Avant de repondre, la personne revoit ce qu'elle touchera
                reellement : aucun montant ne doit etre une surprise. %>
            <%- include("partiels/detail-tarif", { tarif: moi.tarif }) %>

            <div class="actions">
              <form action="/candidatures" method="POST">
                <button type="submit">
                  <%- include("partiels/icone", { nom: "valider" }) %>
                  Je suis disponible
                </button>
                <input type="hidden" name="annonceId" value="<%= annonce.id %>">
              </form>
            </div>
          <% } else if (role === "employeur") { %>
            <p class="aide">Seules les personnes qui proposent leurs services peuvent répondre.</p>
          <% } else { %>
            <p class="aide">
              <a href="/connexion">Connectez-vous</a> pour répondre à cette demande.
            </p>
          <% } %>
        </div>
      <% }); %>
    </div>

  <% } %>

<%- include("partiels/pied") %>
