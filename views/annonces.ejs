<%- include("partiels/tete") %>

  <h1>Demandes disponibles</h1>
  <p class="chapeau">Les demandes publiées par les employeurs de Yaoundé.</p>


  <% if (jePeux.publier) { %>
    <div class="actions">
      <a class="bouton" href="/publier-annonce">
        <%- include("partiels/icone", { nom: "ajouter" }) %>
        Publier une demande
      </a>
    </div>
  <% } %>

  <% if (pourMoi.length === 0 && autres.length === 0) { %>

    <%# ILLUSTRATION 2 sur 2 : un etat vide. %>
    <div class="vide">
      <svg class="illustration" width="72" height="72" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
           stroke-linejoin="round" aria-hidden="true">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/>
        <path d="M14 2v6h6"/><path d="M9 15h6"/>
      </svg>
      <p>Aucune demande pour le moment.</p>
    </div>

  <% } else { %>

    <% if (monMetier) { %>
      <h2>Pour vous : <%= monMetier %></h2>
      <% if (pourMoi.length === 0) { %>
        <div class="vide">
          <p>Aucune demande de <%= monMetier %> pour le moment.</p>
        </div>
      <% } else { %>
        <div class="grille">
          <% pourMoi.forEach(function (annonce) { %>
            <%- include("partiels/carte-annonce", { annonce: annonce }) %>
          <% }); %>
        </div>
      <% } %>

      <% if (autres.length > 0) { %>
        <h2>Les autres demandes</h2>
        <p class="aide">
          Elles ne correspondent pas à ce que vous avez indiqué, mais rien
          ne vous empêche d'y répondre.
        </p>
      <% } %>
    <% } %>

    <% if (autres.length > 0) { %>
      <div class="grille">
        <% autres.forEach(function (annonce) { %>
          <%- include("partiels/carte-annonce", { annonce: annonce }) %>
        <% }); %>
      </div>
    <% } %>

  <% } %>

<%- include("partiels/pied") %>
