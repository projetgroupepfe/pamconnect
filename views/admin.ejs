<%- include("partiels/tete") %>

  <h1>Espace équipe</h1>
  <p class="chapeau">
    Espace réservé à l'équipe PamConnect. Vérifiez les pièces déposées
    avant de valider une identité.
  </p>

  <p class="actions">
    <% statistiques.forEach(function (ligne) { %>
      <span class="badge badge-<%= ligne.statut.replace(/ /g, "-") %>">
        <%= libelleVerification(ligne.statut) %> : <%= ligne.nb %>
      </span>
    <% }); %>
  </p>

  <%# L'autre travail de l'equipe, sur sa propre page. Le compte affiche
      ici evite d'avoir a aller voir pour savoir s'il y a du travail. %>
  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin/signalements">
      <%- include("partiels/icone", { nom: "message" }) %>
      Messages signalés<% if (signalementsOuverts > 0) { %> (<%= signalementsOuverts %>)<% } %>
    </a>
  </p>

  <h2>Dossiers à vérifier</h2>

  <% if (dossiers.length === 0) { %>

    <p class="vide">Aucun dossier en attente.</p>

  <% } else { %>

    <% dossiers.forEach(function (dossier) { %>
      <div class="carte">
        <h3><%= dossier.nom %></h3>
        <p class="discret">
          <%# Un dossier d'employeur et un dossier de personne qui travaille
              ne se lisent pas pareil : la grille est la meme, mais l'equipe
              doit savoir qui elle regarde. %>
          <strong><%= dossier.role === "employeur" ? "Employeur" : dossier.metier %></strong><br>
          <%= dossier.email %><br>
          <%= dossier.arrondissement %><%= dossier.quartier ? ", " + dossier.quartier : "" %>
        </p>

        <%# Un delai annonce a la personne engage l'equipe. Encore faut-il
            qu'elle voie lequel de ces dossiers est sur le point de le
            depasser : la liste est triee du plus ancien au plus recent. %>
        <% const att = attenteVerification(dossier.documents_envoyes_le); %>
        <p>
          <% if (att === null) { %>
            <span class="badge badge-non-soumis">Date d'envoi inconnue</span>
          <% } else if (att.depasse) { %>
            <span class="badge badge-refuse">
              Délai dépassé, reçu <%= attenteLisible(dossier.documents_envoyes_le) %>
            </span>
          <% } else { %>
            <span class="badge badge-en-attente">
              Reçu <%= attenteLisible(dossier.documents_envoyes_le) %>,
              <%= att.restantes %> h restante<%= att.restantes > 1 ? "s" : "" %>
            </span>
          <% } %>
        </p>

        <%# Ces liens passent par une route qui verifie que le demandeur est
            administrateur. Le nom du fichier n'apparait jamais dans l'adresse :
            on ne transmet que l'identifiant du prestataire. %>
        <p class="actions">
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/document/<%= dossier.id %>/cni">Ouvrir la pièce d'identité</a>
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/document/<%= dossier.id %>/casier">Ouvrir le casier judiciaire</a>
        </p>

        <div class="candidature">
          <div class="actions">
            <form action="/admin/verification" method="POST" class="en-ligne">
              <input type="hidden" name="utilisateurId" value="<%= dossier.id %>">
              <input type="hidden" name="decision" value="valider">
              <button type="submit">Valider l'identité</button>
            </form>
          </div>

          <form action="/admin/verification" method="POST">
            <input type="hidden" name="utilisateurId" value="<%= dossier.id %>">
            <input type="hidden" name="decision" value="refuser">
            <div class="champ" style="margin-top:1rem">
              <label for="motif-<%= dossier.id %>">Motif du refus</label>
              <input type="text" id="motif-<%= dossier.id %>" name="motif"
                     placeholder="ex : document illisible">
            </div>
            <button type="submit" class="bouton-danger">Refuser le dossier</button>
          </form>
        </div>
      </div>
    <% }); %>

  <% } %>

  <div class="carte confiance">
    <h3>Rappel</h3>
    <p>
      Dans les deux cas, valider ou refuser, les deux documents sont
      <strong>définitivement supprimés du serveur</strong>. Seuls le statut et
      sa date sont conservés. Vérifiez donc les pièces avant de décider.
    </p>
  </div>

<%- include("partiels/pied") %>
