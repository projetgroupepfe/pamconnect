<%- include("partiels/tete") %>

  <h1>Espace équipe</h1>
  <p class="chapeau">
    Espace réservé à l'équipe PamConnect. Vérifiez les pièces déposées
    avant de valider une identité.
  </p>

  <p class="actions">
    <% statistiques.forEach(function (ligne) { %>
      <span class="badge badge-<%= ligne.statut.replace(/ /g, "-") %>">
        <%= libelleVerification(ligne.statut) %> : <%= ligne.nb %>
      </span>
    <% }); %>
  </p>

  <%# L'autre travail de l'equipe, sur sa propre page. Le compte affiche
      ici evite d'avoir a aller voir pour savoir s'il y a du travail. %>
  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin/signalements">
      <%- include("partiels/icone", { nom: "message" }) %>
      Messages signalés<% if (signalementsOuverts > 0) { %> (<%= signalementsOuverts %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/problemes">
      <%- include("partiels/icone", { nom: "info" }) %>
      Problèmes signalés<% if (problemesOuverts > 0) { %> (<%= problemesOuverts %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/utilisateurs">
      <%- include("partiels/icone", { nom: "profil" }) %>
      Annuaire<% if (codesDemandes > 0) { %> (<%= codesDemandes %> à rappeler)<% } else if (personnesConnues > 0) { %> (<%= personnesConnues %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/mises-en-relation">
      <%- include("partiels/icone", { nom: "telephone" }) %>
      Mises en relation<% if (demandesATraiter > 0) { %> (<%= demandesATraiter %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/paiements">
      <%- include("partiels/icone", { nom: "remuneration" }) %>
      Paiements<% if (paiementsEnAttente > 0) { %> (<%= paiementsEnAttente %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/jetons">
      <%- include("partiels/icone", { nom: "jeton" }) %>
      Jetons<% if (achatsJetons > 0) { %> (<%= achatsJetons %>)<% } %>
    </a>
    <a class="bouton bouton-secondaire" href="/admin/avis">
      <%- include("partiels/icone", { nom: "avis" }) %>
      Avis signalés<% if (avisSignales > 0) { %> (<%= avisSignales %>)<% } %>
    </a>
  </p>

  <h2>Dossiers à vérifier</h2>

  <% if (dossiers.length === 0) { %>

    <p class="vide">Aucun dossier en attente.</p>

  <% } else { %>

    <% dossiers.forEach(function (dossier) { %>
      <div class="carte">
        <h3><%= dossier.nom %></h3>
        <p class="discret">
          <%# Un dossier d'employeur et un dossier de personne qui travaille
              ne se lisent pas pareil : la grille est la meme, mais l'equipe
              doit savoir qui elle regarde. %>
          <strong><%= dossier.role === "employeur" ? "Employeur" : dossier.metier %></strong><br>
          <%= dossier.email %><br>
          <%# L'equipe appelle : le numero est sous ses yeux, et le lien
              compose directement depuis un telephone. %>
          <% if (dossier.telephone) { %>
            <a href="tel:+237<%= dossier.telephone %>"><%= dossier.telephone %></a><br>
          <% } %>
          <%= dossier.arrondissement %><%= dossier.quartier ? ", " + dossier.quartier : "" %>
        </p>

        <%# Un delai annonce a la personne engage l'equipe. Encore faut-il
            qu'elle voie lequel de ces dossiers est sur le point de le
            depasser : la liste est triee du plus ancien au plus recent. %>
        <% const att = attenteVerification(dossier.documents_envoyes_le); %>
        <p>
          <% if (att === null) { %>
            <span class="badge badge-non-soumis">Date d'envoi inconnue</span>
          <% } else if (att.depasse) { %>
            <span class="badge badge-refuse">
              Délai dépassé, reçu <%= attenteLisible(dossier.documents_envoyes_le) %>
            </span>
          <% } else { %>
            <span class="badge badge-en-attente">
              Reçu <%= attenteLisible(dossier.documents_envoyes_le) %>,
              <%= att.restantes %> h restante<%= att.restantes > 1 ? "s" : "" %>
            </span>
          <% } %>
        </p>

        <%# Ces liens passent par une route qui verifie que le demandeur est
            administrateur. Le nom du fichier n'apparait jamais dans l'adresse :
            on ne transmet que l'identifiant du prestataire. %>
        <p class="actions">
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/document/<%= dossier.id %>/cni">Ouvrir la pièce d'identité</a>
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/document/<%= dossier.id %>/casier">Ouvrir le casier judiciaire</a>
          <% if (dossier.aUnePhoto) { %>
            <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
               href="/admin/document/<%= dossier.id %>/photo">Ouvrir la photo du visage</a>
          <% } %>
        </p>
        <p class="aide">Vérifiez que l'extrait de casier date de moins de 3 mois.</p>
        <% if (dossier.aUnePhoto) { %>
          <p class="aide">Comparez le visage de la photo à celui de la pièce d'identité avant de valider.</p>
        <% } %>

        <div class="candidature">
          <div class="actions">
            <form action="/admin/verification" method="POST" class="en-ligne">
              <input type="hidden" name="utilisateurId" value="<%= dossier.id %>">
              <input type="hidden" name="decision" value="valider">
              <button type="submit">Valider l'identité</button>
            </form>
          </div>

          <form action="/admin/verification" method="POST">
            <input type="hidden" name="utilisateurId" value="<%= dossier.id %>">
            <input type="hidden" name="decision" value="refuser">
            <div class="champ" style="margin-top:1rem">
              <label for="motif-<%= dossier.id %>">Motif du refus</label>
              <input type="text" id="motif-<%= dossier.id %>" name="motif"
                     placeholder="ex : document illisible">
            </div>
            <button type="submit" class="bouton-danger">Refuser le dossier</button>
          </form>
        </div>
      </div>
    <% }); %>

  <% } %>

  <%# LES CHANGEMENTS DE PHOTO d'une personne deja verifiee. La piece
      d'identite est renvoyee avec la photo : elle a ete supprimee apres la
      verification, et c'est elle qui permet de comparer. %>
  <h2>Photos à contrôler</h2>
  <% if (photosAControler.length === 0) { %>
    <p class="vide">Aucune photo à contrôler.</p>
  <% } else { %>
    <% photosAControler.forEach(function (demande) { %>
      <div class="carte">
        <h3><%= demande.nom %></h3>
        <p class="discret">
          <strong><%= demande.role === "employeur" ? "Employeur" : demande.metier %></strong><br>
          <%= demande.email %>
        </p>
        <p class="actions">
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/photo/<%= demande.id %>/photo">Ouvrir la photo du visage</a>
          <a class="bouton bouton-secondaire" target="_blank" rel="noopener"
             href="/admin/photo/<%= demande.id %>/piece">Ouvrir la pièce d'identité</a>
        </p>
        <p class="aide">Comparez le visage de la photo à celui de la pièce d'identité avant de valider.</p>

        <div class="candidature">
          <div class="actions">
            <form action="/admin/photos" method="POST" class="en-ligne">
              <input type="hidden" name="utilisateurId" value="<%= demande.id %>">
              <input type="hidden" name="decision" value="accepter">
              <button type="submit">Accepter la photo</button>
            </form>
          </div>

          <form action="/admin/photos" method="POST">
            <input type="hidden" name="utilisateurId" value="<%= demande.id %>">
            <input type="hidden" name="decision" value="refuser">
            <div class="champ" style="margin-top:1rem">
              <label for="motif-photo-<%= demande.id %>">Motif du refus (lu par la personne)</label>
              <input type="text" id="motif-photo-<%= demande.id %>" name="motif"
                     placeholder="ex : le visage n'est pas visible">
            </div>
            <button type="submit" class="bouton-danger">Refuser</button>
          </form>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="carte confiance">
    <h3>Rappel</h3>
    <p>
      Dans les deux cas, valider ou refuser, les deux documents sont
      <strong>définitivement supprimés du serveur</strong>. Seuls le statut et
      sa date sont conservés. Vérifiez donc les pièces avant de décider.
    </p>
  </div>

<%- include("partiels/pied") %>
