<%- include("partiels/tete") %>

  <div class="colonne">

    <h1>Confirmer votre choix</h1>
    <p class="chapeau">
      Relisez ce sur quoi vous vous engagez. Rien n'est décidé tant que vous
      n'avez pas confirmé.
    </p>

    <h2>La personne que vous choisissez</h2>
    <div class="carte">
      <div class="fiche-tete">
        <div class="portrait"><%= c.nomPrestataire.charAt(0) %></div>
        <div>
          <h3><%= c.nomPrestataire %></h3>
          <div class="metier"><%= c.metierPrestataire %></div>
        </div>
      </div>

      <p class="confiance">
        <span class="badge badge-verifie">
          <%- include("partiels/icone", { nom: "verifie" }) %>
          Identité et casier vérifiés
        </span>

        <%# LE MOMENT DE LA DECISION. Sa note doit etre la, pas a un
            clic de la. %>
        <%- include("partiels/note-personne", {
              nbAvis: reputation.nombre,
              moyenne: reputation.moyenne,
              services: reputation.services }) %>
        <% if (libelleExperience(c.experiencePrestataire)) { %>
          <span class="badge badge-info">
            <%- include("partiels/icone", { nom: "experience" }) %>
            <%= libelleExperience(c.experiencePrestataire) %>
          </span>
        <% } %>
      </p>

      <div class="actions">
        <a class="bouton bouton-secondaire" href="/personnes/<%= c.prestataireId %>">
          <%- include("partiels/icone", { nom: "profil" }) %>
          Voir son profil
        </a>
      </div>
    </div>

    <%- include("partiels/portee-verification", { court: true }) %>

    <h2>La prestation</h2>
    <div class="carte">
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "experience" }) %>
          <span>Service : <strong><%= c.metierAnnonce %></strong></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "calendrier" }) %>
          <span>Horaire : <strong><%= c.horaireAnnonce || "non précisé" %></strong></span>
        </li>
        <% if (c.dureeAnnonce) { %>
          <li>
            <%- include("partiels/icone", { nom: "disponibilite" }) %>
            <span>Durée estimée : <strong><%= c.dureeAnnonce %></strong></span>
          </li>
        <% } %>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <%# Le LIEU GENERAL, jamais l'adresse exacte : la plateforme ne la
              demande pas. L'employeur la donne a la personne choisie, dans
              la discussion. %>
          <span>
            Lieu :
            <strong><% if (c.quartierAnnonce) { %><%= c.quartierAnnonce %>, <% } %><%= c.arrondissementAnnonce %></strong>
          </span>
        </li>
        <% if (c.conditionsAnnonce) { %>
          <li>
            <%- include("partiels/icone", { nom: "info" }) %>
            <span><%= c.conditionsAnnonce %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <div class="carte">
      <p>
        L'équipe PamConnect vous rappellera avec le prix, avant le service.
      </p>
    </div>

    <%# Ce qui va se passer, dit AVANT de cliquer. Une consequence
        decouverte apres coup est une mauvaise surprise. %>
    <div class="carte">
      <h3>Ce qui se passera ensuite</h3>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "document" }) %>
          <span>Votre demande sera <strong>retirée de la liste</strong> : quelqu'un a été choisi.</span>
        </li>
        <%# La phrase vient de confirmationDuChoix : l'application la lit
            aussi, et les deux ne peuvent pas diverger. %>
        <% if (refusAnnonces) { %>
          <li>
            <%- include("partiels/icone", { nom: "refuser" }) %>
            <span><strong><%= refusAnnonces.nombre %></strong> <%= refusAnnonces.suite %></span>
          </li>
        <% } %>
        <li>
          <%- include("partiels/icone", { nom: "message" }) %>
          <span>Vos discussions restent accessibles, y compris avec les autres candidates.</span>
        </li>
      </ul>
    </div>

    <div class="actions">
      <form action="/candidatures/statut" method="POST">
        <input type="hidden" name="candidatureId" value="<%= c.id %>">
        <input type="hidden" name="statut" value="acceptee">
        <button type="submit">
          <%- include("partiels/icone", { nom: "valider" }) %>
          Confirmer et choisir <%= c.nomPrestataire %>
        </button>
      </form>
      <a class="bouton bouton-secondaire" href="/mes-demandes">Annuler</a>
    </div>

  </div>

<%- include("partiels/pied") %>
