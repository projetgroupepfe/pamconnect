<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Modifier mon profil</h1>

    <div class="carte">
      <form action="/mon-profil/modifier" method="POST">

        <div class="champ">
          <label for="nom">Votre nom</label>
          <input type="text" id="nom" name="nom" value="<%= utilisateur.nom %>"
                 autocomplete="name" required>
        </div>

        <%# Arrondissement et quartier servent a se rencontrer. Un compte
            d'equipe ne rencontre personne : ces deux champs ne lui sont
            pas demandes. %>
        <% if (!utilisateur.est_admin) { %>

        <%- include("partiels/champ-lieu", {
              quartier: utilisateur.quartier,
              arrondissement: utilisateur.arrondissement,
              obligatoire: false }) %>

        <% } %>

        <% if (utilisateur.role === "prestataire") { %>

          <%- include("partiels/champ-metier", {
                valeur: utilisateur.metier, intitule: "Ce que vous faites",
                obligatoire: true }) %>

          <%- include("partiels/champ-disponibilites", { utilisateur: utilisateur }) %>

          <div class="champ">
            <label for="tarif">Le tarif que vous demandez (FCFA)</label>
            <input type="number" id="tarif" name="tarif"
                   value="<%= utilisateur.tarif || "" %>"
                   placeholder="ex : 10000" min="<%= montantMinimum %>" step="<%= pasMontant %>" required>
            <span class="aide">C'est ce que vous demandez pour vos services.</span>
          </div>

          <%# Le detail se recalcule pendant la saisie, comme a l'inscription. %>
          <div class="detail-tarif" id="detailTarif" hidden>
            <div class="ligne-tarif">
              <span>Vous demandez</span>
              <strong id="montantBrut">…</strong>
            </div>
            <div class="ligne-tarif">
              <span>Commission PamConnect (<%= pourcentageCommission %> %)</span>
              <span class="retenue" id="montantCommission">…</span>
            </div>
            <div class="ligne-tarif total">
              <span>Vous recevez</span>
              <strong id="montantNet">…</strong>
            </div>
            <p class="aide">
              Ce tarif est indicatif. Le montant réellement reçu dépend de la demande
              à laquelle vous répondez : la commission de <%= pourcentageCommission %> %
              s'applique au prix annoncé par l'employeur.
            </p>
          </div>

        <% } %>

        <%# La position sert a calculer une distance. Elle n'a de sens que
            pour les deux personnes qui vont se rencontrer, et la phrase
            qui l'explique n'est pas la meme des deux cotes. %>
        <% if (!utilisateur.est_admin) { %>
          <input type="hidden" id="latitude" name="latitude">
          <input type="hidden" id="longitude" name="longitude">
          <p class="aide">
            <% if (utilisateur.role === "employeur") { %>
              Si vous autorisez la localisation, PamConnect pourra vous montrer
              en premier les personnes qui travaillent près de chez vous.
            <% } else { %>
              Si vous autorisez la localisation, les familles proches de chez
              vous vous trouveront plus facilement.
            <% } %>
          </p>
        <% } %>

        <div class="actions">
          <button type="submit">
            <%- include("partiels/icone", { nom: "valider" }) %>
            Enregistrer
          </button>
          <a class="bouton bouton-secondaire" href="/mon-profil">Annuler</a>
        </div>
      </form>
    </div>

    <%# L'adresse et le mot de passe sont les deux cles du compte.
        Chacune a sa propre section, et chacune exige le mot de passe
        actuel : on ne change pas une cle par megarde. %>
    <h2>Changer mon adresse email</h2>

    <div class="carte">
      <p class="discret">
        Adresse actuelle : <strong><%= utilisateur.email %></strong>
      </p>

      <form action="/mon-profil/email" method="POST">
        <div class="champ">
          <label for="nouvelEmail">Nouvelle adresse</label>
          <input type="email" id="nouvelEmail" name="nouveau"
                 autocomplete="email" required>
          <span class="aide">C'est cette adresse qu'il faudra saisir pour vous connecter.</span>
        </div>
        <div class="champ">
          <label for="motdepasseEmail">Votre mot de passe</label>
          <input type="password" id="motdepasseEmail" name="motdepasse"
                 autocomplete="current-password" required>
        </div>
        <div class="actions">
          <button type="submit" class="bouton-secondaire">Changer mon adresse</button>
        </div>
      </form>
    </div>

    <h2>Changer mon mot de passe</h2>

    <div class="carte">
      <form action="/mon-profil/mot-de-passe" method="POST">
        <div class="champ">
          <label for="ancien">Mot de passe actuel</label>
          <input type="password" id="ancien" name="ancien"
                 autocomplete="current-password" required>
        </div>
        <div class="champ">
          <label for="nouveau">Nouveau mot de passe</label>
          <input type="password" id="nouveau" name="nouveau"
                 autocomplete="new-password" minlength="<%= motDePasseMin %>" required>
          <span class="aide"><%= motDePasseMin %> caractères au minimum.</span>
        </div>
        <div class="actions">
          <button type="submit" class="bouton-secondaire">Changer mon mot de passe</button>
        </div>
      </form>
    </div>
  </div>

<% if (utilisateur.role === "prestataire") { %>
<script>
  // --- Le detail du tarif, recalcule pendant la saisie ----------------
  const TAUX = <%= pourcentageCommission %> / 100;
  const champTarif = document.getElementById("tarif");
  const detail = document.getElementById("detailTarif");

  function montant(nombre) {
    return Math.round(nombre).toLocaleString("fr-FR") + " FCFA";
  }

  function majDetailTarif() {
    const brut = Math.round(Number(champTarif.value) || 0);

    if (brut <= 0) {
      detail.hidden = true;
      return;
    }

    const commission = Math.round(brut * TAUX);
    document.getElementById("montantBrut").textContent = montant(brut);
    document.getElementById("montantCommission").textContent = "− " + montant(commission);
    document.getElementById("montantNet").textContent = montant(brut - commission);
    detail.hidden = false;
  }

  champTarif.addEventListener("input", majDetailTarif);
  majDetailTarif();   // affiche le detail du tarif deja enregistre
</script>
<% } %>

<% if (!utilisateur.est_admin) { %>
<script>
  // --- Position GPS, si la personne l'autorise ------------------------
  // Inutile de reclamer la position d'un membre de l'equipe : le
  // navigateur afficherait une demande d'autorisation sans aucune raison.
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      function (position) {
        document.getElementById("latitude").value = position.coords.latitude;
        document.getElementById("longitude").value = position.coords.longitude;
      },
      function (erreur) {
        console.log("Position non disponible :", erreur.message);
      }
    );
  }
</script>
<% } %>

<%- include("partiels/pied") %>
