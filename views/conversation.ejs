<%- include("partiels/tete") %>

  <div class="colonne">

    <h1>Discussion</h1>

    <%# Le rappel de ce dont on parle. Sans lui, on ouvre une conversation
        sans savoir a quelle demande elle se rapporte. %>
    <div class="carte">
      <h3><%= conversation.titreAnnonce %></h3>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "profil" }) %>
          <span>
            Avec
            <strong><%= jeSuisEmployeur ? conversation.nomPrestataire : conversation.nomEmployeur %></strong><% if (jeSuisEmployeur && conversation.metierPrestataire) { %> — <%= conversation.metierPrestataire %><% } %>
          </span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "calendrier" }) %>
          <span><%= conversation.horaireAnnonce || "Horaire non précisé" %></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span>
            <% if (conversation.quartierAnnonce) { %><%= conversation.quartierAnnonce %>, <% } %><%= conversation.arrondissementAnnonce %>
          </span>
        </li>
        <% if (conversation.conditionsAnnonce) { %>
          <li>
            <%- include("partiels/icone", { nom: "info" }) %>
            <span><%= conversation.conditionsAnnonce %></span>
          </li>
        <% } %>
        <li>
          <%- include("partiels/icone", { nom: "disponibilite" }) %>
          <span><strong><%= phraseCandidature(conversation.statut, jeSuisEmployeur) %></strong></span>
        </li>
      </ul>
    </div>

    <%# ---- Le prix de la demande ---- %>
    <h2>Le prix</h2>
    <div class="carte">
      <%# Un seul montant compte : celui que l'employeur a annonce. La
          personne a postule en le connaissant. On le rappelle ici avec la
          commission, pour que le calcul soit le meme partout. %>
      <% if (conversation.prixAnnonce) { %>
        <%- include("partiels/detail-tarif", {
              tarif: conversation.prixAnnonce,
              pourEmployeur: jeSuisEmployeur,
              beneficiaire: conversation.nomPrestataire }) %>

        <p class="aide">
          <% if (jeSuisEmployeur) { %>
            C'est le prix que vous avez annoncé dans votre demande.
          <% } else { %>
            C'est le prix annoncé par <%= conversation.nomEmployeur %> dans sa demande.
          <% } %>
        </p>
      <% } else { %>
        <p class="aide">
          Cette demande a été publiée avant que le prix ne devienne obligatoire :
          elle n'en porte pas.
        </p>
      <% } %>
    </div>

    <%# ---- Les messages ---- %>
    <h2>Les messages</h2>

    <% if (messages.length === 0) { %>
      <div class="vide">
        <p>Aucun message pour l'instant. Écrivez le premier.</p>
      </div>
    <% } else { %>
      <% messages.forEach(function (message) { %>
        <%
          // Le role de l'auteur n'est pas stocke : il se deduit en
          // comparant son identifiant a ceux de la conversation.
          const deMoi = (jeSuisEmployeur && message.auteur_id === conversation.employeurId)
                     || (!jeSuisEmployeur && message.auteur_id === conversation.prestataireId);
        %>
        <div class="carte<%= deMoi ? " message-mien" : "" %>">
          <p class="aide">
            <strong><%= deMoi ? "Vous" : message.nomAuteur %></strong>
            · <%= message.cree_le %>
            <% if (message.signale) { %> · signalé à l'équipe<% } %>
          </p>

          <p><%= message.texte %></p>

          <%# L'avertissement s'affiche aux DEUX personnes, pas seulement
              a celle qui recoit : celle qui a ecrit doit savoir qu'elle
              prend un risque, elle aussi. %>
          <% if (message.risque_paiement) { %>
            <p class="aide">
              <strong>Pour votre sécurité, ne payez pas directement en dehors de
              la plateforme.</strong> Le paiement doit passer par PamConnect pour que
              la personne reçoive son argent après confirmation de la prestation.
              En dehors, personne n'a de recours en cas de problème.
            </p>
          <% } %>

          <%# Signaler reste attache au message : l'equipe doit savoir
              LEQUEL. Mais c'est une action rare, alors qu'ecrire est une
              action quotidienne - son poids a l'ecran suit sa frequence,
              pas son importance. %>
          <% if (!deMoi && !message.signale) { %>
            <form action="/messages/<%= message.id %>/signaler" method="POST">
              <input type="hidden" name="candidatureId" value="<%= conversation.id %>">
              <button type="submit" class="lien-discret">Signaler ce message</button>
            </form>
          <% } %>
        </div>
      <% }); %>
    <% } %>

        <% if (conversation.terminee_le) { %>

      <%# ---- Le service est fait : on relit, on n'ecrit plus ---- %>
      <div class="carte confiance">
        <h3>Service terminé</h3>
        <p>
          <%= conversation.nomEmployeur %> a déclaré ce service effectué le
          <strong><%= conversation.terminee_le %></strong>.
        </p>
        <p class="aide">
          Cette discussion est archivée. Vous pouvez la relire à tout
          moment, mais plus y écrire.
        </p>
      </div>

    <% } else { %>

      <%# ---- Écrire ---- %>
      <div class="carte">
        <form action="/messages/<%= conversation.id %>" method="POST">
          <div class="champ">
            <%# "Votre message" ne disait pas A QUI on ecrit. Une discussion
                n'a que deux personnes : nommer celle qui lira leve tout doute. %>
            <label for="texte">Écrire à <%= jeSuisEmployeur ? conversation.nomPrestataire : conversation.nomEmployeur %></label>
            <textarea id="texte" name="texte" rows="4" maxlength="2000" required
                      placeholder="ex : <%= exempleMessage %>"></textarea>
            <p class="aide">
              Parlez du service, du tarif et des horaires. N'indiquez pas
              votre adresse exacte : elle sera transmise automatiquement
              après le paiement.
            </p>
          </div>
          <div class="actions">
            <button type="submit">
              <%- include("partiels/icone", { nom: "envoi" }) %>
              Envoyer
            </button>
            <a class="bouton bouton-secondaire" href="/mon-profil">Retour</a>
          </div>
        </form>
      </div>

      <%# Clore le service appartient a celui qui l'a RECU. La personne
          qui a travaille ne le declare pas a sa place. %>
      <% if (jeSuisEmployeur && conversation.statut === "acceptee") { %>
        <div class="carte">
          <h3>Le service a-t-il été effectué ?</h3>
          <%# CE N'EST PAS UNE FORMALITE. Cette declaration est le seul
              chemin par lequel la somme bloquee arrive chez la personne
              qui a travaille. Un employeur qui oublie la laisse impayee
              et ouvre un litige que rien ne justifiait. %>
          <p>
            <strong>Déclarez-le obligatoirement après chaque service.</strong>
            C'est cette déclaration qui verse la somme bloquée à
            <%= conversation.nomPrestataire %>. Sans elle, elle n'est pas
            payée, et un litige s'ouvre pour rien.
          </p>
          <p class="aide">
            Cette discussion rejoindra vos services terminés : vous pourrez
            la relire, mais plus y écrire.
          </p>
          <form action="/candidatures/<%= conversation.id %>/terminer" method="POST">
            <div class="actions">
              <button type="submit" class="bouton-secondaire">
                <%- include("partiels/icone", { nom: "valider" }) %>
                Déclarer le service effectué
              </button>
            </div>
          </form>
        </div>
      <% } %>

    <% } %>

<%# Ecrire au support n'a pas besoin d'un message a montrer du
          doigt. Le bouton "Signaler ce message" ne couvrait que les
          problemes DANS la discussion ; les vrais problemes se passent
          souvent ailleurs - la personne n'est pas venue, les conditions
          ont change sur place. %>
      <p class="aide" style="margin-top:1rem">
        Un problème avec cette personne ou avec ce service ?
        <a class="lien-discret" href="/probleme/<%= conversation.id %>">Signaler à l'équipe PamConnect</a>
      </p>
    </div>

  </div>

<%- include("partiels/pied") %>
