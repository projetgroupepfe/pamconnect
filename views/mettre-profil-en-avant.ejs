<%- include("partiels/tete") %>

  <div class="colonne">

    <h1>Mettre mon profil en avant</h1>
    <p class="chapeau">Vérifiez ce que cela change avant de confirmer.</p>

    <% if (finActuelle) { %>

      <%# DEJA EN AVANT. On ne propose pas de prolonger : quelqu'un qui
          clique deux fois paierait deux fois sans s'en apercevoir. %>
      <div class="carte confiance">
        <p><span class="badge badge-verifie">Mise en avant</span></p>
        <p>Votre profil est en avant jusqu'au <strong><%= finActuelle %></strong>.</p>
        <p class="aide">
          Vous pourrez le remettre en avant après cette date. D'ici là, rien ne
          vous sera prélevé.
        </p>
      </div>

      <p class="actions">
        <a class="bouton bouton-secondaire" href="/mon-profil">
          <%- include("partiels/icone", { nom: "profil" }) %>
          Retour à mon profil
        </a>
      </p>

    <% } else if (!cout || !jours) { %>

      <%# Aucun prix invente : si le reglage manque, on le dit. %>
      <div class="vide">
        <p>Cette option n'est pas disponible pour le moment.</p>
        <p class="aide">Le prix n'a pas encore été réglé par l'équipe.</p>
      </div>

    <% } else { %>

      <h2>Ce que cela change</h2>
      <div class="carte">
        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "telephone" }) %>
            <span>
              L'équipe vous appelle <strong>en premier</strong> pour les demandes
              de votre métier.
            </span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "calendrier" }) %>
            <span>
              Pendant <strong><%= jours %> jours</strong>. Ensuite votre profil
              reprend sa place, sans que vous ayez rien à faire.
            </span>
          </li>
        </ul>

        <%# CE QUE LA MISE EN AVANT NE FAIT PAS. Le dire ici evite une
            deception, et c'est la regle de la plateforme : personne ne
            paie pour passer devant quelqu'un de mieux noté. %>
        <p class="aide">
          Elle ne change <strong>rien à la recherche des employeurs</strong> :
          votre place y dépend de vos avis et de votre distance. On ne paie pas
          pour passer devant quelqu'un de mieux noté.
        </p>
      </div>

      <h2>Ce que cela coûte</h2>
      <div class="carte">
        <div class="detail-tarif">
          <div class="ligne-tarif">
            <span>Mise en avant, <%= jours %> jours</span>
            <span class="retenue">− <%= jetonsEnClair(cout) %></span>
          </div>
          <div class="ligne-tarif total">
            <span>Il vous restera</span>
            <strong><%= jetonsEnClair(Math.max(0, solde - cout)) %></strong>
          </div>
        </div>

        <% if (solde < cout) { %>
          <p class="aide">
            <strong>Votre solde ne suffit pas.</strong> Il vous reste
            <%= jetonsEnClair(solde) %>.
          </p>
          <p class="actions">
            <a class="bouton bouton-secondaire" href="/mes-jetons">
              <%- include("partiels/icone", { nom: "jeton" }) %>
              Voir mes jetons
            </a>
          </p>
        <% } %>
      </div>

      <div class="actions">
        <form action="/mon-profil/mise-en-avant" method="POST">
          <button type="submit"<%= solde < cout ? " disabled" : "" %>>
            <%- include("partiels/icone", { nom: "valider" }) %>
            Confirmer la mise en avant
          </button>
        </form>
        <a class="bouton bouton-secondaire" href="/mon-profil">Annuler</a>
      </div>

    <% } %>

  </div>

<%- include("partiels/pied") %>
