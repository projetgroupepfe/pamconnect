<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Créer un compte</h1>
    <p class="discret">
      C'est gratuit. Si vous proposez vos services, vous devrez ensuite
      faire vérifier votre identité pour être visible.
    </p>

    <div class="carte">
      <form action="/inscription" method="POST">

        <div class="champ">
          <label for="role">Vous êtes ici pour</label>
          <select id="role" name="role">
            <option value="employeur" <%= locals.roleChoisi === "employeur" ? "selected" : "" %>>Trouver quelqu'un pour ma maison</option>
            <option value="prestataire" <%= locals.roleChoisi === "prestataire" ? "selected" : "" %>>Proposer mes services</option>
          </select>
        </div>

        <div class="champ">
          <label for="nom">Votre nom complet</label>
          <input type="text" id="nom" name="nom" autocomplete="name" required>
        </div>

        <div class="champ">
          <label for="email">Votre adresse email</label>
          <input type="email" id="email" name="email" autocomplete="email" required>
        </div>

        <%# L'EQUIPE APPELLE : c'est par ce numero qu'elle met un employeur
            et un prestataire en relation. Demande aux deux roles. %>
        <div class="champ">
          <label for="telephone">Votre numéro de téléphone</label>
          <input type="tel" id="telephone" name="telephone" autocomplete="tel"
                 inputmode="tel" placeholder="6XX XX XX XX" required>
          <span class="aide">Ce numéro sert à l'équipe PamConnect pour vous appeler. Il n'est jamais montré aux autres utilisateurs.</span>
        </div>

        <div class="champ">
          <label for="motdepasse">Votre mot de passe</label>
          <input type="password" id="motdepasse" name="motdepasse" autocomplete="new-password"
                 minlength="<%= motDePasseMin %>" required>
          <span class="aide"><%= motDePasseMin %> caractères au minimum.</span>
        </div>

        <%- include("partiels/champ-lieu", {
              quartier: null, arrondissement: null, obligatoire: false }) %>

        <%# Ce bloc n'apparait que pour les personnes qui proposent
            leurs services (voir le script en bas de page). %>
        <div id="champsPrestataire">
          <%- include("partiels/champ-metier", {
                valeur: null, intitule: "Ce que vous faites", obligatoire: false }) %>

          <%- include("partiels/champ-disponibilites", { utilisateur: null }) %>

          <div class="champ">
            <label for="tarif">Le tarif que vous demandez (FCFA)</label>
            <input type="number" id="tarif" name="tarif" placeholder="ex : 10000" min="<%= montantMinimum %>" step="<%= pasMontant %>">
            <span class="aide">C'est ce que vous demandez pour vos services.</span>
          </div>

          <%# Le detail apparait des que le montant est saisi : la personne
              voit ce qu'elle touchera AVANT de valider son inscription. %>
          <div class="detail-tarif" id="detailTarif" hidden>
            <div class="ligne-tarif">
              <span>Vous demandez</span>
              <strong id="montantBrut">…</strong>
            </div>
            <div class="ligne-tarif">
              <span>Commission PamConnect (<%= pourcentageCommission %> %)</span>
              <span class="retenue" id="montantCommission">…</span>
            </div>
            <div class="ligne-tarif total">
              <span>Vous recevez</span>
              <strong id="montantNet">…</strong>
            </div>
          </div>

          <%# Ce paragraphe existait deja : on le complete plutot que
              d'en ajouter un second qui dirait la meme chose. Ce qui lui
              manquait, c'est d'ou vient le montant reellement paye.
              Les montants viennent du serveur : ils suivent la commission. %>
          <div class="exemple">
            <p class="exemple-titre">Exemple de calcul</p>
            <p>
              Ce tarif est indicatif. Le montant réellement reçu dépend de la demande
              à laquelle vous etes interessees: pour une demande à
              <strong><%= exempleTarif.prix %></strong>, la commission est de
              <strong><%= exempleTarif.commission %></strong> et vous recevez
              <strong><%= exempleTarif.recu %></strong>.
            </p>
          </div>
        </div>

        <input type="hidden" id="latitude" name="latitude">
        <input type="hidden" id="longitude" name="longitude">

        <div class="actions">
          <button type="submit">Créer mon compte</button>
          <a class="bouton bouton-secondaire" href="/connexion">J'ai déjà un compte</a>
        </div>
      </form>
    </div>
  </div>

<script>
  // --- Champs reserves aux personnes qui proposent leurs services -----
  const choixRole = document.getElementById("role");
  const champsPrestataire = document.getElementById("champsPrestataire");
  const champMetier = document.getElementById("metier");
  const champTarif = document.getElementById("tarif");

  function majChampsPrestataire() {
    const proposeServices = choixRole.value === "prestataire";

    // "none" = invisible et ne prend plus de place ; "block" = visible.
    champsPrestataire.style.display = proposeServices ? "block" : "none";

    // On ne rend un champ obligatoire QUE lorsqu'il est visible : un champ
    // "required" mais cache empecherait le navigateur de valider le
    // formulaire, sans pouvoir expliquer pourquoi a la personne.
    champMetier.required = proposeServices;
    champTarif.required = proposeServices;   // sans tarif, aucun paiement possible

    if (!proposeServices) {
      champMetier.value = "";
      champTarif.value = "";
    }
  }

  choixRole.addEventListener("change", majChampsPrestataire);
  majChampsPrestataire(); // au chargement de la page

  // --- Le detail du tarif, calcule pendant la saisie ------------------
  // Le taux vient du serveur : il n'est ecrit qu'a un seul endroit.
  const TAUX = <%= pourcentageCommission %> 100;
  const detail = document.getElementById("detailTarif");

  function montant(nombre) {
    return Math.round(nombre).toLocaleString("fr-FR") + " FCFA";
  }

  function majDetailTarif() {
    const brut = Math.round(Number(champTarif.value) || 0);

    if (brut <= 0) {
      detail.hidden = true;
      return;
    }

    const commission = Math.round(brut * TAUX);
    document.getElementById("montantBrut").textContent = montant(brut);
    document.getElementById("montantCommission").textContent = "− " + montant(commission);
    document.getElementById("montantNet").textContent = montant(brut - commission);
    detail.hidden = false;
  }

  champTarif.addEventListener("input", majDetailTarif);

  // --- Position GPS, si la personne l'autorise ------------------------
  if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(
      function (position) {
        document.getElementById("latitude").value = position.coords.latitude;
        document.getElementById("longitude").value = position.coords.longitude;
      },
      function (erreur) {
        console.log("Position non disponible :", erreur.message);
      }
    );
  }
</script>

<%- include("partiels/pied") %>
