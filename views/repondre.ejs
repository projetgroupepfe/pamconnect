<%- include("partiels/tete") %>

  <div class="colonne">

    <h1>Répondre à cette demande</h1>
    <p class="chapeau">Vérifiez les informations avant d'envoyer votre réponse.</p>

    <div class="carte">
      <h3><%= annonce.titre %></h3>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "experience" }) %>
          <span><strong><%= annonce.metier %></strong></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "calendrier" }) %>
          <span><%= annonce.horaire || "Horaire non précisé" %></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span>
            <% if (annonce.quartier) { %><strong><%= annonce.quartier %></strong>, <% } %><%= annonce.arrondissement %>
          </span>
        </li>
        <% if (annonce.conditions) { %>
          <li>
            <%- include("partiels/icone", { nom: "info" }) %>
            <span><%= annonce.conditions %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <%# C'est ICI que la transparence est due : au moment de s'engager, et
        pour cette demande-la. Sur la liste des annonces, le meme calcul
        s'affichait a l'identique pour toutes - il ne servait a rien
        choisir. %>
    <%# Chez qui vous allez, et ce que la plateforme a verifie de lui. %>
    <h2>Chez qui vous allez</h2>
    <div class="carte">
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "profil" }) %>
          <span>
            <strong><%= annonce.nomEmployeur %></strong>
            <% if (annonce.verificationEmployeur === "verifie") { %>
              <span class="badge badge-verifie">
                <%- include("partiels/icone", { nom: "verifie" }) %>
                Identité et casier vérifiés
              </span>
            <% } else { %>
              <span class="badge badge-non-soumis">Identité non vérifiée</span>
            <% } %>
          </span>
        </li>

        <%# SA REPUTATION, A LUI AUSSI. Une plateforme qui ne fait noter
            que d un cote met toute la pression sur celui qui a le moins
            de pouvoir - et elle ne dit rien du logement ou l on envoie
            quelqu un. %>
        <li>
          <%- include("partiels/icone", { nom: "avis" }) %>
          <span>
            <% if (reputationEmployeur.nombre === 0) { %>
              <span class="aide">Aucun avis sur cet employeur pour le moment.</span>
            <% } else { %>
              <strong><%= moyenneLisible(reputationEmployeur.moyenne) %> sur 5</strong>
              <span class="aide">
                sur <%= reputationEmployeur.nombre %> avis laissés par des personnes
                qui ont travaillé pour lui
              </span>
            <% } %>
          </span>
        </li>
      </ul>
      <%# La phrase doit suivre le badge. Sinon l'ecran affiche
          "Identite non verifiee" et, juste en dessous, "PamConnect a
          controle sa piece d'identite" : deux affirmations contraires,
          et c'est la fausse que la personne retient. %>
      <% if (annonce.verificationEmployeur === "verifie") { %>
        <p class="aide">
          Vous vous déplacerez chez cette personne. PamConnect a contrôlé sa
          pièce d'identité et son casier judiciaire, comme les vôtres.
        </p>
      <% } else { %>
        <p class="aide">
          Vous vous déplacerez chez cette personne. Son identité n'a pas
          encore été vérifiée par PamConnect. À vous de décider si vous
          souhaitez répondre à cette demande.
        </p>
      <% } %>
    </div>

    <h2>Ce que vous toucherez</h2>
    <div class="carte">
      <%# Le prix de l'annonce, et ce qu'il en restera. C'est le moment ou
          la personne s'engage : elle doit voir le montant exact, avec son
          unite - 10 000 FCFA par jour et 10 000 FCFA pour la prestation ne
          sont pas la meme proposition. %>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "remuneration" }) %>
          <span>Prix annoncé : <strong><%= prixEnClair(annonce) %></strong></span>
        </li>
        <% if (annonce.duree_estimee) { %>
          <li>
            <%- include("partiels/icone", { nom: "disponibilite" }) %>
            <span>Durée estimée : <strong><%= annonce.duree_estimee %></strong></span>
          </li>
        <% } %>
      </ul>

      <%# prixAnnonce : ce montant est celui de l'employeur, pas le tarif
          qu'elle indique sur son profil. %>
      <%- include("partiels/detail-tarif", { tarif: annonce.prix, prixAnnonce: true }) %>

      <p class="aide">
        C'est le prix fixé par l'employeur pour ce service.
        Si ce montant ne vous convient pas, vous pouvez répondre à une autre demande.
      </p>
    </div>

    <%# CE QUE CETTE REPONSE VA COUTER, avant de s'engager. La meme regle
        que pour la commission : le prix ne se decouvre pas apres. %>
    <% if (cout) { %>
      <h2>Ce que cette réponse vous coûte</h2>
      <div class="carte">
        <div class="detail-tarif">
          <div class="ligne-tarif">
            <span>Envoyer cette réponse</span>
            <span class="retenue">− <%= jetonsEnClair(cout) %></span>
          </div>
          <div class="ligne-tarif total">
            <span>Il vous restera</span>
            <strong><%= jetonsEnClair(Math.max(0, solde - cout)) %></strong>
          </div>
        </div>

        <% if (solde < cout) { %>
          <p class="aide">
            <strong>Votre solde ne suffit pas.</strong> Il vous reste
            <%= jetonsEnClair(solde) %>.
          </p>
          <p class="actions">
            <a class="bouton bouton-secondaire" href="/mes-jetons">
              <%- include("partiels/icone", { nom: "jeton" }) %>
              Voir mes jetons
            </a>
          </p>
        <% } %>

        <%# LA LIMITE DU JOUR, dite avant l'envoi. La decouvrir apres
            coup donnerait le sentiment d'un refus arbitraire. %>
        <% if (limite) { %>
          <p class="aide">
            Vous pouvez envoyer <%= limite %> réponses par tranche de 24 heures.
            <% if (restantAujourdhui === 0) { %>
              <strong>Vous les avez toutes utilisées.</strong>
            <% } else { %>
              Il vous en reste <strong><%= restantAujourdhui %></strong>.
            <% } %>
          </p>
        <% } %>
      </div>
    <% } %>

    <div class="actions">
      <form action="/candidatures" method="POST">
        <input type="hidden" name="annonceId" value="<%= annonce.id %>">
        <button type="submit">
          <%- include("partiels/icone", { nom: "valider" }) %>
          Confirmer ma réponse
        </button>
      </form>
      <a class="bouton bouton-secondaire" href="/annonces">Annuler</a>
    </div>

  </div>

<%- include("partiels/pied") %>
