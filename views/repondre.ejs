<%- include("partiels/tete") %>

  <div class="colonne">

    <h1>Répondre à cette demande</h1>
    <p class="chapeau">Vérifiez les informations avant d'envoyer votre réponse.</p>

    <div class="carte">
      <h3><%= annonce.titre %></h3>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "experience" }) %>
          <span><strong><%= annonce.metier %></strong></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "calendrier" }) %>
          <span><%= annonce.horaire || "Horaire non précisé" %></span>
        </li>
        <li>
          <%- include("partiels/icone", { nom: "lieu" }) %>
          <span>
            <% if (annonce.quartier) { %><strong><%= annonce.quartier %></strong>, <% } %><%= annonce.arrondissement %>
          </span>
        </li>
        <% if (annonce.conditions) { %>
          <li>
            <%- include("partiels/icone", { nom: "info" }) %>
            <span><%= annonce.conditions %></span>
          </li>
        <% } %>
      </ul>
    </div>

    <%# C'est ICI que la transparence est due : au moment de s'engager, et
        pour cette demande-la. Sur la liste des annonces, le meme calcul
        s'affichait a l'identique pour toutes - il ne servait a rien
        choisir. %>
    <%# Chez qui vous allez, et ce que la plateforme a verifie de lui. %>
    <h2>Chez qui vous allez</h2>
    <div class="carte">
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "profil" }) %>
          <span>
            <strong><%= annonce.nomEmployeur %></strong>
            <% if (annonce.verificationEmployeur === "verifie") { %>
              <span class="badge badge-verifie">
                <%- include("partiels/icone", { nom: "verifie" }) %>
                Identité et casier vérifiés
              </span>
            <% } else { %>
              <span class="badge badge-non-soumis">Identité non vérifiée</span>
            <% } %>
          </span>
        </li>
      </ul>
      <p class="aide">
        Vous vous déplacerez chez cette personne. PamConnect a contrôlé sa
        pièce d'identité et son casier judiciaire, comme les vôtres.
      </p>
    </div>

    <h2>Ce que vous toucherez</h2>
    <div class="carte">
      <%# Le prix de l'annonce, et ce qu'il en restera. C'est le moment ou
          la personne s'engage : elle doit voir le montant exact, avec son
          unite - 10 000 FCFA par jour et 10 000 FCFA pour la prestation ne
          sont pas la meme proposition. %>
      <ul class="infos">
        <li>
          <%- include("partiels/icone", { nom: "remuneration" }) %>
          <span>Prix annoncé : <strong><%= prixEnClair(annonce) %></strong></span>
        </li>
        <% if (annonce.duree_estimee) { %>
          <li>
            <%- include("partiels/icone", { nom: "disponibilite" }) %>
            <span>Durée estimée : <strong><%= annonce.duree_estimee %></strong></span>
          </li>
        <% } %>
      </ul>

      <%- include("partiels/detail-tarif", { tarif: annonce.prix }) %>

      <p class="aide">
        C'est le prix fixé par l'employeur pour ce service.
        Si ce montant ne vous convient pas, vous pouvez répondre à une autre demande.
      </p>
    </div>

    <div class="actions">
      <form action="/candidatures" method="POST">
        <input type="hidden" name="annonceId" value="<%= annonce.id %>">
        <button type="submit">
          <%- include("partiels/icone", { nom: "valider" }) %>
          Confirmer ma réponse
        </button>
      </form>
      <a class="bouton bouton-secondaire" href="/annonces">Annuler</a>
    </div>

  </div>

<%- include("partiels/pied") %>
