<%- include("partiels/tete") %>

  <div class="colonne">
    <h1>Modifier ma demande</h1>
    <p class="discret">
      Corrigez ce qui doit l'être. Les personnes qui consultent vos demandes
      verront la nouvelle version.
    </p>

    <%# Une demande a laquelle des gens ont deja repondu n'est plus tout a
        fait la votre : ils se sont decides sur ce qui etait ecrit. On ne
        l'interdit pas - un horaire faux doit pouvoir etre corrige - mais on
        le dit, et on rappelle qu'il faut les prevenir. %>
    <%# La phrase vient de avertissementModification : l'application lit la
        meme. %>
    <% if (avertissement) { %>
      <div class="carte">
        <p><%= avertissement.phrase %></p>
        <p class="aide"><%= avertissement.conseil %></p>
      </div>
    <% } %>

    <div class="carte">
      <form action="/annonces/<%= annonce.id %>/modifier" method="POST">
        <%- include("partiels/champs-annonce", { annonce: annonce }) %>

        <div class="actions">
          <button type="submit">
            <%- include("partiels/icone", { nom: "valider" }) %>
            Enregistrer les modifications
          </button>
          <a class="bouton bouton-secondaire" href="/mes-demandes">Annuler</a>
        </div>
      </form>
    </div>
  </div>

<%- include("partiels/pied") %>
