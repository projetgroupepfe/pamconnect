<%- include("partiels/tete") %>

  <h1>Problèmes signalés</h1>
  <p class="chapeau">
    Les problèmes qu'une personne a écrits à l'équipe et qui n'ont pas
    encore été examinés.
  </p>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/admin">
      <%- include("partiels/icone", { nom: "document" }) %>
      Dossiers à vérifier
    </a>
    <a class="bouton bouton-secondaire" href="/admin/signalements">
      <%- include("partiels/icone", { nom: "message" }) %>
      Messages signalés
    </a>
    <a class="bouton bouton-secondaire" href="/admin/versements">
      <%- include("partiels/icone", { nom: "remuneration" }) %>
      Versements
    </a>
  </p>

  <% if (problemes.length === 0) { %>

    <div class="vide">
      <p>Aucun problème signalé.</p>
    </div>

  <% } else { %>

    <% problemes.forEach(function (p) { %>
      <div class="carte">

        <div class="fiche-tete">
          <div class="portrait"><%= p.nomAuteur.charAt(0) %></div>
          <div>
            <h3><%= p.nomAuteur %></h3>
            <div class="metier"><%= p.emailAuteur %></div>
          </div>
        </div>

        <ul class="infos">
          <li>
            <%- include("partiels/icone", { nom: "document" }) %>
            <span>Discussion : <strong><%= p.titreAnnonce %></strong></span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "profil" }) %>
            <span>Signale <strong><%= p.nomVise %></strong> (<%= p.emailVise %>)</span>
          </li>
          <li>
            <%- include("partiels/icone", { nom: "calendrier" }) %>
            <span>Écrit le <%= p.cree_le %></span>
          </li>
          <% if (p.viseAvertissements > 0) { %>
            <li>
              <%- include("partiels/icone", { nom: "info" }) %>
              <span>
                <%= p.nomVise %> a déjà reçu
                <strong><%= p.viseAvertissements %></strong>
                avertissement<%= p.viseAvertissements > 1 ? "s" : "" %>.
              </span>
            </li>
          <% } %>
          <% if (p.viseSuspendu) { %>
            <li>
              <%- include("partiels/icone", { nom: "info" }) %>
              <span><strong>Ce compte est déjà suspendu.</strong></span>
            </li>
          <% } %>
        </ul>

        <%# Le texte tel qu'il a ete ecrit. On ne le resume pas : une
            decision se prend sur ce que la personne a dit, pas sur un
            extrait choisi par la machine. %>
        <blockquote class="message-signale"><%= p.texte %></blockquote>

        <%# Les MEMES trois issues que pour un message signale. Un second
            vocabulaire de sanctions ferait hesiter l'equipe sur ce
            qu'elle est en train de decider. %>
        <div class="actions">
          <form action="/admin/problemes/<%= p.id %>" method="POST">
            <input type="hidden" name="decision" value="rien">
            <button type="submit" class="bouton-secondaire">
              <%- include("partiels/icone", { nom: "valider" }) %>
              Classer sans suite
            </button>
          </form>
        </div>

        <% if (!p.viseSuspendu) { %>
          <form action="/admin/problemes/<%= p.id %>" method="POST">
            <input type="hidden" name="decision" value="avertissement">
            <div class="champ">
              <label for="avert-p<%= p.id %>">Motif de l'avertissement</label>
              <input type="text" id="avert-p<%= p.id %>" name="motif" maxlength="200"
                     placeholder="ex : ne pas se présenter sans prévenir">
              <span class="aide">
                <%= p.nomVise %> garde son compte et lira ce motif sur son profil.
              </span>
            </div>
            <div class="actions">
              <button type="submit" class="bouton-secondaire">
                <%- include("partiels/icone", { nom: "info" }) %>
                Avertir <%= p.nomVise %>
              </button>
            </div>
          </form>

          <form action="/admin/problemes/<%= p.id %>" method="POST">
            <input type="hidden" name="decision" value="sanction">
            <div class="champ">
              <label for="motif-p<%= p.id %>">Motif de la suspension</label>
              <input type="text" id="motif-p<%= p.id %>" name="motif" maxlength="200"
                     placeholder="ex : comportement répété malgré avertissement">
            </div>
            <div class="actions">
              <button type="submit" class="bouton-danger">
                <%- include("partiels/icone", { nom: "refuser" }) %>
                Suspendre le compte de <%= p.nomVise %>
              </button>
            </div>
          </form>
        <% } %>

      </div>
    <% }); %>

  <% } %>

<%- include("partiels/pied") %>
