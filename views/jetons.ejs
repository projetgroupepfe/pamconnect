<%- include("partiels/tete") %>

  <h1>Mes jetons</h1>

  <%# CE QUI VIENT DE SE PASSER, dit une seule fois. Des jetons offerts
      sans que personne ne l'apprenne ne servent a rien, et des jetons
      qui disparaissent en silence ressemblent a une erreur. %>
  <% if (offertsMaintenant) { %>
    <div class="carte confiance">
      <h3>Bienvenue : <%= offertsMaintenant.quantite %> jetons vous sont offerts</h3>
      <p>
        Votre identité est vérifiée. Ces jetons vous sont offerts
        <strong>une seule fois</strong>, pour commencer.
      </p>
      <p class="aide">
        Ils sont utilisables pendant <%= offertsMaintenant.jours %> jours.
        Passé ce délai, ceux que vous n'aurez pas utilisés disparaissent.
      </p>
    </div>
  <% } %>

  <% if (perdusMaintenant) { %>
    <div class="carte">
      <p><span class="badge badge-non-soumis">Jetons offerts expirés</span></p>
      <p>
        Vos <%= perdusMaintenant %> jetons offerts ne sont plus utilisables :
        le délai est passé.
      </p>
      <p class="aide">
        Les jetons que vous achetez, eux, n'ont pas de date limite.
      </p>
    </div>
  <% } %>

  <%# CE QU'UN JETON N'EST PAS. La confusion serait grave : quelqu'un
      qui croit avoir de l'argent sur la plateforme attendrait de le
      retirer, et ne pourrait pas. C'est donc dit avant le solde, pas
      apres. %>
  <div class="carte confiance">
    <h3>À quoi servent les jetons</h3>

    <%# LE PRIX D'UNE ACTION, DIT ICI ET PAS AILLEURS. Annoncer "des
        jetons vous sont offerts" sans dire ce qu'ils permettent laisse
        la personne compter des unites dont elle ignore la valeur. %>
    <p>
      Un jeton donne accès à une option de PamConnect.
      <% if (jeSuisEmployeur) { %>
        Pour vous, il sert à <strong>mettre une demande en avant</strong>,
        pour qu'elle soit vue avant les autres.
        <% if (coutAction) { %>
          Une mise en avant coûte <strong><%= jetonsEnClair(coutAction) %></strong>.
        <% } %>
      <% } else { %>
        Pour vous, il sert à <strong>répondre à une demande</strong>.
        <% if (coutAction) { %>
          Répondre à une demande coûte <strong><%= jetonsEnClair(coutAction) %></strong>.
        <% } %>
      <% } %>
    </p>

    <%# CE QUE LE SOLDE PERMET VRAIMENT. Un employeur qui recoit 10 jetons
        alors qu'une mise en avant en coute 20 doit le lire ici, pas le
        decouvrir en cliquant. %>
    <% if (coutAction && solde.total > 0) { %>
      <% const possible = Math.floor(solde.total / coutAction); %>
      <% if (possible > 0) { %>
        <p>
          Votre solde vous permet de
          <strong><%= actionsPossibles(jeSuisEmployeur, possible) %></strong>.
        </p>
      <% } else { %>
        <p>
          Il vous manque <strong><%= jetonsEnClair(coutAction - solde.total) %></strong>
          pour <%= uneAction(jeSuisEmployeur) %>.
          Vos jetons en couvrent déjà une partie.
        </p>
      <% } %>
    <% } %>

    <%# A RETIRER quand la depense sera construite : etape 3 pour la
        reponse a une demande, etape 4 pour la mise en avant. Tant que le
        bouton n'existe pas, la page ne doit pas laisser croire qu'il
        existe - quelqu'un le chercherait sans le trouver. %>
    <p class="aide">
      <strong>Cette option n'est pas encore ouverte.</strong> Elle arrive dans
      une prochaine version. D'ici là, vos jetons vous attendent et rien ne
      vous est prélevé.
    </p>
    <p class="aide">
      Un jeton <strong>n'est pas de l'argent</strong>. Il ne se donne pas à
      quelqu'un d'autre, il ne se retire ni en espèces ni par Mobile Money,
      et il ne paie jamais une prestation. Le paiement d'un service se fait
      en FCFA, et passe par
      <a href="/mon-compte">votre compte</a>.
    </p>
  </div>

  <%# LE SOLDE, EN DEUX PARTS. Les melanger cacherait ce qui va expirer. %>
  <div class="carte">
    <div class="detail-tarif">
      <div class="ligne-tarif total">
        <span>Votre solde</span>
        <strong><%= jetonsEnClair(solde.total) %></strong>
      </div>

      <% if (solde.offerts > 0) { %>
        <div class="ligne-tarif">
          <span>
            Jetons offerts
            <% if (expireLe) { %>
              <br><small class="discret">
                À utiliser avant le <%= expireLe %>, sinon ils sont perdus
              </small>
            <% } %>
          </span>
          <span><%= solde.offerts %></span>
        </div>
      <% } %>

      <% if (solde.achetes > 0) { %>
        <div class="ligne-tarif">
          <span>Jetons achetés<br><small class="discret">Sans date limite</small></span>
          <span><%= solde.achetes %></span>
        </div>
      <% } %>
    </div>

    <% if (solde.total === 0) { %>
      <%# UNE PERSONNE NON VERIFIEE N'A RIEN A ACHETER TOUT DE SUITE :
          des jetons l'attendent, et le dire vaut mieux que de la laisser
          payer ce qu'on allait lui offrir. %>
      <% if (moi.statut_verification !== "verifie") { %>
        <p class="aide">
          Vous n'avez pas encore de jetons. Des jetons vous seront
          <strong>offerts</strong> dès que votre identité aura été vérifiée.
        </p>
        <p class="actions">
          <a class="bouton bouton-secondaire" href="/verification">
            <%- include("partiels/icone", { nom: "verifie" }) %>
            Faire vérifier mon identité
          </a>
        </p>
      <% } else { %>
        <p class="aide">
          Vous n'avez pas encore de jetons. Choisissez un pack ci-dessous.
        </p>
      <% } %>
    <% } %>
  </div>

  <h2>Acheter des jetons</h2>

  <% if (valeurJeton === null || packs.length === 0) { %>

    <%# Aucun prix invente : si le reglage manque, on le dit. %>
    <div class="vide">
      <p>Aucun pack n'est en vente pour le moment.</p>
      <p class="aide">Les prix n'ont pas encore été réglés par l'équipe.</p>
    </div>

  <% } else { %>

    <p class="chapeau">
      Un jeton vaut <strong><%= formaterMontant(valeurJeton) %></strong>.
    </p>

    <% if (demandeEnCours) { %>
      <div class="carte">
        <p>
          <span class="badge badge-en-attente">Demande en cours</span>
        </p>
        <p class="aide">
          Une demande attend la confirmation de l'équipe. Vous pourrez en
          envoyer une autre une fois celle-ci traitée.
        </p>
      </div>
    <% } else { %>
      <div class="grille">
        <% packs.forEach(function (pack) { %>
          <div class="carte">
            <h3><%= pack.quantite %> jetons</h3>
            <div class="detail-tarif">
              <div class="ligne-tarif total">
                <span>Prix</span>
                <strong><%= formaterMontant(pack.prix) %></strong>
              </div>
            </div>

            <%# CE QUE CE PACK DONNERA A CETTE PERSONNE, son solde actuel
                compris. Le meme pack de 5 vaut cinq reponses pour une
                aide-menagere, et pas grand-chose pour un employeur dont
                l'action coute 20 - il a le droit de le savoir avant. %>
            <% if (coutAction) { %>
              <% const apres = solde.total + pack.quantite; %>
              <% const combien = Math.floor(apres / coutAction); %>
              <% if (combien > 0) { %>
                <p class="aide">
                  Après cet achat, de quoi
                  <strong><%= actionsPossibles(jeSuisEmployeur, combien) %></strong>.
                </p>
              <% } else { %>
                <% const manque = coutAction - apres; %>
                <p class="aide">
                  Après cet achat, il vous manquera encore
                  <strong><%= manque %> <%= manque > 1 ? "jetons" : "jeton" %></strong>
                  pour <%= uneAction(jeSuisEmployeur) %>.
                </p>
              <% } %>
            <% } %>

            <form action="/mes-jetons/acheter" method="POST">
              <input type="hidden" name="quantite" value="<%= pack.quantite %>">
              <button type="submit" class="bouton">
                <%- include("partiels/icone", { nom: "jeton" }) %>
                Demander ce pack
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>

    <%# EXEMPLE, ET DIT COMME TEL. Aucun ecran d'operateur n'est imite :
        la plateforme n'affiche jamais une page qui ressemblerait a celle
        de MTN ou d'Orange. %>
    <div class="carte confiance">
      <h3>Comment se passe le paiement</h3>
      <p>
        Vous demandez un pack ici. L'équipe confirme ensuite avoir reçu le
        paiement, et vos jetons sont ajoutés à votre solde.
      </p>
      <p class="aide">
        <strong>Démonstration :</strong> PamConnect n'encaisse aucun paiement
        pour l'instant. Encaisser de l'argent suppose un agrément et un
        contrat avec les opérateurs, que la plateforme n'a pas encore. Les
        demandes sont enregistrées et confirmées à la main par l'équipe.
      </p>
    </div>

  <% } %>

  <h2>Vos demandes d'achat</h2>

  <% if (achats.length === 0) { %>
    <p class="vide">Aucune demande pour le moment.</p>
  <% } else { %>
    <div class="grille">
      <% achats.forEach(function (achat) { %>
        <div class="carte">
          <h3><%= achat.quantite %> jetons</h3>
          <p>
            <% if (achat.etat === "en attente") { %>
              <span class="badge badge-en-attente">En attente de confirmation</span>
            <% } else if (achat.etat === "confirme") { %>
              <span class="badge badge-verifie">Jetons ajoutés</span>
            <% } else { %>
              <span class="badge badge-refuse">Refusée</span>
            <% } %>
          </p>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span><%= formaterMontant(achat.montant) %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>Demandé le <%= dateLisible(achat.cree_le) %></span>
            </li>
          </ul>
          <% if (achat.etat === "refuse" && achat.motif_refus) { %>
            <p class="aide">Motif : <%= achat.motif_refus %></p>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <h2>Vos mouvements</h2>

  <%# L'HISTORIQUE COMPLET. Une plateforme qui prend un jeton doit
      pouvoir dire quand, et pour quoi. %>
  <% if (mouvements.length === 0) { %>
    <p class="vide">Aucun mouvement pour le moment.</p>
  <% } else { %>
    <div class="carte">
      <div class="detail-tarif">
        <% mouvements.forEach(function (m) { %>
          <div class="ligne-tarif">
            <span>
              <%= m.detail || motifJetonsLisible(m.motif) %>
              <br><small class="discret">
                <%= dateLisible(m.cree_le) %><%= m.nature === "offert" ? " — jetons offerts" : "" %>
              </small>
            </span>
            <% if (m.quantite < 0) { %>
              <span class="retenue">− <%= Math.abs(m.quantite) %></span>
            <% } else { %>
              <strong>+ <%= m.quantite %></strong>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/mon-profil">
      <%- include("partiels/icone", { nom: "profil" }) %>
      Retour à mon profil
    </a>
  </p>

<%- include("partiels/pied") %>
