<%- include("partiels/tete") %>

  <h1>Mes jetons</h1>

  <%# Les decisions et les phrases de cette page viennent de mesJetons,
      dans server.js : l'application lit exactement les memes. %>
  <% if (jetons.perdusMaintenant) { %>
    <div class="carte">
      <p><span class="badge badge-non-soumis">Jetons offerts expirés</span></p>
      <p>
        Vos <%= jetons.perdusMaintenant %> jetons offerts ne sont plus utilisables :
        le délai est passé.
      </p>
      <p class="aide">
        Les jetons que vous achetez, eux, n'ont pas de date limite.
      </p>
    </div>
  <% } %>

  <%# TROIS PHRASES, PAS HUIT. Cette carte s'ouvrait sur un pave que
      personne ne lit jusqu'au bout, avant meme d'avoir vu son solde.
      Chaque phrase qui reste repond a une question qu'on se pose ici :
      ce que ca coute, ce que mon solde permet, et ce qu'un jeton n'est
      pas - la confusion la plus grave, celle qui ferait attendre un
      retrait impossible. %>
  <div class="carte confiance">
    <h3>À quoi servent les jetons</h3>

    <p>
      <% if (jetons.jeSuisEmployeur) { %>
        <strong>Mettre une demande en avant</strong><% if (jetons.cout) { %> coûte
        <strong><%= jetons.cout %></strong><% } %>, depuis
        <a href="/mes-demandes">vos demandes</a>.
      <% } else { %>
        <strong>Répondre à une demande</strong><% if (jetons.cout) { %> coûte
        <strong><%= jetons.cout %></strong><% } %>.
      <% } %>
      <% if (jetons.permet) { %>
        Votre solde vous permet de
        <strong><%= jetons.permet %></strong>.
      <% } else if (jetons.manque) { %>
        Il vous manque <strong><%= jetons.manque %></strong>.
      <% } %>
    </p>

    <% if (!jetons.jeSuisEmployeur) { %>
      <p class="aide">
        Le jeton part <strong>seulement quand votre réponse part</strong>.
      </p>
    <% } %>

    <p class="aide">
      Un jeton <strong>n'est pas de l'argent</strong> : il ne se donne pas, il
      ne se retire pas, et il ne paie jamais une prestation. Pour cela, voir
      <a href="/mon-compte">votre compte</a>.
    </p>
  </div>

  <%# LE SOLDE, EN DEUX PARTS. Les melanger cacherait ce qui va expirer. %>
  <div class="carte">
    <div class="detail-tarif">
      <div class="ligne-tarif total">
        <span>Votre solde</span>
        <strong><%= jetons.soldeTotal %></strong>
      </div>

      <% if (jetons.offerts > 0) { %>
        <div class="ligne-tarif">
          <%# D'OU ILS VIENNENT ET JUSQU'A QUAND, en une ligne. Un pave
              entier disait la meme chose juste au-dessus de celle-ci. %>
          <span>
            Jetons offerts
            <br><small class="discret">
              Offerts à la vérification de votre compte<% if (jetons.expireLe) { %>, à utiliser avant le <%= jetons.expireLe %><% } %>
            </small>
          </span>
          <span><%= jetons.offerts %></span>
        </div>
      <% } %>

      <% if (jetons.achetes > 0) { %>
        <div class="ligne-tarif">
          <span>Jetons achetés<br><small class="discret">Sans date limite</small></span>
          <span><%= jetons.achetes %></span>
        </div>
      <% } %>
    </div>

    <% if (jetons.soldeVide) { %>
      <%# UNE PERSONNE NON VERIFIEE N'A RIEN A ACHETER TOUT DE SUITE :
          des jetons l'attendent, et le dire vaut mieux que de la laisser
          payer ce qu'on allait lui offrir. %>
      <% if (jetons.verificationAFaire) { %>
        <p class="aide">
          Vous n'avez pas encore de jetons. Des jetons vous seront
          <strong>offerts</strong> dès que votre identité aura été vérifiée.
        </p>
        <p class="actions">
          <a class="bouton bouton-secondaire" href="/verification">
            <%- include("partiels/icone", { nom: "verifie" }) %>
            Faire vérifier mon identité
          </a>
        </p>
      <% } else { %>
        <p class="aide">
          Vous n'avez pas encore de jetons. Choisissez un pack ci-dessous.
        </p>
      <% } %>
    <% } %>
  </div>

  <h2>Acheter des jetons</h2>

  <% if (jetons.valeurJeton === null || jetons.packs.length === 0) { %>

    <%# Aucun prix invente : si le reglage manque, on le dit. %>
    <div class="vide">
      <p>Aucun pack n'est en vente pour le moment.</p>
      <p class="aide">Les prix n'ont pas encore été réglés par l'équipe.</p>
    </div>

  <% } else { %>

    <p class="chapeau">
      Un jeton vaut <strong><%= jetons.valeurJeton %></strong>.
    </p>

    <% if (jetons.demandeEnCours) { %>
      <div class="carte">
        <p>
          <span class="badge badge-en-attente">Demande en cours</span>
        </p>
        <p class="aide">
          Une demande attend la confirmation de l'équipe. Vous pourrez en
          envoyer une autre une fois celle-ci traitée.
        </p>
      </div>
    <% } else { %>
      <div class="grille">
        <% jetons.packs.forEach(function (pack) { %>
          <div class="carte">
            <h3><%= pack.quantite %> jetons</h3>
            <div class="detail-tarif">
              <div class="ligne-tarif total">
                <span>Prix</span>
                <strong><%= pack.prix %></strong>
              </div>
            </div>

            <%# CE QUE CE PACK DONNERA A CETTE PERSONNE, son solde actuel
                compris. Le meme pack de 5 vaut cinq reponses pour une
                aide-menagere, et pas grand-chose pour un employeur dont
                l'action coute 20 - il a le droit de le savoir avant.

                LE TOTAL, ET PAS SEULEMENT CE QUE LE PACK APPORTE. Sans
                lui, "de quoi mettre 2 demandes en avant" sous un pack
                de 20 jetons se lit comme si le pack en valait deux -
                et le prix semble divise par deux. %>
            <% if (pack.dequoi) { %>
              <p class="aide">
                Après cet achat : <strong><%= pack.apres %> jetons</strong>,
                de quoi <%= pack.dequoi %>.
              </p>
            <% } else if (pack.manqueEncore) { %>
              <p class="aide">
                Après cet achat : <strong><%= pack.apres %> jetons</strong>. Il vous en
                manquera encore <strong><%= pack.manqueEncore %></strong>
                pour <%= jetons.uneAction %>.
              </p>
            <% } %>

            <%# UNE QUESTION AVANT D'ENVOYER. Une demande envoyee ne
                s'annule pas depuis le compte, et l'equipe attendra un
                paiement : un appui par erreur ne doit pas suffire. %>
            <form action="/mes-jetons/acheter" method="POST"
                  data-question="Demander <%= pack.quantite %> jetons pour <%= pack.prix %> ?"
                  data-precision="L'équipe ajoutera les jetons à votre solde une fois le paiement reçu. Une demande envoyée ne s'annule pas depuis votre compte.">
              <input type="hidden" name="quantite" value="<%= pack.quantite %>">
              <button type="submit" class="bouton">
                <%- include("partiels/icone", { nom: "jeton" }) %>
                Demander ce pack
              </button>
            </form>
          </div>
        <% }); %>
      </div>
    <% } %>

    <%# EXEMPLE, ET DIT COMME TEL. Aucun ecran d'operateur n'est imite :
        la plateforme n'affiche jamais une page qui ressemblerait a celle
        de MTN ou d'Orange. %>
    <div class="carte confiance">
      <h3>Comment se passe le paiement</h3>
      <%# Le POURQUOI de la simulation (agrement, operateurs) est dans le
          dossier de soutenance, reponse C8 : ici, la personne apprend ce
          qui se passe, pas le droit qui l'explique. %>
      <p>
        Vous demandez un pack ici, et l'équipe ajoute les jetons à votre solde.
      </p>
      <p class="aide">
        PamConnect n'encaisse aucun paiement pour l'instant : chaque demande est
        confirmée à la main par l'équipe.
      </p>
    </div>

  <% } %>

  <h2>Vos demandes d'achat</h2>

  <% if (jetons.achats.length === 0) { %>
    <p class="vide">Aucune demande pour le moment.</p>
  <% } else { %>
    <div class="grille">
      <% jetons.achats.forEach(function (achat) { %>
        <div class="carte">
          <h3><%= achat.quantite %> jetons</h3>
          <p>
            <span class="badge <%= { "en attente": "badge-en-attente", confirme: "badge-verifie" }[achat.etat] || "badge-refuse" %>"><%= achat.libelleEtat %></span>
          </p>
          <ul class="infos">
            <li>
              <%- include("partiels/icone", { nom: "remuneration" }) %>
              <span><%= achat.montant %></span>
            </li>
            <li>
              <%- include("partiels/icone", { nom: "calendrier" }) %>
              <span>Demandé le <%= achat.demandeLe %></span>
            </li>
          </ul>
          <% if (achat.motifRefus) { %>
            <p class="aide">Motif : <%= achat.motifRefus %></p>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>

  <h2>Vos mouvements</h2>

  <%# L'HISTORIQUE COMPLET. Une plateforme qui prend un jeton doit
      pouvoir dire quand, et pour quoi. %>
  <% if (jetons.mouvements.length === 0) { %>
    <p class="vide">Aucun mouvement pour le moment.</p>
  <% } else { %>
    <div class="carte">
      <div class="detail-tarif">
        <% jetons.mouvements.forEach(function (m) { %>
          <div class="ligne-tarif">
            <span>
              <%= m.libelle %>
              <br><small class="discret"><%= m.date %></small>
            </span>
            <% if (m.retrait) { %>
              <span class="retenue"><%= m.quantite %></span>
            <% } else { %>
              <strong><%= m.quantite %></strong>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <p class="actions">
    <a class="bouton bouton-secondaire" href="/mon-profil">
      <%- include("partiels/icone", { nom: "profil" }) %>
      Retour à mon profil
    </a>
  </p>

<%- include("partiels/pied") %>
