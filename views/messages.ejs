<%- include("partiels/tete") %>

  <h1>Mes messages</h1>
  <p class="chapeau">Vos discussions, la plus récente en premier.</p>

  <%# TOUT CE QUI DEPEND DES DONNEES EST ECRIT PAR mesDiscussions, dans
      server.js : phrases de statut, messages non lus, pluriels, avis
      attendus. L'application lit la meme fonction ; la page ne recalcule
      rien, sinon les deux finiraient par se contredire. %>

  <% if (liste.vide) { %>

    <%# Cet ecran n'est pas l'endroit ou l'on publie une demande. La
        messagerie sert a s'accorder sur les horaires une fois qu'une
        candidature existe. Un gros bouton "Publier une demande" ici
        envoyait la personne ailleurs au lieu de lui expliquer pourquoi
        elle ne voit rien. %>
    <div class="vide">
      <p><%= liste.vide.phrase %></p>
      <% if (liste.vide.aide) { %>
        <p class="aide"><%= liste.vide.aide %></p>
      <% } %>
      <% if (jePeux.repondre) { %>
        <p><a class="lien-discret" href="/annonces">Voir les demandes publiées</a></p>
      <% } %>
    </div>

  <% } else { %>

    <%# Ce qui est en cours et ce qui appartient au passe ne se lisent
        pas au meme moment. Les melanger obligeait a trier de l'oeil. %>
    <% if (liste.enCours.length === 0) { %>
      <p class="vide">Aucune discussion en cours.</p>
    <% } %>

    <div class="grille">
      <% liste.enCours.forEach(function (c) { %>
        <div class="carte">
          <div class="fiche-tete">
            <div class="portrait"><%= c.avec.charAt(0) %></div>
            <div>
              <h3><%= c.avec %></h3>
              <div class="metier"><%= c.titreAnnonce %></div>
            </div>
          </div>

          <ul class="infos">
            <%# UNE SEULE LIGNE POUR L'ETAT. La marque "Nouveau" suffit a
                distinguer ce qui vient d'arriver de ce qui etait deja su. %>
            <li>
              <%- include("partiels/icone", { nom: "disponibilite" }) %>
              <span>
                <strong><%= c.phraseStatut %></strong>
                <% if (c.nouveau) { %><span class="pastille">Nouveau</span><% } %>
              </span>
            </li>

            <%# Ce qui attend d'etre lu passe AVANT le compte total :
                c'est la seule ligne qui demande une action. %>
            <% if (c.phraseNonLus) { %>
              <li>
                <%- include("partiels/icone", { nom: "info" }) %>
                <span><strong><%= c.phraseNonLus %></strong></span>
              </li>
            <% } %>
            <li>
              <%- include("partiels/icone", { nom: "message" }) %>
              <span>
                <%= c.phraseMessages %>
                <% if (c.dernierMessage) { %>
                  <span class="aide">dernier le <%= c.dernierMessage %></span>
                <% } %>
              </span>
            </li>
          </ul>

          <div class="actions">
            <a class="bouton bouton-secondaire" href="/messages/<%= c.id %>">
              <%- include("partiels/icone", { nom: "message" }) %>
              Ouvrir la discussion
            </a>
          </div>
        </div>
      <% }); %>
    </div>

    <% if (liste.terminees.length > 0) { %>
      <h2>Services terminés</h2>
      <%# CE BLOC N'EST PAS QU'UNE ARCHIVE. Tant qu'un avis n'a pas ete
          donne, quelque chose y attend. %>
      <p class="chapeau">
        <% if (liste.chapeauTerminees.fort) { %><strong><%= liste.chapeauTerminees.fort %></strong><% } %>
        <%= liste.chapeauTerminees.suite %>
      </p>
      <div class="grille">
        <% liste.terminees.forEach(function (c) { %>
          <div class="carte">
            <div class="fiche-tete">
              <div class="portrait"><%= c.avec.charAt(0) %></div>
              <div>
                <h3><%= c.avec %></h3>
                <div class="metier"><%= c.titreAnnonce %></div>
              </div>
            </div>

            <ul class="infos">
              <li>
                <%- include("partiels/icone", { nom: "valider" }) %>
                <span>Service effectué le <strong><%= c.terminee_le %></strong></span>
              </li>
              <% if (c.avisAttendu) { %>
                <li>
                  <%- include("partiels/icone", { nom: "avis" }) %>
                  <span><strong>Votre avis est attendu</strong></span>
                </li>
              <% } %>
              <li>
                <%- include("partiels/icone", { nom: "message" }) %>
                <span><%= c.phraseMessages %></span>
              </li>
            </ul>

            <%# LE BOUTON, LA OU L'ON REGARDE. Il fallait sinon ouvrir une
                discussion marquee "relire" et descendre jusqu'en bas pour
                le trouver. %>
            <div class="actions">
              <% if (c.avisAttendu) { %>
                <a class="bouton" href="/avis/<%= c.id %>">
                  <%- include("partiels/icone", { nom: "avis" }) %>
                  Donner mon avis
                </a>
              <% } %>
              <a class="bouton bouton-secondaire" href="/messages/<%= c.id %>">
                <%- include("partiels/icone", { nom: "document" }) %>
                Relire la discussion
              </a>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

  <% } %>

<%- include("partiels/pied") %>
